    "ash.patch.extend": {
      "admitted": false,
      "phase": "core",
      "refusal_reason": "NOT EXERCISED. It delegates verbatim to ash.extend for both info/2 and igniter/1, so its behaviour is expected to be identical -- but expectation is not observation, and this pack never ran it.",
      "standing": "UNKNOWN"
    },
    "ash.reset": {
      "admitted": false,
      "phase": "lifecycle",
      "refusal_reason": "DESTRUCTIVE: tear_down + setup. Same isolation requirement as ash.tear_down. NOTE: `ash_postgres.reset` does not exist -- the real task is `ash.reset`; the v26.9.8 matrix named a nonexistent task.",
      "standing": "UNSUPPORTED"
    },
    "ash.set.domains": {
      "admitted": false,
      "phase": "core",
      "refusal_reason": "NOT EXERCISED, and structurally redundant on this path: ash.gen.domain already writes the ash_domains config entry as part of creating the domain, so discovering and rewriting the list afterwards would be a second writer to state a generator already owns.",
      "standing": "UNKNOWN"
    },
    "ash.setup": {
      "admitted": true,
      "phase": "lifecycle",
      "refusal_reason": null,
      "standing": "PARTIAL_ALIVE"
    },
    "ash.tear_down": {
      "admitted": false,
      "phase": "lifecycle",
      "refusal_reason": "DESTRUCTIVE: drops the database. Not idempotent in any meaningful sense (run 2 has nothing to drop) and cannot share a database identity with the qualification subject. Admitted only inside an isolated-database harness, never in the manufacture path.",
      "standing": "UNSUPPORTED"
    },
    "ash_postgres.gen.resources": {
      "admitted": false,
      "phase": "core",
      "refusal_reason": "DIRECTION INVERSION: this task generates Ash resources FROM an existing database schema. That is the opposite of this pack's direction (ontology -> resources -> migrations) and admitting it would create a second, competing source of truth for the same resources. Excluded by design, not by omission.",
      "standing": "UNSUPPORTED"
    },
    "ash_postgres.install": {
      "admitted": true,
      "phase": "base",
      "refusal_reason": null,
      "standing": "ALIVE"
    },
    "ash_postgres.setup_vector": {
      "admitted": false,
      "phase": "lifecycle",
      "refusal_reason": "NOT EXERCISED. pgvector is not part of the Book/Loan domain, so there was nothing to observe. UNKNOWN, not broken.",
      "standing": "UNKNOWN"
    }
  },
