---
to: "lib/{{ app_path }}/{{ agent_file }}.ex"
force: true
for_each: "agents"
sparql:
  agents: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agent_name ?domain_module ?app_path ?agent_file WHERE {
      ?a a aap:Agent ; aap:moduleName ?module_name ; aap:agentName ?agent_name ;
         aap:forDomain ?d ; aap:agentFile ?agent_file .
      ?d aap:moduleName ?domain_module ; aap:appPath ?app_path .
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
defmodule {{ module_name }} do
  use AshA2A.Agent,
    resource_or_domain: {{ domain_module }},
    name: "{{ agent_name }}",
    require_authenticated_caller: false
end
