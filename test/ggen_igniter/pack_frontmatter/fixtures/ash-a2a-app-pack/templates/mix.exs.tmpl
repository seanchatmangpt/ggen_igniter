---
to: "mix.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name ?app_module ?ash_a2a_dep WHERE {
      ?p a aap:Project ; aap:appName ?app_name ; aap:appModule ?app_module ; aap:ashA2aDep ?ash_a2a_dep .
    }
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
defmodule {{ app[0].app_module }}.MixProject do
  use Mix.Project

  def project, do: [app: :{{ app[0].app_name }}, version: "0.1.0", elixir: "~> 1.19", deps: deps()]
  def application, do: [extra_applications: [:logger]]

  defp deps do
    [{:ash, "~> 3.0"}, {:ash_a2a, {{ app[0].ash_a2a_dep }}}, {:bandit, "~> 1.0"}]
  end
end
