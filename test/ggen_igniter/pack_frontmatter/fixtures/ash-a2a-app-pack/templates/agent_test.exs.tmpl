---
to: "test/{{ agent_file }}_test.exs"
force: true
for_each: "agents"
sparql:
  agents: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agent_name ?agent_file WHERE {
      ?a a aap:Agent ; aap:moduleName ?module_name ; aap:agentName ?agent_name ; aap:agentFile ?agent_file .
    } ORDER BY ?module_name
  skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?agent_module ?skill_name WHERE {
      ?a a aap:Agent ; aap:moduleName ?agent_module ; aap:forDomain ?d .
      ?r a aap:Resource ; aap:inDomain ?d ; aap:skill ?s .
      ?s aap:name ?skill_name .
    } ORDER BY ?agent_module ?skill_name
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
defmodule {{ module_name }}Test do
  use ExUnit.Case, async: true

  test "agent card advertises every skill declared in the ontology" do
    card = {{ module_name }}.agent_card()
    json = inspect(card, limit: :infinity, printable_limit: :infinity)
{%- for s in skills | filter(attribute="agent_module", value=module_name) %}
    assert json =~ "{{ s.skill_name }}"
{%- endfor %}
    assert json =~ "{{ agent_name }}"
  end
end
