---
to: "lib/{{ app_path }}/{{ domain_file }}.ex"
force: true
for_each: "domains"
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?domain_file WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:appPath ?app_path ;
         aap:domainFile ?domain_file .
    } ORDER BY ?module_name
  members: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?resource_module WHERE {
      ?r a aap:Resource ; aap:moduleName ?resource_module ; aap:inDomain ?d .
      ?d aap:moduleName ?domain_module .
    } ORDER BY ?domain_module ?resource_module
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
{% set mine = members | filter(attribute="domain_module", value=module_name) -%}
defmodule {{ module_name }} do
  use Ash.Domain, extensions: [AshA2A]

  resources do
{%- for m in mine %}
    resource({{ m.resource_module }})
{%- endfor %}
  end
end
