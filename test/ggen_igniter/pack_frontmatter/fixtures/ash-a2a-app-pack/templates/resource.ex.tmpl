---
to: "lib/{{ app_path }}/{{ resource_file }}.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?domain_module ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:moduleName ?domain_module ; aap:appPath ?app_path .
    } ORDER BY ?module_name
  attributes: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?attr_name ?ash_type ?pk WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:attribute ?a .
      ?a aap:name ?attr_name ; aap:ashType ?ash_type ; aap:primaryKey ?pk .
    } ORDER BY ?module_name ?attr_name
  actions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?action_type ?accept WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:action ?a .
      ?a aap:name ?action_name ; aap:actionType ?action_type .
      OPTIONAL { ?a aap:accept ?accept }
    } ORDER BY ?module_name ?action_name
  skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?skill_action ?skill_desc ?consequence ?lease WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:ofAction ?skill_action ; aap:description ?skill_desc .
      OPTIONAL { ?s aap:consequence ?consequence }
      OPTIONAL { ?s aap:leaseRequired ?lease }
    } ORDER BY ?module_name ?skill_name
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
{% set my_attrs = attributes | filter(attribute="module_name", value=module_name) -%}
{% set my_actions = actions | filter(attribute="module_name", value=module_name) -%}
{% set my_skills = skills | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }} do
  use Ash.Resource,
    domain: {{ domain_module }},
    data_layer: Ash.DataLayer.Ets,
    extensions: [AshA2A]

  attributes do
{%- for a in my_attrs %}
{%- if a.pk == "true" %}
    uuid_primary_key(:{{ a.attr_name }})
{%- else %}
    attribute(:{{ a.attr_name }}, :{{ a.ash_type }}, public?: true)
{%- endif %}
{%- endfor %}
  end

  actions do
{%- for x in my_actions %}
{%- if x.action_type == "read" %}
    read(:{{ x.action_name }})
{%- elif x.action_type == "destroy" %}
    destroy(:{{ x.action_name }})
{%- else %}
    {{ x.action_type }} :{{ x.action_name }} do
      accept([{% for t in x.accept | default(value="") | split(pat=",") %}{% if t != "" %}:{{ t }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}])
    end
{%- endif %}
{%- endfor %}
  end
{%- if my_skills | length > 0 %}

  a2a do
{%- for s in my_skills %}
    skill(:{{ s.skill_name }}, :{{ s.skill_action }}, description: "{{ s.skill_desc }}"{% if s.consequence %}, consequence: :{{ s.consequence }}{% endif %}{% if s.lease %}, lease_required?: {{ s.lease }}{% endif %})
{%- endfor %}
  end
{%- endif %}
end
