sd:strategy-08 a sd:StrategyStub ; sd:ordinal 8 ; sd:shortTitle "Match resources to ends; avoid overextension" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-09 a sd:StrategyStub ; sd:ordinal 9 ; sd:shortTitle "Draw the rival out, then counter at the overreach" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-10 a sd:StrategyStub ; sd:ordinal 10 ; sd:shortTitle "Raise the cost of attacking you" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-12 a sd:StrategyStub ; sd:ordinal 12 ; sd:shortTitle "Subordinate single battles to long-horizon aims" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-13 a sd:StrategyStub ; sd:ordinal 13 ; sd:shortTitle "Learn how the rival thinks before acting" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-15 a sd:StrategyStub ; sd:ordinal 15 ; sd:shortTitle "Control where and when engagement happens" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-16 a sd:StrategyStub ; sd:ordinal 16 ; sd:shortTitle "Target the source of the rival's strength" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-18 a sd:StrategyStub ; sd:ordinal 18 ; sd:shortTitle "Expose a flank and turn the rival's position" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-19 a sd:StrategyStub ; sd:ordinal 19 ; sd:shortTitle "Envelop the rival so every option is covered" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-20 a sd:StrategyStub ; sd:ordinal 20 ; sd:shortTitle "Maneuver the rival into a weakened position" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-21 a sd:StrategyStub ; sd:ordinal 21 ; sd:shortTitle "Negotiate while still advancing your position" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-24 a sd:StrategyStub ; sd:ordinal 24 ; sd:shortTitle "Pair the expected move with an unexpected one" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-25 a sd:StrategyStub ; sd:ordinal 25 ; sd:shortTitle "Hold the moral high ground in public view" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-26 a sd:StrategyStub ; sd:ordinal 26 ; sd:shortTitle "Deny the rival any target to strike" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-28 a sd:StrategyStub ; sd:ordinal 28 ; sd:shortTitle "Give rivals room to overreach, then respond" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-29 a sd:StrategyStub ; sd:ordinal 29 ; sd:shortTitle "Take ground quietly and present it as settled" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-30 a sd:StrategyStub ; sd:ordinal 30 ; sd:shortTitle "Seed ideas that change how others decide" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-31 a sd:StrategyStub ; sd:ordinal 31 ; sd:shortTitle "Build influence inside the rival's own camp" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-32 a sd:StrategyStub ; sd:ordinal 32 ; sd:shortTitle "Resist indirectly while appearing cooperative" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-33 a sd:StrategyStub ; sd:ordinal 33 ; sd:shortTitle "Trigger a cascade that spreads uncertainty" ; sd:sourceWork sd:work-33-strategies .

#################################################################
# Operationalized strategies (own compositions)
#################################################################

sd:strategy-11 a sd:Strategy ; sd:ordinal 11 ;
    sd:shortTitle "Trade ground for time; decline decisive battle" ;
    sd:sourceWork sd:work-33-strategies ;
    sd:composedOf sd:strategy-11-step-1 , sd:strategy-11-step-2 , sd:strategy-11-step-3 , sd:strategy-11-step-4 ;
    sd:appliesWhen sd:cond-low-win-rate ;
    sd:hasFalsifier sd:falsifier-11 ;
    sd:producesEffect sd:effect-preserve-force ;
    sd:servesObjective sd:objective-survive .
sd:strategy-11-step-1 a sd:Step ; sd:order 1 ; sd:operator sd:withdraw .
sd:strategy-11-step-2 a sd:Step ; sd:order 2 ; sd:operator sd:delay .
sd:strategy-11-step-3 a sd:Step ; sd:order 3 ; sd:operator sd:conceal .
sd:strategy-11-step-4 a sd:Step ; sd:order 4 ; sd:operator sd:probe .

sd:strategy-14 a sd:Strategy ; sd:ordinal 14 ;
    sd:shortTitle "Strike fast before the rival can adjust" ;
    sd:sourceWork sd:work-33-strategies ;
    sd:composedOf sd:strategy-14-step-1 , sd:strategy-14-step-2 , sd:strategy-14-step-3 , sd:strategy-14-step-4 ;
    sd:appliesWhen sd:cond-long-runway , sd:cond-slow-rivals ;
    sd:hasFalsifier sd:falsifier-14 ;
    sd:producesEffect sd:effect-seize-initiative ;
    sd:servesObjective sd:objective-gain-share ;
    sd:counteredBy sd:strategy-11 .
sd:strategy-14-step-1 a sd:Step ; sd:order 1 ; sd:operator sd:probe .
sd:strategy-14-step-2 a sd:Step ; sd:order 2 ; sd:operator sd:concentrate .
sd:strategy-14-step-3 a sd:Step ; sd:order 3 ; sd:operator sd:accelerate .
sd:strategy-14-step-4 a sd:Step ; sd:order 4 ; sd:operator sd:commit .

sd:strategy-17 a sd:Strategy ; sd:ordinal 17 ;
    sd:shortTitle "Split the opposition and take the parts in turn" ;
    sd:sourceWork sd:work-33-strategies ;
    sd:composedOf sd:strategy-17-step-1 , sd:strategy-17-step-2 , sd:strategy-17-step-3 , sd:strategy-17-step-4 ;
    sd:appliesWhen sd:cond-many-rivals ;
    sd:hasFalsifier sd:falsifier-17 ;
    sd:producesEffect sd:effect-fragment-opposition ;
    sd:servesObjective sd:objective-gain-share ;
    sd:counteredBy sd:strategy-27 .
sd:strategy-17-step-1 a sd:Step ; sd:order 1 ; sd:operator sd:probe .
sd:strategy-17-step-2 a sd:Step ; sd:order 2 ; sd:operator sd:divide .
sd:strategy-17-step-3 a sd:Step ; sd:order 3 ; sd:operator sd:concentrate .
sd:strategy-17-step-4 a sd:Step ; sd:order 4 ; sd:operator sd:commit .

sd:strategy-22 a sd:Strategy ; sd:ordinal 22 ;
    sd:shortTitle "Plan the exit before entering the contest" ;
    sd:sourceWork sd:work-33-strategies ;
    sd:composedOf sd:strategy-22-step-1 , sd:strategy-22-step-2 , sd:strategy-22-step-3 ;
    sd:appliesWhen sd:cond-high-churn ;
    sd:hasFalsifier sd:falsifier-22 ;
    sd:producesEffect sd:effect-bounded-downside ;
    sd:servesObjective sd:objective-survive .
sd:strategy-22-step-1 a sd:Step ; sd:order 1 ; sd:operator sd:shape .
sd:strategy-22-step-2 a sd:Step ; sd:order 2 ; sd:operator sd:commit .
sd:strategy-22-step-3 a sd:Step ; sd:order 3 ; sd:operator sd:withdraw .

sd:strategy-23 a sd:Strategy ; sd:ordinal 23 ;
    sd:shortTitle "Shape what the rival believes it sees" ;
    sd:sourceWork sd:work-33-strategies ;
    sd:composedOf sd:strategy-23-step-1 , sd:strategy-23-step-2 , sd:strategy-23-step-3 , sd:strategy-23-step-4 ;
    sd:appliesWhen sd:cond-fast-rivals ;
    sd:hasFalsifier sd:falsifier-23 ;
    sd:producesEffect sd:effect-misdirected-response ;
    sd:servesObjective sd:objective-gain-share ;
    sd:counteredBy sd:strategy-13 .
sd:strategy-23-step-1 a sd:Step ; sd:order 1 ; sd:operator sd:conceal .
sd:strategy-23-step-2 a sd:Step ; sd:order 2 ; sd:operator sd:shape .
sd:strategy-23-step-3 a sd:Step ; sd:order 3 ; sd:operator sd:reveal .
sd:strategy-23-step-4 a sd:Step ; sd:order 4 ; sd:operator sd:concentrate .

sd:strategy-27 a sd:Strategy ; sd:ordinal 27 ;
    sd:shortTitle "Advance through partners who carry the cost" ;
    sd:sourceWork sd:work-33-strategies ;
    sd:composedOf sd:strategy-27-step-1 , sd:strategy-27-step-2 , sd:strategy-27-step-3 ;
    sd:appliesWhen sd:cond-short-runway ;
    sd:hasFalsifier sd:falsifier-27 ;
    sd:producesEffect sd:effect-shared-cost ;
    sd:servesObjective sd:objective-survive .
sd:strategy-27-step-1 a sd:Step ; sd:order 1 ; sd:operator sd:combine .
sd:strategy-27-step-2 a sd:Step ; sd:order 2 ; sd:operator sd:substitute .
sd:strategy-27-step-3 a sd:Step ; sd:order 3 ; sd:operator sd:commit .
