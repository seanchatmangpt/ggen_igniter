@prefix sd: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# 33S catalog: this marketplace's own operationalization, indexed by ordinal.
#
# Each entry carries ONLY: an ordinal, an own paraphrased title of at most 60
# characters, a source-work anchor, and (when operationalized) an own
# composition of primitive operators with falsifiers, conditions and effects.
# No text, heading or excerpt of the source work appears here; sd:quote does
# not exist and gate 050 refuses it. See sd:nonclaim-licensing in ontology.ttl.
#
# Ordinal alignment with the source work's sequence is best-effort and
# UNVERIFIED against a licensed copy; the ordinal is an index, not a citation.
#
# Operationalized (sd:Strategy, composition + falsifier): 11 14 17 22 23 27.
# All other entries are sd:StrategyStub (title + ordinal only).

#################################################################
# Objectives and effects
#################################################################

sd:objective-survive a sd:StrategicObjective ;
    rdfs:label "Survive the contest with capability intact" .
sd:objective-gain-share a sd:StrategicObjective ;
    rdfs:label "Gain share in a chosen segment" .

sd:effect-preserve-force a sd:StrategicEffect ; rdfs:label "Resources preserved for a later engagement" .
sd:effect-seize-initiative a sd:StrategicEffect ; rdfs:label "Initiative held before rivals react" .
sd:effect-fragment-opposition a sd:StrategicEffect ; rdfs:label "Opposition engaged one part at a time" .
sd:effect-bounded-downside a sd:StrategicEffect ; rdfs:label "Loss bounded by a pre-set exit" .
sd:effect-misdirected-response a sd:StrategicEffect ; rdfs:label "Rival effort spent on a decoy front" .
sd:effect-shared-cost a sd:StrategicEffect ; rdfs:label "Cost of advance carried by partners" .

#################################################################
# Conditions (public classes only; gate 020)
#################################################################

sd:cond-low-win-rate a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:win-rate ;
    sd:comparator "lt" ; sd:threshold 0.35 .
sd:cond-long-runway a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:runway-months ;
    sd:comparator "gte" ; sd:threshold 18.0 .
sd:cond-slow-rivals a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:rival-response-days ;
    sd:comparator "gte" ; sd:threshold 30.0 .
sd:cond-many-rivals a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:rival-count ;
    sd:comparator "gte" ; sd:threshold 3.0 .
sd:cond-high-churn a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:churn-rate ;
    sd:comparator "gte" ; sd:threshold 0.15 .
sd:cond-fast-rivals a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:rival-response-days ;
    sd:comparator "lt" ; sd:threshold 30.0 .
sd:cond-short-runway a sd:StrategicCondition ;
    sd:aboutClass org:Organization ; sd:observedProperty sd:runway-months ;
    sd:comparator "lt" ; sd:threshold 18.0 .

#################################################################
# Falsifiers (sd:Falsifier rdfs:subClassOf do:Falsifier)
#################################################################

sd:falsifier-11 a sd:Falsifier ;
    sd:observedProperty sd:segment-share ; sd:comparator "lt" ; sd:threshold 0.05 ; sd:windowDays 180 ;
    sd:refutedWhen "Held segment share is below 5% after 180 days of declining head-on deals." .
sd:falsifier-14 a sd:Falsifier ;
    sd:observedProperty sd:rival-response-days ; sd:comparator "lt" ; sd:threshold 14.0 ; sd:windowDays 60 ;
    sd:refutedWhen "A rival visibly responds within 14 days, before the advantage compounds." .
sd:falsifier-17 a sd:Falsifier ;
    sd:observedProperty sd:win-rate ; sd:comparator "lt" ; sd:threshold 0.40 ; sd:windowDays 120 ;
    sd:refutedWhen "Win rate inside the isolated segment stays below 40% after 120 days." .
sd:falsifier-22 a sd:Falsifier ;
    sd:observedProperty sd:runway-months ; sd:comparator "lt" ; sd:threshold 3.0 ; sd:windowDays 90 ;
    sd:refutedWhen "Runway falls under 3 months before the pre-set exit trigger fires." .
sd:falsifier-23 a sd:Falsifier ;
    sd:observedProperty sd:rival-misallocation ; sd:comparator "lt" ; sd:threshold 0.20 ; sd:windowDays 60 ;
    sd:refutedWhen "Less than 20% of rival spend moves to the decoy front within 60 days." .
sd:falsifier-27 a sd:Falsifier ;
    sd:observedProperty sd:partner-sourced-share ; sd:comparator "lt" ; sd:threshold 0.15 ; sd:windowDays 180 ;
    sd:refutedWhen "Partners source less than 15% of new revenue after 180 days." .

#################################################################
# Stubs (ordinal + own title only)
#################################################################

sd:strategy-01 a sd:StrategyStub ; sd:ordinal 1 ; sd:shortTitle "Name an opponent to focus collective effort" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-02 a sd:StrategyStub ; sd:ordinal 2 ; sd:shortTitle "Fight the present contest, not the previous one" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-03 a sd:StrategyStub ; sd:ordinal 3 ; sd:shortTitle "Stay composed when conditions turn chaotic" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-04 a sd:StrategyStub ; sd:ordinal 4 ; sd:shortTitle "Cut off retreat to force full commitment" ; sd:sourceWork sd:work-33-strategies .
sd:strategy-05 a sd:StrategyStub ; sd:ordinal 5 ; sd:shortTitle "Unify command so intent reaches the edge" ; sd:sourceWork sd:work-33-strategies .
