    ck:name "InvalidProjectionTypesRefusal" ;
    ck:trigger "projections is not a list." ;
    ck:recovery "Pass projections as a list of admitted type strings." ;
    ck:sourceVersion "26.11.19" ;
    ck:observedTrigger "test/ggen_igniter_semantic_jira_admission_refusal_court_test.exs::kat_WO-INVALID-PROJECTION-TYPES_refusal_live" .

ck:code-WO-UNSUPPORTED-RECEIPT-CLASS a ck:RefusalCode ;
    ck:token "WO-UNSUPPORTED-RECEIPT-CLASS" ;
    ck:name "UnsupportedReceiptClassRefusal" ;
    ck:trigger "required_receipt_classes contains a class outside @receipt_classes." ;
