    ck:token "WO-INVALID-RECEIPT-CLASSES" ;
    ck:name "InvalidReceiptClassesRefusal" ;
    ck:trigger "required_receipt_classes is not a list." ;
    ck:recovery "Pass required_receipt_classes as a list (possibly empty)." ;
    ck:sourceVersion "26.11.19" ;
    ck:observedTrigger "test/ggen_igniter_semantic_jira_admission_refusal_court_test.exs::kat_WO-INVALID-RECEIPT-CLASSES_refusal_live" .

ck:code-WO-INVALID-PATH-SCOPE a ck:RefusalCode ;
    ck:token "WO-INVALID-PATH-SCOPE" ;
    ck:name "InvalidPathScopeRefusal" ;
    ck:trigger "path_scope contains an absolute path, blank, or non-binary entry." ;
    ck:recovery "Use repo-relative non-blank path strings only." ;
    ck:sourceVersion "26.11.19" ;
    ck:observedTrigger "test/ggen_igniter_semantic_jira_admission_refusal_court_test.exs::kat_WO-INVALID-PATH-SCOPE_refusal_live" .

ck:code-WO-INVALID-ORIGIN-AUTHORITY a ck:RefusalCode ;
    ck:token "WO-INVALID-ORIGIN-AUTHORITY" ;
    ck:name "InvalidOriginAuthorityRefusal" ;
    ck:trigger "origin_authority is not an absolute IRI string." ;
    ck:recovery "Name an admitted sj:CodeWorkAuthority IRI." ;
    ck:sourceVersion "26.11.19" ;
    ck:observedTrigger "test/ggen_igniter_semantic_jira_admission_refusal_court_test.exs::kat_WO-INVALID-ORIGIN-AUTHORITY_refusal_live" .

ck:code-WO-INVALID-ORIGIN-OBSERVATION a ck:RefusalCode ;
    ck:token "WO-INVALID-ORIGIN-OBSERVATION" ;
    ck:name "InvalidOriginObservationRefusal" ;
    ck:trigger "origin_observation is present but not an absolute IRI." ;
    ck:recovery "Omit origin_observation or supply an absolute IRI." ;
    ck:sourceVersion "26.11.19" ;
    ck:observedTrigger "test/ggen_igniter_semantic_jira_admission_refusal_court_test.exs::kat_WO-INVALID-ORIGIN-OBSERVATION_refusal_live" .

ck:code-WO-INVALID-TARGET-PACK a ck:RefusalCode ;
    ck:token "WO-INVALID-TARGET-PACK" ;
    ck:name "InvalidTargetPackRefusal" ;
    ck:trigger "target_pack is present but fails the lowercase pack-name FORMAT law." ;
    ck:recovery "Use a lowercase-leading [a-z0-9][a-z0-9_-]* pack name, or omit." ;
    ck:sourceVersion "26.11.19" .
