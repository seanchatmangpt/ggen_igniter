@prefix utp: <https://ggen-igniter.dev/ontology/ultracode-two-port#> .
@prefix ex:  <https://ggen-igniter.dev/fixture/ultracode#> .

# FALSIFIER: an agent with a work port but no SA2A capability port.
ex:Headless a utp:ConstructorAgent ;
    utp:workPort utp:sJira ;
    utp:otpApp "headless" ;
    utp:modulePrefix "Headless.Agent" ;
    utp:agentName "headless" ;
    utp:libPath "lib/headless/agent" ;
    utp:sa2aTarget "Headless.Target" .
