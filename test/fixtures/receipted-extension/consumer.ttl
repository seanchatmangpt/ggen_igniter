@prefix rx: <https://ggen-igniter.dev/ontology/receipted-extension#> .
@prefix ex: <https://ggen-igniter.dev/fixture/receipted-extension#> .

# Consumer declaration: concatenated with the pack ontology before sync.
ex:Target a rx:ReceiptedExtension ;
    rx:moduleName "ReceiptedFixture.Receipted" ;
    rx:libPath "lib/receipted_fixture" ;
    rx:sectionName "receipted" ;
    rx:entityName "receipt" ;
    rx:entityArg "kind" ;
    rx:targetResource "ReceiptedFixture.Widget" ;
    rx:wireTaskModule "Mix.Tasks.ReceiptedFixture.Receipted.Wire" ;
    rx:wireTaskName "receipted_fixture.receipted.wire" .
