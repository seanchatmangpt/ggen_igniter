    sj:pathScope "Cargo workspace build + tests" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:postcondition "The complete cargo build and test suite passes at the campaign subject." ;
    sj:falsifier "Any workspace build or test failure at the campaign head." .

