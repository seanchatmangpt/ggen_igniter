{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ggen_igniter SA2A Diataxis input",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "repository",
    "role",
    "authority",
    "generator",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "sa2a-diataxis/v1"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "runtime",
        "semantic",
        "manufacture",
        "evidence",
        "ash-extension",
        "product",
        "prior-art",
        "support"
      ]
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
