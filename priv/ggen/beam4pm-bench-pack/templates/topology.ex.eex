#
# Real BEAM-native distributed-topology discovery benchmark, manufactured
# from priv/ggen/beam4pm-bench-pack/ontology.ttl's bb:TopologyBenchDef
# individual. Namespace-parameterized port of ex4pm's own real reference
# implementation
# (~/ex4pm/apps/ex4pm_engine/lib/ex4pm_engine/bench/topology.ex) — same
# :centralized / :edge topologies, same real Task.async/await message
# passing, no logic changes beyond the module prefix (this template's
# `<%= namespace %>.Bench.Topology` aliases `<%= namespace %>.Bench.VirtualCost`,
# manufactured by this pack's sibling `virtual_cost.ex.eex` template — render
# that one first).
defmodule <%= namespace %>.Bench.Topology do
  @moduledoc """
  Real BEAM-native benchmark harness comparing distributed-engine topologies
  for process discovery (directly-follows graph, DFG), under a virtual-cost
  model (`<%= namespace %>.Bench.VirtualCost`: compute/store/send operation
  counts) rather than wall-clock time.

  A toy event log is a list of `{case_id, activity, timestamp}` tuples.
  Discovery computes the DFG: for each case, sort its events by timestamp,
  then count `{activity_a, activity_b}` directly-follows edge frequencies
  across all cases. The DFG is `%{ {a, b} => frequency }`.

  Two real topologies are implemented:

    * `:centralized` — a single process holds the whole log, sorts each
      case, and builds the DFG directly. No inter-process communication.
    * `:edge` — the log is partitioned across N real BEAM processes (one
      `Task` per simulated node), each computes a local partial DFG over its
      own shard of cases, then sends its partial DFG back to the coordinator,
      which merges them by summing edge frequencies. This exercises real
      message passing (`Task.async`/`Task.await`, which is a real send/receive
      round-trip), not just a sequential map/reduce in one process.

  Both topologies are asserted (by the test suite) to produce the same final
  merged DFG for the same input log — the correctness invariant this harness
  exists to check before its virtual-cost numbers are trusted.
  """

  alias <%= namespace %>.Bench.VirtualCost

  @type event :: {case_id :: term(), activity :: String.t(), timestamp :: integer()}
  @type dfg :: %{optional({String.t(), String.t()}) => pos_integer()}

  @doc """
  Runs discovery in the `:centralized` topology: one process does everything.

  Returns `{dfg, virtual_cost}`.
  """
  @spec run_centralized([event()]) :: {dfg(), VirtualCost.t()}
  def run_centralized(events) when is_list(events) do
    cost = VirtualCost.new()

    {cases_by_id, cost} = group_by_case(events, cost)
    {dfg, cost} = build_dfg(cases_by_id, cost)

    {dfg, cost}
  end

  @doc """
  Runs discovery in the `:edge` topology: the log is partitioned across
  `node_count` real BEAM processes (`Task`s), each computes a local DFG over
  its shard, and results are merged by the coordinator.

  Returns `{dfg, virtual_cost}` where `virtual_cost` is the coordinator's own
  cost merged with every worker's real reported cost — i.e. the true total
  cost of the distributed run, not just the coordinator's local view.
  """
  @spec run_edge([event()], pos_integer()) :: {dfg(), VirtualCost.t()}
  def run_edge(events, node_count)
      when is_list(events) and is_integer(node_count) and node_count > 0 do
    coordinator_cost = VirtualCost.new()

    {cases_by_id, coordinator_cost} = group_by_case(events, coordinator_cost)
    case_ids = Map.keys(cases_by_id)
    shards = shard_case_ids(case_ids, node_count)

    tasks =
      for shard <- shards, shard != [] do
        shard_cases = Map.take(cases_by_id, shard)

        Task.async(fn ->
          # Each worker starts with its own zeroed counter — this is a real
          # separate BEAM process's real local counter, not a shared mock.
          worker_cost = VirtualCost.new()
          {local_dfg, worker_cost} = build_dfg(shard_cases, worker_cost)
          # The worker "sends" its result back via the Task's real message
          # return; count that as one send from this worker's perspective.
          worker_cost = VirtualCost.send_op(worker_cost)
          {local_dfg, worker_cost}
        end)
      end

    results = Task.await_many(tasks, 30_000)

    # Coordinator receives each worker's message: one :store per received
    # partial result (recording it before merge) plus real merge computation.
    {merged_dfg, coordinator_cost} =
      Enum.reduce(results, {%{}, coordinator_cost}, fn {local_dfg, worker_cost},
                                                       {acc_dfg, acc_cost} ->
        acc_cost = VirtualCost.store(acc_cost)
        acc_cost = VirtualCost.merge(acc_cost, worker_cost)
        {merge_dfgs(acc_dfg, local_dfg), acc_cost}
      end)

    {merged_dfg, coordinator_cost}
  end

  # -- shared internals -------------------------------------------------

  defp group_by_case(events, cost) do
    grouped = Enum.group_by(events, fn {case_id, _activity, _ts} -> case_id end)
    cost = VirtualCost.compute(cost, max(length(events), 1))
    cost = VirtualCost.store(cost)
    {grouped, cost}
  end

  defp shard_case_ids(case_ids, node_count) do
    case_ids
    |> Enum.with_index()
    |> Enum.group_by(fn {_id, idx} -> rem(idx, node_count) end, fn {id, _idx} -> id end)
    |> Map.values()
  end

  # Builds a DFG from a map of case_id => [events], real, in-process,
  # incrementing compute/store on this process's own counter.
  defp build_dfg(cases_by_id, cost) do
    Enum.reduce(cases_by_id, {%{}, cost}, fn {_case_id, case_events}, {dfg_acc, cost_acc} ->
      sorted = Enum.sort_by(case_events, fn {_c, _a, ts} -> ts end)
      cost_acc = VirtualCost.compute(cost_acc)

      activities = Enum.map(sorted, fn {_c, a, _ts} -> a end)

      {new_dfg, cost_acc} =
        activities
        |> Enum.chunk_every(2, 1, :discard)
        |> Enum.reduce({dfg_acc, cost_acc}, fn [a, b], {d, c} ->
          d = Map.update(d, {a, b}, 1, &(&1 + 1))
          c = VirtualCost.compute(c)
          c = VirtualCost.store(c)
          {d, c}
        end)

      {new_dfg, cost_acc}
    end)
  end

  defp merge_dfgs(dfg_a, dfg_b) do
    Map.merge(dfg_a, dfg_b, fn _edge, freq_a, freq_b -> freq_a + freq_b end)
  end

  @doc """
  Generates a real synthetic toy event log with `case_count` cases, each
  following one of a small fixed set of activity sequences (with
  case-specific timestamps), for use as harness input in benchmarks/tests.
  """
  @spec synthetic_log(pos_integer()) :: [event()]
  def synthetic_log(case_count) when is_integer(case_count) and case_count > 0 do
    templates = [
      ["A", "B", "C", "D"],
      ["A", "B", "D"],
      ["A", "C", "B", "D"]
    ]

    for case_idx <- 1..case_count,
        template = Enum.at(templates, rem(case_idx, length(templates))),
        {activity, step} <- Enum.with_index(template) do
      {"case-#{case_idx}", activity, case_idx * 1000 + step}
    end
  end
end
