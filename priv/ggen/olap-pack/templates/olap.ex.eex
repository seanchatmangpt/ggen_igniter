# (`Ex4pm.Core.OLAP`), parameterized here for `<%= moduleName %>` over
# `<%= logModule %>`/`<%= eventModule %>`.
defmodule <%= moduleName %> do
  @moduledoc """
  OLAP-style multi-dimensional operations (`slice/3`, `dice/2`, `roll_up/3`,
  `drill_down/3`) over the canonical `<%= logModule %>` IR. Operates on real
  `%<%= logModule %>{}` structs (events with `:activity`, `:timestamp`,
  `:attributes`, `:object_ids`).

  A "dimension" is one of:

    * `:activity` -- the event's activity name
    * `:day` -- the `YYYY-MM-DD` prefix of the event's ISO-8601 timestamp
    * `:month` -- the `YYYY-MM` prefix of the event's ISO-8601 timestamp
    * `{:attribute, key}` -- an arbitrary event attribute, looked up by
      string or atom `key` in `event.attributes`
    * `{:object_type, type}` -- not a value-extraction dimension; used only
      via `slice/3`/`dice/2` to filter events that reference at least one
      object of `type` (requires `log.objects`)

  `:day` and `:month` form a two-level time hierarchy: `roll_up/3` from
  `:day` to `:month` coarsens; `drill_down/3` from `:month` to `:day`
  re-expands.

  Manufactured by ggen_igniter's `olap-pack`
  (`priv/ggen/olap-pack/ontology.ttl` -> `priv/ggen/olap-pack/templates/olap.ex.eex`).
  Never hand-edit this file -- edit the ontology instead.
  """

  alias <%= logModule %>, as: EventLog
  alias <%= eventModule %>, as: Event

  @doc """
  Filters `log` to only the events whose `dimension` value equals `value`.
  Objects and object_relationships are narrowed to what the surviving events
  still reference, so the result is itself a coherent `%EventLog{}`.
  """
  @spec slice(EventLog.t(), atom() | {atom(), term()}, term()) :: EventLog.t()
  def slice(%EventLog{} = log, dimension, value) do
    dice(log, [{dimension, value}])
  end

  @doc """
  Filters `log` to only the events matching every `{dimension, value}` pair
  in `filters` simultaneously (logical AND across dimensions).
  """
  @spec dice(EventLog.t(), [{atom() | {atom(), term()}, term()}]) :: EventLog.t()
  def dice(%EventLog{} = log, filters) when is_list(filters) do
    kept_events =
      Enum.filter(log.events, fn event ->
        Enum.all?(filters, fn {dimension, value} -> matches?(log, event, dimension, value) end)
      end)

    rebuild(log, kept_events)
  end

  @doc """
  Aggregates `log`'s events up a dimension hierarchy. Groups events by their
  `dimension` value and applies `aggregate_fn` (a function of the list of
  events in that group) to each group.

  Returns a map of `dimension_value => aggregate_fn.(events_in_group)`,
  sorted by key for deterministic output.
  """
  @spec roll_up(EventLog.t(), atom() | {atom(), term()}, ([Event.t()] -> term())) ::
          %{optional(term()) => term()}
  def roll_up(%EventLog{} = log, dimension, aggregate_fn) when is_function(aggregate_fn, 1) do
    log.events
    |> Enum.group_by(&dimension_value(&1, dimension))
    |> Enum.reject(fn {key, _events} -> is_nil(key) end)
    |> Enum.map(fn {key, events} -> {key, aggregate_fn.(events)} end)
    |> Enum.sort_by(fn {key, _} -> key end)
    |> Map.new()
  end

  @doc """
  Expands an aggregated `dimension` back to a `finer_dimension`. Groups
  `log`'s events first by `dimension` (the coarse grouping), then by
  `finer_dimension` within each coarse group, returning a nested map:

      %{coarse_value => %{finer_value => [events]}}

  This is the structural inverse of `roll_up/3`: rolling `log` up to
  `dimension` with `&length/1` and summing the inner group sizes of
  `drill_down/3`'s result for the same coarse key recovers the same count.
  """
  @spec drill_down(EventLog.t(), atom() | {atom(), term()}, atom() | {atom(), term()}) ::
          %{optional(term()) => %{optional(term()) => [Event.t()]}}
  def drill_down(%EventLog{} = log, dimension, finer_dimension) do
    log.events
    |> Enum.group_by(&dimension_value(&1, dimension))
    |> Enum.reject(fn {key, _events} -> is_nil(key) end)
    |> Enum.map(fn {coarse_key, events} ->
      inner =
        events
        |> Enum.group_by(&dimension_value(&1, finer_dimension))
        |> Enum.reject(fn {key, _events} -> is_nil(key) end)
        |> Enum.sort_by(fn {key, _} -> key end)
        |> Map.new()

      {coarse_key, inner}
    end)
    |> Enum.sort_by(fn {key, _} -> key end)
    |> Map.new()
  end

  # -- dimension extraction -------------------------------------------------

  defp matches?(log, event, {:object_type, type}, expected) do
    referenced_types =
      event.object_ids
      |> Enum.map(&Map.get(log.objects, &1))
      |> Enum.reject(&is_nil/1)
      |> Enum.map(& &1.type)
      |> Enum.map(&to_string/1)

    to_string(type) == to_string(expected) and to_string(expected) in referenced_types
  end

  defp matches?(_log, event, dimension, expected) do
    dimension_value(event, dimension) == expected
  end

  defp dimension_value(%Event{} = event, :activity), do: event.activity
  defp dimension_value(%Event{} = event, :day), do: date_prefix(event.timestamp, 10)
  defp dimension_value(%Event{} = event, :month), do: date_prefix(event.timestamp, 7)

  defp dimension_value(%Event{} = event, {:attribute, key}) do
    Map.get(event.attributes, key) || Map.get(event.attributes, to_string(key)) ||
      Map.get(event.attributes, to_atom_if_existing(key))
  end

  defp date_prefix(timestamp, length) when is_binary(timestamp) do
    if String.length(timestamp) >= length, do: String.slice(timestamp, 0, length), else: nil
  end

  defp date_prefix(_other, _length), do: nil

  defp to_atom_if_existing(key) when is_binary(key) do
    String.to_existing_atom(key)
  rescue
    ArgumentError -> nil
  end

  defp to_atom_if_existing(key), do: key

  defp rebuild(%EventLog{} = log, kept_events) do
    kept_object_ids =
      kept_events
      |> Enum.flat_map(& &1.object_ids)
      |> MapSet.new()

    kept_objects = Map.filter(log.objects, fn {id, _object} -> id in kept_object_ids end)

    kept_object_relationships =
      Enum.filter(log.object_relationships, fn rel ->
        rel.source_id in kept_object_ids and rel.target_id in kept_object_ids
      end)

    %EventLog{
      log
      | events: kept_events,
        objects: kept_objects,
        object_relationships: kept_object_relationships,
        metadata:
          Map.merge(log.metadata, %{
            event_count: length(kept_events),
            object_count: map_size(kept_objects)
          })
    }
  end
end
