---
to: "lib/ggen_igniter/reactors/examples/expense_approval_reactor.ex"
mode: file
---
<%
  [head | _] = steps
  module_name = head["moduleName"]
  inputs = head["inputs"] |> String.split(",") |> Enum.map(&String.trim/1)
  return_step = head["returnStep"]
  middlewares = head["middlewares"]
  ordered = Enum.sort_by(steps, &String.to_integer(&1["order"]))
%># GENERATED by ggen_igniter from priv/ggen/reactor-scaffold-pack/ontology.ttl.
# Do not edit. Regenerate with:
#   mix ggen_igniter.sync --pack reactor-scaffold-pack \
#     --out lib/ggen_igniter/reactors/examples/expense_approval_reactor.ex
#
# Practice/dogfood example: a full-featured plain `Reactor` (per ADR-0003,
# never Ash.Reactor) manufactured entirely from ontology data, exercising
# every construct in the real Reactor cheatsheet
# (https://reactor.hexdocs.pm/reactor-cheatsheet.html): input, step
# (argument/value/run/compensate/undo/async?/where/guard/max_retries/
# wait_for), debug, group, switch, compose, collect, map, around, template,
# middlewares, return.
defmodule <%= module_name %> do
  @moduledoc """
  Manufactured example Reactor demonstrating the full plain-Reactor DSL
  surface documented at
  https://reactor.hexdocs.pm/reactor-cheatsheet.html — the same primitives
  `GgenIgniter.Reactors.ReconcileReactor` itself uses in production.

  Regenerate via `mix ggen_igniter.sync --pack reactor-scaffold-pack
  --out lib/ggen_igniter/reactors/examples/expense_approval_reactor.ex`.
  Never hand-edit this file — edit `priv/ggen/reactor-scaffold-pack/ontology.ttl`
  instead.
  """
  use Reactor

<%= if middlewares do %>  <%= middlewares %>
<% end %>
<%= for field <- inputs do %>  input :<%= field %>
<% end %>
<%= for row <- ordered do %>
<%= if row["kind"] == "step" do %>  step :<%= row["name"] %> do
    <%= row["arguments"] %>
    async? <%= row["async"] || "false" %>
<%= if row["maxRetries"] do %>    max_retries <%= row["maxRetries"] %>
<% end %>
    run <%= row["runBody"] %>
<%= if row["compensateBody"] do %>
    compensate <%= row["compensateBody"] %>
<% end %><%= if row["undoBody"] do %>
    undo <%= row["undoBody"] %>
<% end %><%= if row["whereBody"] do %>
    where <%= row["whereBody"] %>
<% end %><%= if row["guardBody"] do %>
    guard <%= row["guardBody"] %>
<% end %><%= if row["waitFor"] do %>
    wait_for :<%= row["waitFor"] %>
<% end %>  end
<% else %>  <%= row["body"] %>
<% end %>
<% end %>
  return :<%= return_step %>
end
