---
to: "<%= diagram_path %>"
for_each: saga_diagrams
mode: file
---
<%
  my_steps = Enum.filter(saga_steps, &(&1["reactor_iri"] == reactor_iri))
  name_of = Map.new(my_steps, &{&1["step_iri"], &1["name"]})
  edges =
    for row <- saga_deps ++ saga_waits,
        row["step_iri"] in Map.keys(name_of),
        dep = name_of[row["dep_iri"]],
        do: {dep, name_of[row["step_iri"]], if(row in saga_waits, do: "-.->", else: "-->")}
%><!-- GENERATED by ggen_igniter (reactor-scaffold-pack:saga_diagram) from <%= reactor_iri %>. Do not edit. -->
# <%= module_name %>

```mermaid
flowchart TD
<%= for s <- Enum.sort_by(my_steps, & &1["name"]) do %>  <%= s["name"] %>["<%= s["name"] %>"]
<% end %><%= for {from, to, arrow} <- Enum.uniq(edges) do %>  <%= from %> <%= arrow %> <%= to %>
<% end %>```
