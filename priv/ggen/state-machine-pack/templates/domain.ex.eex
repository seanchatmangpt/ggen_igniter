---
to: "<%= lib_path %>/<%= file_stem %>.ex"
for_each: domains
---
# GENERATED by state-machine-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: sm:domainModule facts + priv/ggen/state-machine-pack/ontology.ttl.
<%
  members =
    machines
    |> Enum.filter(&(&1["domain_module"] == domain_module))
    |> Enum.map(& &1["resource_module"])
    |> Enum.sort()
%>defmodule <%= domain_module %> do
  @moduledoc "Ash domain listing the state-machine resources declared against it."
  use Ash.Domain, validate_config_inclusion?: false

  resources do
<%= for m <- members do %>    resource <%= m %>
<% end %>  end
end
