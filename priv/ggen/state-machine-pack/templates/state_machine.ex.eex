---
to: "<%= lib_path %>/<%= file_stem %>.ex"
for_each: machines
---
<%
  # ---- conservation gate: every refusal set is computed over the WHOLE graph, so a bad
  # machine refuses every row (no partial output). Typed codes: priv/schema/refusals.schema.json.
  by_machine = fn rows, key -> Enum.filter(rows, &(&1["machine"] == key)) end

  sparql_refusals =
    [
      {"INITIAL_STATE_MISSING", refuse_initial_missing},
      {"TRANSITION_UNKNOWN_STATE", refuse_transition_unknown_from},
      {"TRANSITION_UNKNOWN_STATE", refuse_transition_unknown_to},
      {"TRANSITION_UNKNOWN_STATE", refuse_initial_undeclared},
      {"TRANSITION_UNKNOWN_STATE", refuse_default_initial_undeclared},
      {"TRANSITION_UNKNOWN_STATE", refuse_default_initial_unnamed},
      {"STATE_DEAD_END", refuse_dead_end},
      {"ACTION_AMBIGUOUS_TARGET", refuse_action_ambiguous}
    ]
    |> Enum.flat_map(fn {code, rows} ->
      Enum.map(rows, &{code, &1["machine"], &1["detail"]})
    end)

  reachable = fn m ->
    edges =
      for t <- by_machine.(transitions, m), do: {t["from_state"], t["to_state"]}

    seeds = for i <- by_machine.(initials, m), do: i["state_name"]

    walk = fn walk, frontier, seen ->
      case frontier do
        [] -> seen
        [s | rest] ->
          if MapSet.member?(seen, s) do
            walk.(walk, rest, seen)
          else
            next = for {f, t} <- edges, f == s, do: t
            walk.(walk, next ++ rest, MapSet.put(seen, s))
          end
      end
    end

    walk.(walk, seeds, MapSet.new())
  end

  unreachable =
    for m <- machines,
        seen <- [reachable.(m["machine"])],
        s <- by_machine.(states, m["machine"]),
        not MapSet.member?(seen, s["state_name"]),
        do: {"STATE_UNREACHABLE", m["machine"], s["state_name"]}

  # identifier gate: names are interpolated raw as `:<name>`; refuse anything that is not a
  # legal atom identifier, and actions colliding with reserved Ash action names.
  ident = ~r/^[a-z_][a-zA-Z0-9_]*[?!]?$/
  reserved_actions = ["create", "read", "destroy"]

  bad_idents =
    for {kind, name} <-
          Enum.map(states, &{"stateName", &1["state_name"]}) ++
            Enum.map(transitions, &{"action", &1["action"]}) ++
            Enum.map(transitions, &{"stateName", &1["from_state"]}) ++
            Enum.map(transitions, &{"stateName", &1["to_state"]}) ++
            Enum.map(machines, &{"stateAttribute", &1["state_attribute"]}),
        not Regex.match?(ident, name),
        do: {"INPUT_INVALID", "", "#{kind} #{inspect(name)} is not a legal identifier"}

  bad_idents =
    Enum.uniq(bad_idents) ++
      Enum.uniq(
        for t <- transitions,
            t["action"] in reserved_actions,
            do: {"INPUT_INVALID", t["machine"], "action #{inspect(t["action"])} is reserved"}
      )

  all_refusals = sparql_refusals ++ unreachable ++ bad_idents

  if all_refusals != [] do
    raise Enum.map_join(all_refusals, "\n", fn {code, m, detail} ->
            "REFUSED:#{code} #{m}: #{detail}; broken_term=mu_on_O"
          end)
  end

  my_states = by_machine.(states, machine)
  my_initials = for i <- by_machine.(initials, machine), do: i["state_name"]
  my_transitions = by_machine.(transitions, machine)

  # one Ash update action per distinct action name (ambiguity gate guarantees one target)
  action_targets =
    my_transitions
    |> Enum.group_by(& &1["action"], & &1["to_state"])
    |> Enum.map(fn {a, tos} -> {a, hd(tos)} end)
    |> Enum.sort()

  # one AshStateMachine `transition` per (action, to), `from` as the list form
  grouped =
    my_transitions
    |> Enum.group_by(&{&1["action"], &1["to_state"]}, & &1["from_state"])
    |> Enum.map(fn {{a, to}, froms} -> {a, Enum.sort(Enum.uniq(froms)), to} end)
    |> Enum.sort()

  atoms = fn names -> "[" <> Enum.map_join(names, ", ", &(":" <> &1)) <> "]" end
  domain_ref = if domain_module == "", do: resource_module <> ".Domain", else: domain_module
%># GENERATED by state-machine-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: <%= machine %> + priv/ggen/state-machine-pack/ontology.ttl.
defmodule <%= resource_module %> do
  @moduledoc """
  State machine over `:<%= state_attribute %>`: states <%= atoms.(Enum.map(my_states, & &1["state_name"])) %>,
  initial <%= atoms.(my_initials) %>.
  """
  use Ash.Resource,
    domain: <%= domain_ref %>,
    data_layer: Ash.DataLayer.Ets,
    extensions: [AshStateMachine]

  ets do
    private? true
  end

  state_machine do
    state_attribute :<%= state_attribute %>
    initial_states <%= atoms.(my_initials) %>
<%= if default_initial != "" do %>    default_initial_state :<%= default_initial %>
<% end %>    transitions do
<%= for {a, froms, to} <- grouped do %>      transition :<%= a %>, from: <%= atoms.(froms) %>, to: :<%= to %>
<% end %>    end
  end

  attributes do
    uuid_primary_key :id
  end

  actions do
    defaults [:read]

    create :create do
      accept [<%= if default_initial == "", do: ":" <> state_attribute, else: "" %>]
    end
<%= for {a, to} <- action_targets do %>
    update :<%= a %> do
      accept []
      require_atomic? false
      change transition_state(:<%= to %>)
    end
<% end %>  end
end
<%= if domain_module == "" do %>
defmodule <%= domain_ref %> do
  @moduledoc "Inline Ash domain for `<%= resource_module %>`."
  use Ash.Domain, validate_config_inclusion?: false

  resources do
    resource <%= resource_module %>
  end
end
<% end %>
