---
to: "lib/mix/tasks/<%= task_name %>.ex"
for_each: tasks
mode: file
---
<%
  present? = fn v -> is_binary(v) and v != "" end
  truthy = fn
    true -> true
    "true" -> true
    _ -> false
  end

  delegate = Enum.find(delegates, &(&1["task"] == task))

  if refusals != [] or is_nil(delegate) do
    raise "REFUSED(TASK_DELEGATE_MISSING): #{task_name} has no complete delegate MFA " <>
            "(ig:delegateModule/ig:delegateFunction/ig:delegateArity); " <>
            "broken_term=mu_on_O"
  end

  delegate_module = delegate["delegate_module"]
  delegate_function = delegate["delegate_function"]
  delegate_arity = delegate["delegate_arity"]

  arity = if is_integer(delegate_arity), do: delegate_arity, else: String.to_integer("#{delegate_arity}")

  mine = Enum.filter(options, &(&1["task"] == task))
  schema_opts = Enum.filter(mine, &truthy.(&1["opt_in_schema"]))
  atom_of = fn s -> if s =~ ~r/^[a-z_][a-zA-Z0-9_]*$/, do: ":" <> s, else: inspect(String.to_atom(s)) end
  key_of = fn s -> String.replace(s, "-", "_") end
  aliases = Enum.filter(schema_opts, &present?.(&1["opt_alias"]))
  required = Enum.filter(schema_opts, &truthy.(&1["opt_required"]))
  flag = fn o -> "--" <> o["opt_name"] <> if(present?.(o["opt_metavar"]), do: " " <> o["opt_metavar"], else: "") end
  width = mine |> Enum.map(&String.length(flag.(&1))) |> Enum.max(fn -> 0 end)
  help_lines =
    Enum.map(mine, fn o ->
      "        " <> String.pad_trailing(flag.(o) <> if(present?.(o["opt_alias"]), do: ", -" <> o["opt_alias"], else: ""), width + 3) <> o["opt_help"]
    end)
  help_flags = if Enum.any?(aliases, &(&1["opt_name"] == "help")), do: ~s(["--help", "-h"]), else: ~s(["--help"])
  call_args = if arity == 1, do: "igniter", else: "igniter, igniter.args.options"
%>defmodule <%= module %> do
  @shortdoc "<%= shortdoc %>"
  @moduledoc """
  <%= summary %>.

  ## This file is manufactured -- do not hand-edit

  Rendered by `ggen_igniter` from `priv/ggen/igniter-task-pack/` (`ig:Task`
  `<%= task_name %>`). The option schema, help text and the delegate call are
  DERIVED from ontology facts; the body lives in `<%= delegate_module %>.<%= delegate_function %>/<%= arity %>`.

  ## Options

<%= Enum.map_join(mine, "\n", fn o -> "    * `" <> flag.(o) <> "` -- " <> o["opt_help"] end) %>

  ## Examples

  ```bash
  <%= example %>
  ```
  """

  use Igniter.Mix.Task

  @example "<%= example %>"

  @impl Igniter.Mix.Task
  def info(_argv, _composing_task) do
    %Igniter.Mix.Task.Info{
      group: :<%= group %>,
      example: @example,
      positional: [],
      schema: [
<%= Enum.map_join(schema_opts, ",\n", fn o -> "        " <> key_of.(o["opt_name"]) <> ": :" <> o["opt_type"] end) %>
      ],
      aliases: [<%= Enum.map_join(aliases, ", ", fn o -> o["opt_alias"] <> ": " <> atom_of.(key_of.(o["opt_name"])) end) %>],
      required: [<%= Enum.map_join(required, ", ", fn o -> atom_of.(key_of.(o["opt_name"])) end) %>]
    }
  end

  # `Igniter.Mix.Task`'s generated run/1 only matches the literal "--help"
  # (the AR-11 quirk, lib/mix/tasks/CLAUDE.md); GgenIgniter.TaskShell owns the fix.
  @impl Mix.Task
  def run(argv) do
    GgenIgniter.TaskShell.run_with_help(
      argv,
      fn -> print_help_and_halt() end,
      fn -> super(argv) end,
      <%= help_flags %>
    )
  end

  @impl Igniter.Mix.Task
  def igniter(igniter) do
    <%= delegate_module %>.<%= delegate_function %>(<%= call_args %>)
  end

  defp print_help_and_halt do
    IO.puts("""
    mix <%= task_name %> -- <%= summary %>

    USAGE
        #{@example}

    OPTIONS
<%= Enum.join(help_lines, "\n") %>
    """)

    System.halt(0)
  end
end
