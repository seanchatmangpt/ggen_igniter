export const OBJECT_TYPES = [
<%= for o <- Enum.sort_by(object_types, &String.to_integer(to_string(&1["order"]))) do %>  "<%= o["name"] %>",
<% end %>] as const
export type ObjectType = (typeof OBJECT_TYPES)[number]

export const EVENT_TYPES = [
<%= for e <- Enum.sort_by(event_types, &String.to_integer(to_string(&1["order"]))) do %>  "<%= e["name"] %>",
<% end %>] as const
export type EventType = (typeof EVENT_TYPES)[number]

export const PRIMARY_OBJECT: Record<EventType, ObjectType> = {
<%= for e <- Enum.sort_by(event_types, &String.to_integer(to_string(&1["order"]))) do %>  <%= e["name"] %>: "<%= e["primaryObject"] %>",
<% end %>}

export const QUALIFIERS: ReadonlyArray<{ event: EventType; object: ObjectType; qualifier: string }> = [
<%= for q <- Enum.sort_by(qualifiers, &{&1["event"], &1["object"]}) do %>  { event: "<%= q["event"] %>", object: "<%= q["object"] %>", qualifier: "<%= q["qualifier"] %>" },
<% end %>]

export const TRANSITIONS: Record<EventType, { from: string; to: string }> = {
<%= for t <- Enum.sort_by(transitions, & &1["event"]) do %>  <%= t["event"] %>: { from: "<%= t["fromState"] %>", to: "<%= t["toState"] %>" },
<% end %>}
