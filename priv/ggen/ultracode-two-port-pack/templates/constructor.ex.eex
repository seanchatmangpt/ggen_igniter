---
to: "<%= lib_path %>/constructor.ex"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.Constructor do
  @moduledoc """
  The golden path of `<%= agent_name %>` -- the only flow it has:

      sJira work -> bind exact subject -> SA2A resolve -> SA2A invoke
        -> local CONSTRUCT -> verify -> receipt -> sJira transition

  Every step emits one OCEL 2.0 event (`work_received`,
  `capability_requested`, `capability_resolved`, `capability_invoked`,
  `construction_started`, `construction_completed`,
  `verification_completed`, `receipt_recorded`, `work_updated`) relating
  the objects Work, Agent, Capability, Subject, Artifact and Receipt. A
  refusal emits `refused` and stops: a failed SA2A resolution is never
  permission to bypass SA2A, and a stale subject is never acted on.
  """

  alias <%= module_prefix %>.Capabilities
  alias <%= module_prefix %>.Local
  alias <%= module_prefix %>.Work

  @agent "<%= agent_name %>"

  @doc """
  Run one work order end to end.

    * `capability` -- the SA2A capability the work requires (id or name)
    * `construct` -- `fn %{subject:, invocation:, cwd:} -> {:ok, [artifact]} | {:error, _}`,
      where each artifact is `Local.write_artifact/3`'s map
    * `verify` -- `fn artifacts -> verification_map` (court/acceptance/falsifier
      results for the work order); must be pure over local state

  The receipt binds the base head AND the final head after construction
  (construction may commit locally; the final head must descend from the
  base). Options: `:cwd` (required git workspace), `:input` (capability input map),
  `:authority` (caller identity for a state-changing capability), `:target`
  (SA2A resource override), `:standing` (target standing, default
  `"PARTIAL_ALIVE"`), `:ocel` (path; events appended as NDJSON).
  """
  @spec run(map(), String.t(), function(), function(), keyword()) ::
          {:ok, map()} | {:error, term(), [map()]}
  def run(work_order, capability, construct, verify, opts) do
    cwd = Keyword.fetch!(opts, :cwd)
    events = []

    with {:ok, work} <- Work.get(work_order),
         events = emit(events, "work_received", work, [], opts),
         {:ok, head} <- Local.head(cwd),
         :ok <- Work.bind(work, head),
         events = emit(events, "capability_requested", work, [cap(capability)], opts),
         {:ok, resolution} <- Capabilities.resolve(%{capability: capability, subject: work.subject}, opts),
         events = emit(events, "capability_resolved", work, [cap(resolution["capability"])], opts),
         {:ok, invocation} <- Capabilities.invoke(resolution, Keyword.get(opts, :input, %{}), opts),
         :ok <- sa2a_bound(work, invocation),
         events = emit(events, "capability_invoked", work, [cap(resolution["capability"])], opts),
         events = emit(events, "construction_started", work, [], opts),
         {:ok, artifacts} <- construct.(%{subject: work.subject, invocation: invocation, cwd: cwd}),
         events = emit(events, "construction_completed", work, artifact_objects(artifacts), opts),
         verification = verify.(artifacts),
         events = emit(events, "verification_completed", work, artifact_objects(artifacts), opts),
         {:ok, final_head} <- Local.head(cwd),
         :ok <- descends(cwd, head, final_head),
         receipt =
           Work.record_evidence(work, %{
             "agent" => @agent,
             "capability" => resolution["capability"],
             "resolution_digest" => resolution["resolution_digest"],
             "sa2a_receipt" => invocation["sa2a_receipt"],
             "artifacts" => artifacts,
             "base_head" => head,
             "final_head" => final_head
           }),
         events = emit(events, "receipt_recorded", work, [receipt_object(receipt)], opts),
         {:ok, transition} <-
           Work.update(
             work,
             Keyword.get(opts, :standing, "PARTIAL_ALIVE"),
             verification,
             receipt,
             final_head
           ),
         events = emit(events, "work_updated", work, [receipt_object(receipt)], opts) do
      {:ok,
       %{
         work: work,
         resolution: resolution,
         invocation: invocation,
         artifacts: artifacts,
         receipt: receipt,
         transition: transition,
         events: Enum.reverse(events)
       }}
    else
      {:error, reason} -> {:error, reason, refused(work_order, reason, opts)}
      other -> {:error, {:unexpected, other}, refused(work_order, other, opts)}
    end
  end

  # The subject SA2A actually recorded, not the agent's own copy of it: a
  # state-changing invocation returns the CommandBus receipt's semantic
  # subject, whose graph digest must be this work's snapshot digest.
  defp sa2a_bound(work, invocation) do
    cond do
      not Work.same_subject?(work, invocation["subject"]) ->
        {:error, :subject_drift}

      is_nil(invocation["sa2a_receipt"]) ->
        :ok

      invocation["sa2a_receipt"]["graph_digest"] == work.subject["work_order_digest"] ->
        :ok

      true ->
        {:error, :sa2a_subject_drift}
    end
  end

  # Construction may commit locally; the final head must still descend from
  # the exact base the work names (never a rewrite, never an unrelated head).
  defp descends(_cwd, head, head), do: :ok

  defp descends(cwd, base, final_head) do
    case Local.git("merge-base", ["--is-ancestor", base, final_head], cwd) do
      {:ok, _} -> :ok
      {:error, _} -> {:error, :head_not_descended_from_subject}
    end
  end

  # ── OCEL 2.0 evidence ────────────────────────────────────────────────────

  defp emit(events, type, work, objects, opts) do
    subject = work.subject

    event = %{
      "id" => "#{subject["work_order_id"]}:#{length(events) + 1}:#{type}",
      "type" => type,
      "time" => DateTime.utc_now() |> DateTime.to_iso8601(),
      "attributes" => [%{"name" => "authority", "value" => "NONE"}],
      "relationships" =>
        [
          %{"objectId" => "work:" <> subject["work_order_id"], "qualifier" => "work"},
          %{"objectId" => "agent:" <> @agent, "qualifier" => "agent"},
          %{
            "objectId" => "subject:#{subject["repository"]}@#{subject["base_sha"]}",
            "qualifier" => "subject"
          }
        ] ++ objects
    }

    append(event, opts)
    [event | events]
  end

  defp refused(work_order, reason, opts) do
    event = %{
      "id" => "#{inspect(Map.get(work_order, "identity"))}:refused",
      "type" => "refused",
      "time" => DateTime.utc_now() |> DateTime.to_iso8601(),
      "attributes" => [%{"name" => "reason", "value" => inspect(reason)}],
      "relationships" => [%{"objectId" => "agent:" <> @agent, "qualifier" => "agent"}]
    }

    append(event, opts)
    [event]
  end

  defp append(event, opts) do
    case Keyword.get(opts, :ocel) do
      nil -> :ok
      path -> File.write!(path, Jason.encode!(event) <> "\n", [:append])
    end
  end

  defp cap(id), do: %{"objectId" => "capability:#{id}", "qualifier" => "capability"}

  defp artifact_objects(artifacts) when is_list(artifacts),
    do: Enum.map(artifacts, &%{"objectId" => "artifact:" <> &1["sha256"], "qualifier" => "artifact"})

  defp receipt_object(receipt),
    do: %{"objectId" => "receipt:" <> receipt["digest"], "qualifier" => "receipt"}
end
