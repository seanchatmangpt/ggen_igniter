---
to: "<%= lib_path %>/local.ex"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.Local do
  @moduledoc """
  The local, bounded CONSTRUCTION runtime of `<%= agent_name %>`: the ONLY
  module of this agent allowed to reach the OS (the firewall refuses a shell
  or port edge from any other agent module).

  Local git is artifact/version control only. Allowed verbs:
  `<%= Enum.map_join(git_verbs, " ", & &1["verb"]) %>`. Anything else -- in
  particular `push`/`fetch`/`pull` -- is not a local primitive: it is a
  consequential external actuation and must route through SA2A with
  authority (`<%= Enum.map_join(actuations, ", ", & &1["capability_name"]) %>`).
  """

  @git_verbs ~w(<%= Enum.map_join(git_verbs, " ", & &1["verb"]) %>)

  @doc "Local git verbs this agent may run."
  @spec git_verbs() :: [String.t()]
  def git_verbs, do: @git_verbs

  @doc "Run one allowed local git verb in `cwd`."
  @spec git(String.t() | atom(), [String.t()], Path.t()) ::
          {:ok, String.t()} | {:error, term()}
  def git(verb, args, cwd) when is_list(args) do
    verb = to_string(verb)

    cond do
      verb not in @git_verbs ->
        {:error, {:not_a_local_primitive, verb, route: :sa2a}}

      Enum.any?(args, &String.starts_with?(&1, ["-c", "-C", "--git-dir", "--work-tree", "--exec", "--remote", "--upload-pack", "--receive-pack", "--ext-diff", "--textconv"])) ->
        {:error, {:not_a_local_primitive, verb, reason: :workspace_override}}

      true ->
        case System.cmd("git", ["-C", cwd, verb | args], stderr_to_stdout: true) do
          {out, 0} -> {:ok, out}
          {out, status} -> {:error, {:git_failed, status, out}}
        end
    end
  end

  @doc "The exact local HEAD of the workspace at `cwd`."
  @spec head(Path.t()) :: {:ok, String.t()} | {:error, term()}
  def head(cwd) do
    with {:ok, out} <- git("rev-parse", ["HEAD"], cwd), do: {:ok, String.trim(out)}
  end

  @doc "Write one construction artifact inside `cwd` (never outside it)."
  @spec write_artifact(Path.t(), Path.t(), iodata()) :: {:ok, map()} | {:error, term()}
  def write_artifact(cwd, relative, content) do
    root = Path.expand(cwd)
    path = Path.expand(relative, root)

    if path == root or not String.starts_with?(path, root <> "/") do
      {:error, {:path_escape, relative}}
    else
      File.mkdir_p!(Path.dirname(path))
      File.write!(path, content)
      bytes = IO.iodata_to_binary(content)

      {:ok,
       %{
         "path" => Path.relative_to(path, root),
         "sha256" => Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
       }}
    end
  end

  @doc "Local compile of the Mix project at `cwd`."
  @spec compile(Path.t()) :: {:ok, String.t()} | {:error, term()}
  def compile(cwd), do: mix(["compile", "--warnings-as-errors"], cwd)

  @doc "Local test run of the Mix project at `cwd`."
  @spec test(Path.t(), [String.t()]) :: {:ok, String.t()} | {:error, term()}
  def test(cwd, args \\ []), do: mix(["test" | args], cwd)

  defp mix(args, cwd) do
    case System.cmd("mix", args, cd: cwd, stderr_to_stdout: true) do
      {out, 0} -> {:ok, out}
      {out, status} -> {:error, {:mix_failed, status, out}}
    end
  end
end
