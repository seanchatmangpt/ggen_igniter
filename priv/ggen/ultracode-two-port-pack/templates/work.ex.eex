---
to: "<%= lib_path %>/work.ex"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.Work do
  @moduledoc """
  Port A -- the semantic WORK plane (sJira) of `<%= agent_name %>`.

  The agent receives, binds, evidences and transitions work ONLY here, and
  only as semantic maps: no tracker field ids, no transition ids, no vendor
  JSON. Every function grants `authority: "NONE"`; a transition is an
  append-only event manufactured from an admitted promotion intent, never a
  remote write.
  """

  alias GgenIgniter.SemanticA2A
  alias GgenIgniter.SemanticJira

  @subject_keys ~w(work_order_id repository base_sha subject work_order_digest)

  @doc """
  Admit one semantic work order. Returns the admitted work and its exact
  subject binding (`work_order_id`, `repository`, `base_sha`, `subject`,
  `work_order_digest`).
  """
  @spec get(map()) :: {:ok, %{work: map(), subject: map()}} | {:error, term()}
  def get(work_order) when is_map(work_order) do
    case SemanticJira.admit_work_order(work_order) do
      {:ok, admitted} -> {:ok, %{work: admitted, subject: subject_of(admitted)}}
      {:error, reason} -> {:error, {:work_refused, reason}}
    end
  end

  def get(_), do: {:error, {:work_refused, :expected_map}}

  @doc "The exact subject a work order binds."
  @spec subject_of(map()) :: map()
  def subject_of(admitted) do
    %{
      "work_order_id" => admitted["identity"],
      "repository" => admitted["repository"],
      "base_sha" => admitted["base_sha"],
      "subject" => admitted["subject"],
      "work_order_digest" => admitted["work_order_digest"]
    }
  end

  @doc """
  Bind the work's exact subject to the observed local head. Work that names
  `base_sha` X is never acted on at head Y.
  """
  @spec bind(%{subject: map()}, String.t()) :: :ok | {:error, :stale_subject}
  def bind(%{subject: %{"base_sha" => base_sha}}, observed_head) when is_binary(observed_head) do
    if String.trim(observed_head) == base_sha, do: :ok, else: {:error, :stale_subject}
  end

  @doc "True when `subject` is exactly the work's subject binding."
  @spec same_subject?(%{subject: map()}, map()) :: boolean()
  def same_subject?(%{subject: bound}, subject) when is_map(subject),
    do: Map.take(subject, @subject_keys) == bound

  def same_subject?(_, _), do: false

  @doc """
  Record evidence for the work: a chained sha256 receipt whose subject embeds
  the exact work subject. `prev` is the previous receipt digest (or nil).
  """
  @spec record_evidence(%{subject: map()}, map(), String.t() | nil, keyword()) :: map()
  def record_evidence(%{subject: subject}, evidence, prev \\ nil, opts \\ []) when is_map(evidence) do
    SemanticA2A.receipt(
      Map.merge(evidence, %{"work_subject" => subject}),
      prev,
      class: Keyword.get(opts, :class, "verification")
    )
  end

  @doc "Replay a receipt chain recorded against this work."
  @spec verify_evidence([map()]) :: :ok | {:error, term()}
  def verify_evidence(chain), do: SemanticA2A.verify_chain(chain)

  @doc """
  Transition the work to `target` standing on `verification` evidence bound
  to the receipt `receipt` at the exact `final_head`. Returns the append-only
  `standing_transition_event` (authority NONE); persisting it is the work
  plane's log, not this agent's concern.

  The receipt must be genuine (its digest re-derives), must embed THIS work's
  exact subject, and must name `final_head` -- a receipt recorded for other
  work, a fabricated one, or one for a different head is refused
  `:receipt_not_bound` before sJira is asked for anything.
  """
  @spec update(%{work: map(), subject: map()}, String.t(), map(), map(), String.t()) ::
          {:ok, map()} | {:error, term()}
  def update(%{work: work, subject: subject}, target, verification, receipt, final_head)
      when is_map(verification) and is_map(receipt) and is_binary(final_head) do
    final_head = String.trim(final_head)

    if bound?(receipt, subject, final_head) do
      transition(work, subject, target, verification, receipt, final_head)
    else
      {:error, {:work_update_refused, :receipt_not_bound}}
    end
  end

  def update(_work, _target, _verification, _receipt, _final_head),
    do: {:error, {:work_update_refused, :receipt_not_bound}}

  defp bound?(receipt, subject, final_head) do
    SemanticA2A.valid_receipt?(receipt) and
      get_in(receipt, ["subject", "work_subject"]) == subject and
      get_in(receipt, ["subject", "final_head"]) == final_head
  end

  defp transition(work, subject, target, verification, receipt, final_head) do
    evidence =
      Map.merge(verification, %{
        "work_order_digest" => subject["work_order_digest"],
        "subject" => subject["subject"],
        "repository" => subject["repository"],
        "base_sha" => subject["base_sha"],
        "receipt_classes" => [receipt["class"]],
        "inherited_standing" => false
      })

    with {:ok, intent} <- SemanticJira.promote(work, target, evidence),
         {:ok, event} <-
           SemanticJira.apply_transition(work, %{
             "intent" => intent,
             "evidence_identity" => receipt["digest"],
             "final_head" => final_head
           }) do
      {:ok, event}
    else
      {:error, reason} -> {:error, {:work_update_refused, reason}}
    end
  end
end
