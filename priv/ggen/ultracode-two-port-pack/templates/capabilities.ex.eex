---
to: "<%= lib_path %>/capabilities.ex"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.Capabilities do
  @moduledoc """
  Port B -- the CAPABILITY plane (SA2A) of `<%= agent_name %>`.

  The agent asks for a capability (`"I require C with constraints K for
  subject S"`), never for a provider or an endpoint. Resolution is
  deterministic over SA2A's released capability index of
  `<%= sa2a_target %>`; which provider fulfils a capability is decided
  below this port.

  Law, in types:

    * `resolve/2` SELECTs; it never authorizes. A resolution carries
      `"authority" => "NONE"`.
    * `invoke/3` of a `:change`/`:external_do` capability requires an
      explicit authority identity admitted by `AshA2A.Authority.Grant`.
    * A consequential actuation (<%= Enum.map_join(actuations, ", ", & &1["capability_name"]) %>)
      is refused `:unauthorized` before resolution without authority.
    * Failure is one of `failures/0`; provider internals never leak, and a
      failure is never permission to bypass SA2A.
  """

  @default_target <%= sa2a_target %>
  @actuations ~w(<%= Enum.map_join(actuations, " ", & &1["capability_name"]) %>)
  @failures [
    :no_capability,
    :ambiguous_capability,
    :unauthorized,
    :provider_unavailable,
    :invalid_requirement,
    :invocation_refused
  ]

  @doc "The closed set of typed capability failures."
  @spec failures() :: [atom()]
  def failures, do: @failures

  @doc "Capabilities that are consequential actuation (DO) and always need authority."
  @spec actuations() :: [String.t()]
  def actuations, do: @actuations

  @doc "The SA2A resource-or-domain this agent resolves against."
  @spec target() :: module()
  def target, do: Application.get_env(:<%= otp_app %>, :sa2a_target, @default_target)

  @doc """
  Resolve `%{capability: id_or_name, subject: subject, constraints: map}`.

  `subject` must carry the exact work subject (`work_order_id`, `repository`,
  40-hex `base_sha`); the resolution carries it forward unchanged.
  """
  @spec resolve(map(), keyword()) :: {:ok, map()} | {:error, atom()}
  def resolve(requirement, opts \\ [])

  def resolve(%{capability: capability, subject: %{} = subject} = requirement, opts)
      when is_binary(capability) and capability != "" do
    with :ok <- subject_complete(subject),
         :ok <- actuation_gate(capability, opts),
         {:ok, index} <- index(Keyword.get(opts, :target, target())) do
      case Enum.filter(index, &matches?(&1, capability)) do
        [] ->
          {:error, :no_capability}

        [skill] ->
          {:ok, resolution(skill, subject, Map.get(requirement, :constraints, %{}), opts)}

        [_, _ | _] ->
          {:error, :ambiguous_capability}
      end
    end
  end

  def resolve(_requirement, _opts), do: {:error, :invalid_requirement}

  @doc """
  Invoke a resolved capability with `input`. Returns the typed result bound to
  the resolution's subject. `opts[:authority]` is the caller identity; it is
  required (and checked against SA2A grants) for any capability that changes
  state.
  """
  @spec invoke(map(), map(), keyword()) :: {:ok, map()} | {:error, atom()}
  def invoke(resolution, input, opts \\ [])

  def invoke(%{"skill" => name, "capability" => id} = resolution, input, opts) when is_map(input) do
    target = Keyword.get(opts, :target, target())
    identity = Keyword.get(opts, :authority)

    with :ok <- genuine(resolution, target),
         {:ok, skill} <- lookup(target, name),
         :ok <- authority(resolution["requires_authority"], identity, id) do
      message = A2A.Message.new_user([A2A.Part.Data.new(input)])

      case execute(skill, resolution, message, input, target, identity) do
        {:reply, parts, receipt} ->
          {:ok,
           %{
             "capability" => id,
             "subject" => resolution["subject"],
             "result" => Enum.map(parts, &part_data/1),
             "sa2a_receipt" => receipt
           }}

        {:error, reason} ->
          {:error, classify(reason)}

        _other ->
          {:error, :invocation_refused}
      end
    end
  end

  def invoke(_resolution, _input, _opts), do: {:error, :invalid_requirement}

  # ── internals ───────────────────────────────────────────────────────────

  defp subject_complete(%{"work_order_id" => id, "repository" => repo, "base_sha" => sha})
       when is_binary(id) and is_binary(repo) and is_binary(sha) do
    if Regex.match?(~r/\A[0-9a-f]{40}\z/, sha), do: :ok, else: {:error, :invalid_requirement}
  end

  defp subject_complete(_), do: {:error, :invalid_requirement}

  # A resolution is data the caller holds: it is honoured only if it still
  # re-derives its own digest, names a complete subject, and was resolved
  # against the same SA2A target it is invoked on.
  defp genuine(resolution, target) do
    body = Map.delete(resolution, "resolution_digest")

    with :ok <- subject_complete(resolution["subject"]) do
      if digest(body) == resolution["resolution_digest"] and body["target"] == inspect(target),
        do: :ok,
        else: {:error, :invalid_requirement}
    end
  end

  defp actuation_gate(capability, opts) do
    if capability in @actuations and is_nil(Keyword.get(opts, :authority)),
      do: {:error, :unauthorized},
      else: :ok
  end

  defp index(target) do
    case AshA2A.Info.capability_index(target) do
      index when is_list(index) -> {:ok, index}
      _ -> {:error, :provider_unavailable}
    end
  rescue
    _ -> {:error, :provider_unavailable}
  end

  defp matches?(skill, capability),
    do: skill.id == capability or to_string(skill.name) == capability

  defp lookup(target, name) do
    case AshA2A.Info.skill(target, name) do
      {:ok, skill} -> {:ok, skill}
      _ -> {:error, :no_capability}
    end
  rescue
    _ -> {:error, :provider_unavailable}
  end

  defp resolution(skill, subject, constraints, opts) do
    body = %{
      "port" => "sa2a",
      "capability" => skill.id,
      "skill" => to_string(skill.name),
      "consequence" => to_string(skill.consequence),
      "requires_authority" => skill.consequence in [:change, :external_do],
      "subject" => subject,
      "constraints" => constraints,
      "target" => inspect(Keyword.get(opts, :target, target())),
      "authority" => "NONE"
    }

    Map.put(body, "resolution_digest", digest(body))
  end

  defp authority(true, nil, _id), do: {:error, :unauthorized}

  defp authority(true, identity, id) do
    case AshA2A.Authority.Grant.authorize(identity, id) do
      nil -> {:error, :unauthorized}
      _authority -> :ok
    end
  end

  defp authority(_, _identity, _id), do: :ok

  # :observe -> AshA2A.Dispatcher. :change/:external_do -> AshA2A.CommandBus,
  # the BRCE route: a receipted, authority-admitted command whose semantic
  # subject is this work's exact subject. Resolution never reaches here
  # without `authority/3` having admitted the caller.
  defp execute(%{consequence: :observe} = skill, _resolution, message, _input, target, identity) do
    case AshA2A.Dispatcher.dispatch(skill.name, message, target, [], identity) do
      {:reply, parts} -> {:reply, parts, nil}
      other -> other
    end
  rescue
    _ -> {:error, :provider_unavailable}
  end

  defp execute(skill, resolution, message, input, target, identity) do
    with {:ok, subject} <- semantic_subject(resolution) do
      command =
        AshA2A.Command.new(skill.id,
          command_id: message.message_id,
          agent_id: "<%= agent_name %>",
          principal_id: AshA2A.Identity.principal(identity),
          authority: AshA2A.Authority.Grant.authorize(identity, skill.id),
          semantic_subject: subject,
          input: input
        )

      case AshA2A.CommandBus.run(command, message, target, auth_identity: identity) do
        {:ok, receipt} ->
          case receipt.reply do
            {:reply, parts} -> {:reply, parts, sa2a_receipt(receipt)}
            {:error, reason} -> {:error, reason}
            _ -> {:error, :invocation_refused}
          end

        {:error, %{code: code}} ->
          {:error, code}

        {:error, reason} ->
          {:error, reason}
      end
    end
  rescue
    _ -> {:error, :provider_unavailable}
  end

  # The exact work subject, carried INTO the SA2A command so its receipt is
  # bound to it: graph = work-order snapshot, projection = this resolution,
  # manufacturer = (agent, repository, base_sha).
  defp semantic_subject(%{"subject" => subject} = resolution) do
    AshA2A.SemanticSubject.new(
      graph_digest: subject["work_order_digest"] || digest(subject),
      projection_digest: resolution["resolution_digest"],
      manufacturer_digest:
        digest({"<%= agent_name %>", subject["repository"], subject["base_sha"]})
    )
  end

  defp sa2a_receipt(receipt) do
    %{
      "receipt_id" => to_string(receipt.receipt_id && receipt.receipt_id.value),
      "capability_id" => receipt.capability_id,
      "status" => to_string(receipt.status),
      "graph_digest" => receipt.semantic_subject && receipt.semantic_subject.graph_digest,
      "manufacturer_digest" => receipt.semantic_subject && receipt.semantic_subject.manufacturer_digest
    }
  end

  defp part_data(%{data: data}), do: data
  defp part_data(%{text: text}), do: text
  defp part_data(_), do: nil

  defp classify({:unknown_skill, _}), do: :no_capability
  defp classify({:ambiguous_skill, _}), do: :ambiguous_capability
  defp classify(:provider_unavailable), do: :provider_unavailable
  defp classify(reason)
       when reason in [:forbidden, :authority_required, :authority_mismatch, :model_authority_refused],
       do: :unauthorized

  defp classify(:capability_not_found), do: :no_capability

  defp classify(_reason), do: :invocation_refused

  defp digest(term) do
    "sha256:" <>
      Base.encode16(:crypto.hash(:sha256, :erlang.term_to_binary(term, [:deterministic])),
        case: :lower
      )
  end
end
