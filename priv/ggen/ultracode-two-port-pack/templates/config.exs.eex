---
to: "config/ultracode_ports_<%= agent_name %>.exs"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
# Import from config/config.exs: `import_config "ultracode_ports_<%= agent_name %>.exs"`.
import Config

config :<%= otp_app %>,
  allowed_external_semantic_ports: [:sa2a, :sjira],
  sa2a_target: <%= sa2a_target %>
