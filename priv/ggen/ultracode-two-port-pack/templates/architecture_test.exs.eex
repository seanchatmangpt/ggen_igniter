---
to: "test/<%= otp_app %>/<%= agent_name %>_architecture_test.exs"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.ArchitectureTest do
  @moduledoc """
  The two-port law, executed over this application's compiled agent modules:
  `ExternalSemanticPorts(<%= agent_name %>) ⊆ {SA2A, sJira}`. A failure names
  the forbidden edge (`{:forbidden_direct_edge, from, to, expected}`).
  """
  use ExUnit.Case, async: true

  test "the agent's external semantic dependencies are within {SA2A, sJira}" do
    assert {:ok, census} = <%= module_prefix %>.Firewall.check_app(:<%= otp_app %>)
    assert census.ports -- [:sa2a, :sjira] == []
    assert <%= module_prefix %>.World.external_semantic_ports() == [:sa2a, :sjira]
  end
end
