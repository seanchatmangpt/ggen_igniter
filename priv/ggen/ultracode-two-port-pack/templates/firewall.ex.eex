---
to: "<%= lib_path %>/firewall.ex"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %><%
  policy = fn kind -> for r <- runtime_policy, r["policy_kind"] == kind, do: r["policy_value"] end
  ports = port_prefixes |> Enum.group_by(& &1["port_key"], & &1["port_prefix"]) |> Enum.sort()
%># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.Firewall do
  @moduledoc """
  Executable two-port law for `<%= agent_name %>`:

      external_semantic_dependencies(agent) ⊆ {SA2A, sJira}

  Reads the COMPILED code of every agent module (the BEAM's Erlang abstract
  code, via `:beam_lib` -- not source text) and classifies every
  remote call and remote function reference it contains:

    * `:internal` -- another module under `<%= module_prefix %>`
    * `{:port, key}` -- a sanctioned port prefix (<%= Enum.map_join(ports, "; ", fn {k, ps} -> "#{k}: #{Enum.join(ps, ", ")}" end) %>)
    * `{:runtime, app}` -- a local runtime app (<%= Enum.join(policy.("runtime_app"), ", ") %>)
    * everything else is REFUSED (default-deny), and so is a forbidden
      module (<%= Enum.join(policy.("forbidden_module"), ", ") %>), a shell/port edge
      (<%= Enum.join(policy.("shell_function"), ", ") %>) from any module other than
      `<%= module_prefix %>.<%= hd(policy.("shell_boundary")) %>`, and any dynamic dispatch
      (a call whose module or function is not a literal), which would
      otherwise hide an edge from this check.
  """

  @prefix "<%= module_prefix %>"
  @shell_boundary <%= module_prefix %>.<%= hd(policy.("shell_boundary")) %>
  @ports %{<%= Enum.map_join(ports, ", ", fn {k, ps} -> "#{k}: ~w(#{Enum.join(ps, " ")})" end) %>}
  @runtime_apps ~w(<%= Enum.join(policy.("runtime_app"), " ") %>)a
  @forbidden ~w(<%= Enum.join(policy.("forbidden_module"), " ") %>)
  # Calls that take a module/function as DATA, load native code, or send a
  # message to another process hide the real edge from this check.
  @dynamic (for a <- 1..4, do: {:erlang, :apply, a}) ++
             (for f <- [:spawn, :spawn_link, :spawn_monitor, :spawn_opt], a <- 2..5, do: {:erlang, f, a}) ++
             [
               {:erlang, :make_fun, 3},
               {:erlang, :load_nif, 2},
               {:erlang, :send, 2},
               {:erlang, :send, 3},
               {:erlang, :send_after, 3},
               {:erlang, :send_after, 4},
               {:erlang, :send_nosuspend, 2},
               {:erlang, :send_nosuspend, 3},
               {:timer, :apply_after, 4},
               {:timer, :apply_interval, 4},
               {:timer, :apply_repeatedly, 4},
               {:erlang, :hibernate, 3},
               {Function, :capture, 3},
               {Kernel, :apply, 2},
               {Kernel, :apply, 3},
               {Task, :async, 3},
               {Task, :start, 3},
               {Task, :start_link, 3}
             ]
  @shell ~w(<%= Enum.join(policy.("shell_function"), " ") %>)

  @type edge :: {module(), module(), atom(), non_neg_integer() | :dynamic}
  @type violation ::
          {:forbidden_direct_edge, module(), module(), String.t()}
          | {:forbidden_shell_edge, module(), String.t()}
          | {:dynamic_dispatch, module()}
          | {:no_debug_info, module()}

  @doc "The module prefix this firewall guards."
  @spec prefix() :: String.t()
  def prefix, do: @prefix

  @doc """
  Check `beams` (a list of `{module, beam_binary}`) against the two-port law.

  Returns `{:ok, census}` -- `%{ports: [key], runtime: [app], modules: [module]}`,
  where `ports` IS `ExternalSemanticPorts(agent)` -- or `{:error, violations}`.
  """
  @spec check([{module(), binary()}]) :: {:ok, map()} | {:error, [violation()]}
  def check(beams) when is_list(beams) do
    checked = for {module, _} <- beams, guarded?(module), into: MapSet.new(), do: module

    {classified, violations} =
      beams
      |> Enum.filter(fn {module, _} -> guarded?(module) end)
      |> Enum.flat_map(&edges/1)
      |> Enum.map(&classify(&1, checked))
      |> Enum.split_with(&match?({:ok, _}, &1))

    case violations do
      [] ->
        kinds = Enum.map(classified, fn {:ok, kind} -> kind end)

        {:ok,
         %{
           ports: kinds |> Enum.flat_map(&port_key/1) |> Enum.uniq() |> Enum.sort(),
           runtime: kinds |> Enum.flat_map(&runtime_app/1) |> Enum.uniq() |> Enum.sort(),
           modules: beams |> Enum.map(&elem(&1, 0)) |> Enum.filter(&guarded?/1) |> Enum.sort()
         }}

      _ ->
        {:error, violations |> Enum.map(fn {:error, v} -> v end) |> Enum.uniq()}
    end
  end

  @doc """
  Check the compiled `.beam` files of OTP application `app` under the guarded
  prefix -- the artifacts on disk, not whatever happens to be loaded.
  """
  @spec check_app(atom()) :: {:ok, map()} | {:error, [violation()]}
  def check_app(app) do
    {:ok, modules} = :application.get_key(app, :modules)

    modules
    |> Enum.filter(&guarded?/1)
    |> Enum.map(fn module ->
      {module, File.read!(Application.app_dir(app, "ebin/#{module}.beam"))}
    end)
    |> check()
  end

  @doc "Every remote edge in one BEAM, as `{from, to, fun, arity | :dynamic}`."
  @spec edges({module(), binary()}) :: [edge() | {:error, violation()}]
  def edges({module, binary}) do
    case :beam_lib.chunks(binary, [:abstract_code]) do
      {:ok, {^module, [abstract_code: {:raw_abstract_v1, forms}]}} ->
        forms |> collect([]) |> Enum.map(&put_elem(&1, 0, module)) |> Enum.uniq()

      _ ->
        [{:error, {:no_debug_info, module}}]
    end
  end

  # ── classification ───────────────────────────────────────────────────────

  defp classify({:error, violation}, _checked), do: {:error, violation}
  defp classify({from, :dynamic, _fun, _arity}, _checked), do: {:error, {:dynamic_dispatch, from}}

  defp classify({from, to, fun, arity}, checked) do
    name = name(to)

    cond do
      # Internal only when the target is itself agent code under THIS check:
      # an agent-looking name that was not checked is an unproven module.
      MapSet.member?(checked, to) ->
        {:ok, :internal}

      guarded?(to) ->
        {:error, {:forbidden_direct_edge, from, to, "agent-named module outside the checked set"}}

      {to, fun, arity} in @dynamic ->
        {:error, {:dynamic_dispatch, from}}

      shell?(name, fun) and from != @shell_boundary ->
        {:error, {:forbidden_shell_edge, from, "#{name}.#{fun}/#{arity}"}}

      shell?(name, fun) ->
        {:ok, {:runtime, :shell_boundary}}

      forbidden?(name) ->
        {:error, {:forbidden_direct_edge, from, to, "route through SA2A or sJira"}}

      key = port(name) ->
        {:ok, {:port, key}}

      app = runtime(to) ->
        {:ok, {:runtime, app}}

      true ->
        {:error, {:forbidden_direct_edge, from, to, "not a sanctioned port or local runtime"}}
    end
  end

  defp port_key({:port, key}), do: [key]
  defp port_key(_), do: []
  defp runtime_app({:runtime, app}), do: [app]
  defp runtime_app(_), do: []

  # A module is agent code when it IS the prefix, lives under it, or is a
  # protocol implementation for one of its types (`Inspect.<prefix>.Payload`):
  # an impl module is named after the protocol, not after the agent.
  defp guarded?(module) when is_atom(module) do
    name = name(module)

    name == @prefix or String.starts_with?(name, @prefix <> ".") or
      String.contains?(name, "." <> @prefix <> ".") or String.ends_with?(name, "." <> @prefix)
  end

  defp name(module) when is_atom(module) do
    case Atom.to_string(module) do
      "Elixir." <> rest -> rest
      erlang -> ":" <> erlang
    end
  end

  defp prefixed?(name, prefix), do: name == prefix or String.starts_with?(name, prefix <> ".")

  defp forbidden?(name), do: Enum.any?(@forbidden, &prefixed?(name, &1))

  defp shell?(name, fun),
    do: Enum.any?(@shell, &(&1 == name or &1 == "#{name}.#{fun}" or prefixed?(name, &1)))

  defp port(name) do
    Enum.find_value(@ports, fn {key, prefixes} ->
      if Enum.any?(prefixes, &prefixed?(name, &1)), do: key
    end)
  end

  defp runtime(module) do
    case :application.get_application(module) do
      {:ok, app} -> if app in @runtime_apps, do: app
      :undefined -> preloaded(module)
    end
  end

  # Preloaded ERTS modules (:erlang, :init, ...) belong to no application.
  defp preloaded(module) do
    if module in :erlang.pre_loaded(), do: :erts
  end

  # ── abstract-code walk ──────────────────────────────────────────────────

  defp collect({:call, _, {:remote, _, {:atom, _, m}, {:atom, _, f}}, args}, acc),
    do: collect(args, [{nil, m, f, length(args)} | acc])

  defp collect({:call, _, {:remote, _, m, f}, args}, acc),
    do: collect([m, f | args], [{nil, :dynamic, nil, :dynamic} | acc])

  defp collect({:fun, _, {:function, {:atom, _, m}, {:atom, _, f}, {:integer, _, a}}}, acc),
    do: [{nil, m, f, a} | acc]

  defp collect({:fun, _, {:function, _m, _f, _a}}, acc),
    do: [{nil, :dynamic, nil, :dynamic} | acc]

  defp collect(tuple, acc) when is_tuple(tuple), do: tuple |> Tuple.to_list() |> collect(acc)
  defp collect([head | tail], acc), do: collect(tail, collect(head, acc))
  defp collect(_other, acc), do: acc
end
