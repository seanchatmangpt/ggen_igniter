---
to: "<%= lib_path %>/world.ex"
for_each: agents
---
<%= if violations != [], do: raise(ArgumentError, "REFUSED_TWO_PORT_TOPOLOGY: " <> Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]} (#{&1["violation_detail"]})")) %># GENERATED by ultracode-two-port-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: the agent declaration <%= agent_iri %> + priv/ggen/ultracode-two-port-pack/ontology.ttl.
defmodule <%= module_prefix %>.World do
  @moduledoc """
  The whole world of `<%= agent_name %>`, as the agent sees it.

      WORK         = sJira  -> `work/0`
      CAPABILITY   = SA2A   -> `capabilities/0`
      CONSTRUCTION = local bounded runtime -> `construction/0`
      DO           = separately authorized (never reachable from here)

  There is no third external semantic port. A capability the agent needs and
  cannot resolve through SA2A is a missing SA2A capability, never permission
  to integrate something directly.
  """

  @doc "The semantic work plane (sJira)."
  @spec work() :: module()
  def work, do: <%= module_prefix %>.Work

  @doc "The capability plane (SA2A)."
  @spec capabilities() :: module()
  def capabilities, do: <%= module_prefix %>.Capabilities

  @doc "The local, non-consequential construction runtime."
  @spec construction() :: module()
  def construction, do: <%= module_prefix %>.Local

  @doc "External semantic ports, by key. Always exactly `[:sa2a, :sjira]`."
  @spec external_semantic_ports() :: [atom()]
  def external_semantic_ports, do: [:sa2a, :sjira]
end
