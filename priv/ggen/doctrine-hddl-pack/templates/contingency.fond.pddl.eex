---
to: "docs/doctrine/contingency.fond.pddl"
mode: file
---
<%
# doctrine-hddl-pack: falsifiers of admitted strategies -> FOND PDDL domain.
# oneof is only ever the WHOLE effect of an observation action; there is no
# :constraints section. Authority NONE; ceiling CONSTRUCT.
refuse = fn reason -> raise ArgumentError, "REFUSED:DOCTRINE_HDDL: #{reason}" end

local = fn iri -> iri |> to_string() |> String.split(["#", "/"]) |> List.last() end

# Engine-agnostic numbers: the default oxigraph engine yields canonical
# lexical strings ("18", "0.35"); the sparql engine yields Decimal/integer.
to_int = fn
  i when is_integer(i) -> i
  s when is_binary(s) -> (case Integer.parse(s) do {i, ""} -> i; _ -> nil end)
  _ -> nil
end

threshold_text = fn t ->
  d =
    case t do
      %Decimal{} -> t
      i when is_integer(i) -> Decimal.new(i)
      f when is_float(f) -> Decimal.from_float(f)
      s when is_binary(s) -> (case Decimal.parse(s) do {d, ""} -> d; _ -> refuse.("threshold is not numeric: #{inspect(s)}") end)
      other -> refuse.("threshold is not numeric: #{inspect(other)}")
    end

  d |> Decimal.normalize() |> Decimal.to_string(:normal)
end

threshold_pred = fn property, comparator, threshold ->
  unless comparator in ~w(lt lte gt gte eq), do: refuse.("unknown comparator #{inspect(comparator)}")
  t = threshold |> threshold_text.() |> String.replace(".", "p") |> String.replace("-", "m")
  "#{local.(property)}-#{comparator}-#{t}"
end

admitted = MapSet.new(methods, & &1["strategy"])

if MapSet.size(admitted) == 0,
  do: refuse.("no sd:DoctrineApplicability is admitted; there is no commitment to falsify")

rows = Enum.filter(contingencies, &MapSet.member?(admitted, &1["strategy"]))

counters_by_strategy =
  rows
  |> Enum.filter(& &1["counter"])
  |> Enum.group_by(& &1["strategy"], &local.(&1["counter"]))
  |> Map.new(fn {s, cs} -> {s, cs |> Enum.uniq() |> Enum.sort()} end)

falsifiers =
  rows
  |> Enum.uniq_by(&{&1["strategy"], &1["falsifier"]})
  |> Enum.map(fn f ->
    window = to_int.(f["window"])

    unless is_integer(window) and window > 0,
      do: refuse.("#{local.(f["falsifier"])} needs a positive integer sd:windowDays")

    %{
      strategy: local.(f["strategy"]),
      name: local.(f["falsifier"]),
      window: window,
      refuting: threshold_pred.(f["property"], f["comparator"], f["threshold"]),
      counters: Map.get(counters_by_strategy, f["strategy"], [])
    }
  end)
  |> Enum.sort_by(& &1.name)

Enum.each(admitted, fn s ->
  unless Enum.any?(falsifiers, &(&1.strategy == local.(s))),
    do: refuse.("#{local.(s)} has no sd:hasFalsifier; an unfalsifiable commitment has no contingency")
end)

strategies = falsifiers |> Enum.map(& &1.strategy) |> Enum.uniq() |> Enum.sort()
counters = falsifiers |> Enum.flat_map(& &1.counters) |> Enum.uniq() |> Enum.sort()

predicates =
  Enum.map(strategies, &"committed-#{&1}") ++
    (falsifiers |> Enum.map(& &1.refuting) |> Enum.uniq() |> Enum.sort()) ++
    Enum.map(falsifiers, &"held-#{&1.name}") ++
    Enum.map(counters, &"suspect-counter-#{&1}") ++ ["replanning"]
%>;; Generated by ggen_igniter doctrine-hddl-pack. Authority NONE; ceiling CONSTRUCT.
;; One nondeterministic observation per falsifier of an admitted strategy; the
;; refuting outcome sets its numeric-threshold predicate, and a replan action
;; releases the commitment.
(define (domain strategic-doctrine-contingency)
  (:requirements :typing :negative-preconditions :non-deterministic)

  (:types actor)

  (:predicates<%= for p <- Enum.uniq(predicates) do %>
    (<%= p %> ?a - actor)<% end %>)
<%= for f <- falsifiers do %>
  ;; <%= f.name %>: evaluated within <%= f.window %> days of committing to <%= f.strategy %>
  (:action observe-<%= f.name %>
    :parameters (?a - actor)
    :precondition (and (committed-<%= f.strategy %> ?a) (not (held-<%= f.name %> ?a)) (not (<%= f.refuting %> ?a)))
    :effect (oneof
      (<%= f.refuting %> ?a)
      (held-<%= f.name %> ?a)))

  (:action replan-after-<%= f.name %>
    :parameters (?a - actor)
    :precondition (and (committed-<%= f.strategy %> ?a) (<%= f.refuting %> ?a))
    :effect (and (not (committed-<%= f.strategy %> ?a)) (replanning ?a)<%= for c <- f.counters do %> (suspect-counter-<%= c %> ?a)<% end %>))
<% end %>)
