---
to: "docs/doctrine/problem.hddl"
mode: file
---
<%
# doctrine-hddl-pack: world model -> HDDL problem. Authority NONE; ceiling CONSTRUCT.
refuse = fn reason -> raise ArgumentError, "REFUSED:DOCTRINE_HDDL: #{reason}" end

local = fn iri -> iri |> to_string() |> String.split(["#", "/"]) |> List.last() end

# Engine-agnostic numbers: the default oxigraph engine yields canonical
# lexical strings ("18", "0.35"); the sparql engine yields Decimal/integer.
threshold_text = fn t ->
  d =
    case t do
      %Decimal{} -> t
      i when is_integer(i) -> Decimal.new(i)
      f when is_float(f) -> Decimal.from_float(f)
      s when is_binary(s) -> (case Decimal.parse(s) do {d, ""} -> d; _ -> refuse.("threshold is not numeric: #{inspect(s)}") end)
      other -> refuse.("threshold is not numeric: #{inspect(other)}")
    end

  d |> Decimal.normalize() |> Decimal.to_string(:normal)
end

threshold_pred = fn property, comparator, threshold ->
  unless comparator in ~w(lt lte gt gte eq), do: refuse.("unknown comparator #{inspect(comparator)}")
  t = threshold |> threshold_text.() |> String.replace(".", "p") |> String.replace("-", "m")
  "#{local.(property)}-#{comparator}-#{t}"
end

if methods == [],
  do: refuse.("no sd:DoctrineApplicability is admitted; there is no task network to root")

# One root task per (actor, objective) of an ADMITTED applicability (gate 030).
roots =
  methods
  |> Enum.map(&{local.(&1["actor"]), local.(&1["objective"])})
  |> Enum.uniq()
  |> Enum.sort()

actors = roots |> Enum.map(&elem(&1, 0)) |> Enum.uniq()

# Init: every threshold predicate that HOLDS (gate 040) for an actor of the problem.
init =
  problem
  |> Enum.map(&{threshold_pred.(&1["property"], &1["comparator"], &1["threshold"]), local.(&1["actor"])})
  |> Enum.filter(fn {_p, a} -> a in actors end)
  |> Enum.uniq()
  |> Enum.sort()
%>;; Generated by ggen_igniter doctrine-hddl-pack. Authority NONE; ceiling CONSTRUCT.
(define (problem strategic-doctrine-<%= Enum.join(actors, "-") %>)
  (:domain strategic-doctrine)
  (:objects<%= for a <- actors do %> <%= a %><% end %> - actor)
  (:htn
    :parameters ()
    :ordered-subtasks (and<%= for {{actor, objective}, i} <- Enum.with_index(roots, 1) do %>
      (g<%= i %> (pursue-<%= objective %> <%= actor %>))<% end %>))
  (:init<%= for {p, a} <- init do %>
    (<%= p %> <%= a %>)<% end %>))
