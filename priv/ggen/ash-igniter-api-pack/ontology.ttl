@prefix aia:  <https://ggen-igniter.dev/ontology/ash-igniter-api#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Vocabulary
#
# Semantic facts about N Ash resources (each member links to its resource via
# aia:resourceOf) (attributes, actions, relationships,
# identities, calculations, policies). templates/api_task.ex.eex projects them
# into ONE Igniter.Mix.Task composing every resource (one `ash.gen.resource` call
# per resource, in aia:order) and then applies every other fact through the idempotent structural
# APIs of Ash.Resource.Igniter / Ash.Domain.Igniter (add_new_* checks
# existence by name before adding). The ontology stores no CLI strings and no
# Ash source; only names, types and flags.
#
# Consumer-side dev/test capability: the path contains "ash", so
# mix.exs shipped_packs/0 keeps it out of the hex package.
#################################################################

aia:Project a rdfs:Class .
aia:Resource a rdfs:Class .
aia:resourceOf a rdf:Property ;
    rdfs:comment "Links a member fact (attribute/action/relationship/identity/calculation/policy) to its aia:Resource." .
aia:Attribute a rdfs:Class .
aia:Action a rdfs:Class .
aia:Relationship a rdfs:Class .
aia:Identity a rdfs:Class .
aia:Calculation a rdfs:Class .
aia:Policy a rdfs:Class .

# ---- Surface facts (all optional; a resource without them renders exactly as before) ----
# Every class below hangs off an aia:Action (aia:actionOf) or an aia:Resource (aia:resourceOf);
# gates/000_violations.rq refuses dangling / incomplete / malformed instances (typed
# REFUSED_ASH_API_SURFACE, non-zero exit, nothing written).
aia:Argument a rdfs:Class ;
    rdfs:comment "actionOf, argumentName, argumentType, allowNil, order -> `argument :n, :type, allow_nil?: b`." .
aia:SetAttribute a rdfs:Class ;
    rdfs:comment "actionOf, attributeName, valueLiteral, valueType(string|integer|boolean|atom), order -> `change set_attribute(:a, v)`." .
aia:ManageRelationship a rdfs:Class ;
    rdfs:comment "actionOf, argumentName, relationshipName, manageType, order -> `change manage_relationship(:arg, :rel, type: t)`." .
aia:Validation a rdfs:Class ;
    rdfs:comment "actionOf, validationKind(present|match|compare), validationSubject, validationOption, validationValue, validationValueType, order." .
aia:Aggregate a rdfs:Class ;
    rdfs:comment "resourceOf, aggregateKind(count|sum|first|list|max|min|avg|exists), aggregateName, aggregateRelationship, aggregateField, aggregateFilter, aggregateSort, order (empty string = absent)." .
aia:CodeInterface a rdfs:Class ;
    rdfs:comment "resourceOf, interfaceName, interfaceAction, order -> domain `define :name, action: :a`." .
aia:PolicyRule a rdfs:Class ;
    rdfs:comment "resourceOf, ruleKind(policy|bypass), ruleCondition, order; its checks are aia:PolicyCheck (checkOf)." .
aia:PolicyCheck a rdfs:Class ;
    rdfs:comment "checkOf, checkKind(authorize_if|authorize_unless|forbid_if|forbid_unless), checkExpr, order." .
aia:FieldPolicy a rdfs:Class ;
    rdfs:comment "resourceOf, fieldNames (csv or *), order; its checks are aia:FieldCheck (fieldPolicyOf)." .
aia:FieldCheck a rdfs:Class ;
    rdfs:comment "fieldPolicyOf, checkKind, checkExpr, order." .
aia:PrimaryAction a rdfs:Class ;
    rdfs:comment "actionOf -> the action renders `primary? true`." .
aia:EnsurePrimary a rdfs:Class ;
    rdfs:comment "resourceOf, actionType -> Ash.Resource.Igniter.ensure_primary_action/3." .
aia:Pagination a rdfs:Class ;
    rdfs:comment "actionOf (a read), paginationOffset, paginationKeyset, defaultLimit, countable." .
aia:DefaultSort a rdfs:Class ;
    rdfs:comment "actionOf (a read), sortField, sortDirection, order -> `prepare build(sort: [f: :dir])`." .
aia:Multitenancy a rdfs:Class ;
    rdfs:comment "resourceOf, tenantStrategy(attribute|context), tenantAttribute (must be a declared attribute for :attribute)." .
aia:Timestamps a rdfs:Class ;
    rdfs:comment "resourceOf -> Ash.Resource.Igniter.ensure_timestamps/2." .
aia:Extension a rdfs:Class ;
    rdfs:comment "resourceOf, extensionName (ets|policy|Ash.Policy.Authorizer|...), order -> composed `ash.extend`." .

#################################################################
# Properties (declared from the aia: terms the gates/*.rq query)
# Properties shared across classes carry no rdfs:domain.
#################################################################

# ---- Shared across classes (no rdfs:domain) ----
aia:order a rdf:Property ;
    rdfs:comment "Rendering order of a member fact within its owner (1-based)." .
aia:isPublic a rdf:Property ;
    rdfs:comment "Whether the attribute/relationship is public (`public? b`)." .
aia:isRequired a rdf:Property ;
    rdfs:comment "Whether the attribute/relationship is required (`allow_nil? false`)." .
aia:actionType a rdf:Property ;
    rdfs:comment "Ash action type (create|update|read|destroy); on aia:Action and aia:EnsurePrimary." .
aia:actionOf a rdf:Property ;
    rdfs:comment "Links an action-scoped fact (argument, change, validation, pagination, sort, primary) to its aia:Action." .
aia:attributeName a rdf:Property ;
    rdfs:comment "Attribute name; on aia:Attribute and aia:SetAttribute." .
aia:argumentName a rdf:Property ;
    rdfs:comment "Action argument name; on aia:Argument and aia:ManageRelationship." .
aia:relationshipName a rdf:Property ;
    rdfs:comment "Relationship name; on aia:Relationship and aia:ManageRelationship." .
aia:checkKind a rdf:Property ;
    rdfs:comment "Check kind (authorize_if|authorize_unless|forbid_if|forbid_unless); on aia:PolicyCheck and aia:FieldCheck." .
aia:checkExpr a rdf:Property ;
    rdfs:comment "Check expression; on aia:PolicyCheck and aia:FieldCheck." .

# ---- aia:Project ----
aia:otpApp a rdf:Property ;
    rdfs:domain aia:Project ;
    rdfs:comment "OTP application name." .
aia:taskModule a rdf:Property ;
    rdfs:domain aia:Project ;
    rdfs:comment "Module name of the generated Mix task." .
aia:taskName a rdf:Property ;
    rdfs:domain aia:Project ;
    rdfs:comment "Mix task name of the generated task." .

# ---- aia:Resource ----
aia:resourceModule a rdf:Property ;
    rdfs:domain aia:Resource ;
    rdfs:comment "Fully qualified Ash resource module." .
aia:domainModule a rdf:Property ;
    rdfs:domain aia:Resource ;
    rdfs:comment "Fully qualified Ash domain module owning the resource." .

# ---- aia:Attribute ----
aia:attributeType a rdf:Property ;
    rdfs:domain aia:Attribute ;
    rdfs:comment "Ash type of the attribute." .

# ---- aia:Action ----
aia:actionName a rdf:Property ;
    rdfs:domain aia:Action ;
    rdfs:comment "Action name." .
aia:accepts a rdf:Property ;
    rdfs:domain aia:Action ;
    rdfs:comment "Comma-separated attribute names the action accepts." .

# ---- aia:Relationship ----
aia:relationshipKind a rdf:Property ;
    rdfs:domain aia:Relationship ;
    rdfs:comment "belongs_to|has_one|has_many|many_to_many." .
aia:destination a rdf:Property ;
    rdfs:domain aia:Relationship ;
    rdfs:comment "Destination resource module." .

# ---- aia:Policy ----
aia:policyCondition a rdf:Property ;
    rdfs:domain aia:Policy ;
    rdfs:comment "Policy condition expression." .
aia:policyBody a rdf:Property ;
    rdfs:domain aia:Policy ;
    rdfs:comment "Policy body (check line)." .

# ---- aia:Argument ----
aia:argumentType a rdf:Property ;
    rdfs:domain aia:Argument ;
    rdfs:comment "Ash type of the argument." .
aia:allowNil a rdf:Property ;
    rdfs:domain aia:Argument ;
    rdfs:comment "Whether the argument allows nil." .

# ---- aia:SetAttribute ----
aia:valueLiteral a rdf:Property ;
    rdfs:domain aia:SetAttribute ;
    rdfs:comment "Literal value text for set_attribute." .
aia:valueType a rdf:Property ;
    rdfs:domain aia:SetAttribute ;
    rdfs:comment "string|integer|boolean|atom." .

# ---- aia:ManageRelationship ----
aia:manageType a rdf:Property ;
    rdfs:domain aia:ManageRelationship ;
    rdfs:comment "manage_relationship type option (append|append_and_remove|direct_control|create|...)." .

# ---- aia:Validation ----
aia:validationKind a rdf:Property ;
    rdfs:domain aia:Validation ;
    rdfs:comment "present|match|compare." .
aia:validationSubject a rdf:Property ;
    rdfs:domain aia:Validation ;
    rdfs:comment "Attribute or argument the validation applies to." .
aia:validationOption a rdf:Property ;
    rdfs:domain aia:Validation ;
    rdfs:comment "Validation option key (e.g. greater_than, min)." .
aia:validationValue a rdf:Property ;
    rdfs:domain aia:Validation ;
    rdfs:comment "Validation option value text." .
aia:validationValueType a rdf:Property ;
    rdfs:domain aia:Validation ;
    rdfs:comment "Literal type of aia:validationValue." .

# ---- aia:Aggregate ----
aia:aggregateKind a rdf:Property ;
    rdfs:domain aia:Aggregate ;
    rdfs:comment "count|sum|first|list|max|min|avg|exists." .
aia:aggregateName a rdf:Property ;
    rdfs:domain aia:Aggregate ;
    rdfs:comment "Aggregate name." .
aia:aggregateRelationship a rdf:Property ;
    rdfs:domain aia:Aggregate ;
    rdfs:comment "Relationship the aggregate traverses." .
aia:aggregateField a rdf:Property ;
    rdfs:domain aia:Aggregate ;
    rdfs:comment "Field aggregated (empty string = absent)." .
aia:aggregateFilter a rdf:Property ;
    rdfs:domain aia:Aggregate ;
    rdfs:comment "Filter expression (empty string = absent)." .
aia:aggregateSort a rdf:Property ;
    rdfs:domain aia:Aggregate ;
    rdfs:comment "Sort expression (empty string = absent)." .

# ---- aia:CodeInterface ----
aia:interfaceName a rdf:Property ;
    rdfs:domain aia:CodeInterface ;
    rdfs:comment "Domain code-interface function name." .
aia:interfaceAction a rdf:Property ;
    rdfs:domain aia:CodeInterface ;
    rdfs:comment "Name of the action the interface calls." .

# ---- aia:PolicyRule / aia:PolicyCheck ----
aia:ruleKind a rdf:Property ;
    rdfs:domain aia:PolicyRule ;
    rdfs:comment "policy|bypass." .
aia:ruleCondition a rdf:Property ;
    rdfs:domain aia:PolicyRule ;
    rdfs:comment "Condition expression for the rule." .
aia:checkOf a rdf:Property ;
    rdfs:domain aia:PolicyCheck ;
    rdfs:comment "Links an aia:PolicyCheck to its aia:PolicyRule." .

# ---- aia:FieldPolicy / aia:FieldCheck ----
aia:fieldNames a rdf:Property ;
    rdfs:domain aia:FieldPolicy ;
    rdfs:comment "Comma-separated field names, or * for all." .
aia:fieldPolicyOf a rdf:Property ;
    rdfs:domain aia:FieldCheck ;
    rdfs:comment "Links an aia:FieldCheck to its aia:FieldPolicy." .

# ---- aia:Calculation ----
aia:calculationName a rdf:Property ;
    rdfs:domain aia:Calculation ;
    rdfs:comment "Calculation name." .
aia:calculationType a rdf:Property ;
    rdfs:domain aia:Calculation ;
    rdfs:comment "Ash type of the calculation." .
aia:calculationExpr a rdf:Property ;
    rdfs:domain aia:Calculation ;
    rdfs:comment "Calculation expression source." .

# ---- aia:Identity ----
aia:identityName a rdf:Property ;
    rdfs:domain aia:Identity ;
    rdfs:comment "Identity name." .
aia:identityKeys a rdf:Property ;
    rdfs:domain aia:Identity ;
    rdfs:comment "Comma-separated attribute names forming the identity." .

# ---- aia:Multitenancy ----
aia:tenantStrategy a rdf:Property ;
    rdfs:domain aia:Multitenancy ;
    rdfs:comment "attribute|context." .
aia:tenantAttribute a rdf:Property ;
    rdfs:domain aia:Multitenancy ;
    rdfs:comment "Tenant attribute name (for the attribute strategy)." .

# ---- aia:Pagination ----
aia:paginationOffset a rdf:Property ;
    rdfs:domain aia:Pagination ;
    rdfs:comment "Whether offset pagination is enabled." .
aia:paginationKeyset a rdf:Property ;
    rdfs:domain aia:Pagination ;
    rdfs:comment "Whether keyset pagination is enabled." .
aia:defaultLimit a rdf:Property ;
    rdfs:domain aia:Pagination ;
    rdfs:comment "Default page size." .
aia:countable a rdf:Property ;
    rdfs:domain aia:Pagination ;
    rdfs:comment "Whether the page count is computed." .

# ---- aia:DefaultSort ----
aia:sortField a rdf:Property ;
    rdfs:domain aia:DefaultSort ;
    rdfs:comment "Field to sort by." .
aia:sortDirection a rdf:Property ;
    rdfs:domain aia:DefaultSort ;
    rdfs:comment "Sort direction (asc|desc)." .

# ---- aia:Extension ----
aia:extensionName a rdf:Property ;
    rdfs:domain aia:Extension ;
    rdfs:comment "Extension passed to `ash.extend`." .

#################################################################
# Instance: Shop.Catalog.{Book, Author} -- Book belongs_to Author,
# Author has_many Book (the cross relationship, declared on both sides)
#################################################################

aia:project a aia:Project ;
    aia:otpApp "shop" ;
    aia:taskModule "Mix.Tasks.Shop.Manufacture.Catalog" ;
    aia:taskName "shop.manufacture.catalog" .

aia:resBook a aia:Resource ;
    aia:resourceModule "Shop.Catalog.Book" ; aia:domainModule "Shop.Catalog" ; aia:order 1 .

aia:resAuthor a aia:Resource ;
    aia:resourceModule "Shop.Catalog.Author" ; aia:domainModule "Shop.Catalog" ; aia:order 2 .

# ---- Book ----

aia:attrTitle a aia:Attribute ; aia:resourceOf aia:resBook ;
    aia:attributeName "title" ; aia:attributeType "string" ;
    aia:isPublic true ; aia:isRequired true ; aia:order 1 .

aia:attrIsbn a aia:Attribute ; aia:resourceOf aia:resBook ;
    aia:attributeName "isbn" ; aia:attributeType "string" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 2 .

aia:attrPages a aia:Attribute ; aia:resourceOf aia:resBook ;
    aia:attributeName "pages" ; aia:attributeType "integer" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 3 .

aia:actCreate a aia:Action ; aia:resourceOf aia:resBook ;
    aia:actionName "register" ; aia:actionType "create" ;
    aia:accepts "title,isbn,pages" ; aia:order 1 .

aia:actUpdate a aia:Action ; aia:resourceOf aia:resBook ;
    aia:actionName "revise" ; aia:actionType "update" ;
    aia:accepts "title,pages" ; aia:order 2 .

aia:actRead a aia:Action ; aia:resourceOf aia:resBook ;
    aia:actionName "by_isbn" ; aia:actionType "read" ;
    aia:accepts "" ; aia:order 3 .

aia:relAuthor a aia:Relationship ; aia:resourceOf aia:resBook ;
    aia:relationshipKind "belongs_to" ; aia:relationshipName "author" ;
    aia:destination "Shop.Catalog.Author" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 1 .

aia:idIsbn a aia:Identity ; aia:resourceOf aia:resBook ;
    aia:identityName "unique_isbn" ; aia:identityKeys "isbn" ; aia:order 1 .

aia:calcLen a aia:Calculation ; aia:resourceOf aia:resBook ;
    aia:calculationName "title_length" ; aia:calculationType "integer" ;
    aia:calculationExpr "expr(string_length(title))" ; aia:order 1 .

aia:polRead a aia:Policy ; aia:resourceOf aia:resBook ;
    aia:policyCondition "action_type(:read)" ;
    aia:policyBody "authorize_if always()" ; aia:order 1 .

# ---- Author ----

aia:attrAuthorName a aia:Attribute ; aia:resourceOf aia:resAuthor ;
    aia:attributeName "name" ; aia:attributeType "string" ;
    aia:isPublic true ; aia:isRequired true ; aia:order 1 .

aia:actAuthorEnroll a aia:Action ; aia:resourceOf aia:resAuthor ;
    aia:actionName "enroll" ; aia:actionType "create" ;
    aia:accepts "name" ; aia:order 1 .

aia:relBooks a aia:Relationship ; aia:resourceOf aia:resAuthor ;
    aia:relationshipKind "has_many" ; aia:relationshipName "books" ;
    aia:destination "Shop.Catalog.Book" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 1 .

aia:idAuthorName a aia:Identity ; aia:resourceOf aia:resAuthor ;
    aia:identityName "unique_name" ; aia:identityKeys "name" ; aia:order 1 .
