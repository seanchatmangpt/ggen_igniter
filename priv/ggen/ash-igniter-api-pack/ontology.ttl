@prefix aia:  <https://ggen-igniter.dev/ontology/ash-igniter-api#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Vocabulary
#
# Semantic facts about N Ash resources (each member links to its resource via
# aia:resourceOf) (attributes, actions, relationships,
# identities, calculations, policies). templates/api_task.ex.eex projects them
# into ONE Igniter.Mix.Task composing every resource (one `ash.gen.resource` call
# per resource, in aia:order) and then applies every other fact through the idempotent structural
# APIs of Ash.Resource.Igniter / Ash.Domain.Igniter (add_new_* checks
# existence by name before adding). The ontology stores no CLI strings and no
# Ash source; only names, types and flags.
#
# Consumer-side dev/test capability: the path contains "ash", so
# mix.exs shipped_packs/0 keeps it out of the hex package.
#################################################################

aia:Project a rdfs:Class .
aia:Resource a rdfs:Class .
aia:resourceOf a rdf:Property ;
    rdfs:comment "Links a member fact (attribute/action/relationship/identity/calculation/policy) to its aia:Resource." .
aia:Attribute a rdfs:Class .
aia:Action a rdfs:Class .
aia:Relationship a rdfs:Class .
aia:Identity a rdfs:Class .
aia:Calculation a rdfs:Class .
aia:Policy a rdfs:Class .

# ---- Surface facts (all optional; a resource without them renders exactly as before) ----
# Every class below hangs off an aia:Action (aia:actionOf) or an aia:Resource (aia:resourceOf);
# gates/000_violations.rq refuses dangling / incomplete / malformed instances (typed
# REFUSED_ASH_API_SURFACE, non-zero exit, nothing written).
aia:Argument a rdfs:Class ;
    rdfs:comment "actionOf, argumentName, argumentType, allowNil, order -> `argument :n, :type, allow_nil?: b`." .
aia:SetAttribute a rdfs:Class ;
    rdfs:comment "actionOf, attributeName, valueLiteral, valueType(string|integer|boolean|atom), order -> `change set_attribute(:a, v)`." .
aia:ManageRelationship a rdfs:Class ;
    rdfs:comment "actionOf, argumentName, relationshipName, manageType, order -> `change manage_relationship(:arg, :rel, type: t)`." .
aia:Validation a rdfs:Class ;
    rdfs:comment "actionOf, validationKind(present|match|compare), validationSubject, validationOption, validationValue, validationValueType, order." .
aia:Aggregate a rdfs:Class ;
    rdfs:comment "resourceOf, aggregateKind(count|sum|first|list|max|min|avg|exists), aggregateName, aggregateRelationship, aggregateField, aggregateFilter, aggregateSort, order (empty string = absent)." .
aia:CodeInterface a rdfs:Class ;
    rdfs:comment "resourceOf, interfaceName, interfaceAction, order -> domain `define :name, action: :a`." .
aia:PolicyRule a rdfs:Class ;
    rdfs:comment "resourceOf, ruleKind(policy|bypass), ruleCondition, order; its checks are aia:PolicyCheck (checkOf)." .
aia:PolicyCheck a rdfs:Class ;
    rdfs:comment "checkOf, checkKind(authorize_if|authorize_unless|forbid_if|forbid_unless), checkExpr, order." .
aia:FieldPolicy a rdfs:Class ;
    rdfs:comment "resourceOf, fieldNames (csv or *), order; its checks are aia:FieldCheck (fieldPolicyOf)." .
aia:FieldCheck a rdfs:Class ;
    rdfs:comment "fieldPolicyOf, checkKind, checkExpr, order." .
aia:PrimaryAction a rdfs:Class ;
    rdfs:comment "actionOf -> the action renders `primary? true`." .
aia:EnsurePrimary a rdfs:Class ;
    rdfs:comment "resourceOf, actionType -> Ash.Resource.Igniter.ensure_primary_action/3." .
aia:Pagination a rdfs:Class ;
    rdfs:comment "actionOf (a read), paginationOffset, paginationKeyset, defaultLimit, countable." .
aia:DefaultSort a rdfs:Class ;
    rdfs:comment "actionOf (a read), sortField, sortDirection, order -> `prepare build(sort: [f: :dir])`." .
aia:Multitenancy a rdfs:Class ;
    rdfs:comment "resourceOf, tenantStrategy(attribute|context), tenantAttribute (must be a declared attribute for :attribute)." .
aia:Timestamps a rdfs:Class ;
    rdfs:comment "resourceOf -> Ash.Resource.Igniter.ensure_timestamps/2." .
aia:Extension a rdfs:Class ;
    rdfs:comment "resourceOf, extensionName (ets|policy|Ash.Policy.Authorizer|...), order -> composed `ash.extend`." .

#################################################################
# Instance: Shop.Catalog.{Book, Author} -- Book belongs_to Author,
# Author has_many Book (the cross relationship, declared on both sides)
#################################################################

aia:project a aia:Project ;
    aia:otpApp "shop" ;
    aia:taskModule "Mix.Tasks.Shop.Manufacture.Catalog" ;
    aia:taskName "shop.manufacture.catalog" .

aia:resBook a aia:Resource ;
    aia:resourceModule "Shop.Catalog.Book" ; aia:domainModule "Shop.Catalog" ; aia:order 1 .

aia:resAuthor a aia:Resource ;
    aia:resourceModule "Shop.Catalog.Author" ; aia:domainModule "Shop.Catalog" ; aia:order 2 .

# ---- Book ----

aia:attrTitle a aia:Attribute ; aia:resourceOf aia:resBook ;
    aia:attributeName "title" ; aia:attributeType "string" ;
    aia:isPublic true ; aia:isRequired true ; aia:order 1 .

aia:attrIsbn a aia:Attribute ; aia:resourceOf aia:resBook ;
    aia:attributeName "isbn" ; aia:attributeType "string" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 2 .

aia:attrPages a aia:Attribute ; aia:resourceOf aia:resBook ;
    aia:attributeName "pages" ; aia:attributeType "integer" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 3 .

aia:actCreate a aia:Action ; aia:resourceOf aia:resBook ;
    aia:actionName "register" ; aia:actionType "create" ;
    aia:accepts "title,isbn,pages" ; aia:order 1 .

aia:actUpdate a aia:Action ; aia:resourceOf aia:resBook ;
    aia:actionName "revise" ; aia:actionType "update" ;
    aia:accepts "title,pages" ; aia:order 2 .

aia:actRead a aia:Action ; aia:resourceOf aia:resBook ;
    aia:actionName "by_isbn" ; aia:actionType "read" ;
    aia:accepts "" ; aia:order 3 .

aia:relAuthor a aia:Relationship ; aia:resourceOf aia:resBook ;
    aia:relationshipKind "belongs_to" ; aia:relationshipName "author" ;
    aia:destination "Shop.Catalog.Author" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 1 .

aia:idIsbn a aia:Identity ; aia:resourceOf aia:resBook ;
    aia:identityName "unique_isbn" ; aia:identityKeys "isbn" ; aia:order 1 .

aia:calcLen a aia:Calculation ; aia:resourceOf aia:resBook ;
    aia:calculationName "title_length" ; aia:calculationType "integer" ;
    aia:calculationExpr "expr(string_length(title))" ; aia:order 1 .

aia:polRead a aia:Policy ; aia:resourceOf aia:resBook ;
    aia:policyCondition "action_type(:read)" ;
    aia:policyBody "authorize_if always()" ; aia:order 1 .

# ---- Author ----

aia:attrAuthorName a aia:Attribute ; aia:resourceOf aia:resAuthor ;
    aia:attributeName "name" ; aia:attributeType "string" ;
    aia:isPublic true ; aia:isRequired true ; aia:order 1 .

aia:actAuthorEnroll a aia:Action ; aia:resourceOf aia:resAuthor ;
    aia:actionName "enroll" ; aia:actionType "create" ;
    aia:accepts "name" ; aia:order 1 .

aia:relBooks a aia:Relationship ; aia:resourceOf aia:resAuthor ;
    aia:relationshipKind "has_many" ; aia:relationshipName "books" ;
    aia:destination "Shop.Catalog.Book" ;
    aia:isPublic true ; aia:isRequired false ; aia:order 1 .

aia:idAuthorName a aia:Identity ; aia:resourceOf aia:resAuthor ;
    aia:identityName "unique_name" ; aia:identityKeys "name" ; aia:order 1 .
