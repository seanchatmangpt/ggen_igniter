PREFIX aia: <https://ggen-igniter.dev/ontology/ash-igniter-api#>

SELECT ?resource_module ?policy_condition ?policy_body ?ord
WHERE {
  ?p aia:resourceOf ?res .
  ?res aia:resourceModule ?resource_module .
  ?p a aia:Policy ;
     aia:policyCondition ?policy_condition ;
     aia:policyBody ?policy_body ;
     aia:order ?ord .
}
ORDER BY ?resource_module ?ord
