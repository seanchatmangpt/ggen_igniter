PREFIX aia: <https://ggen-igniter.dev/ontology/ash-igniter-api#>

SELECT ?resource_module ?action_name ?action_type ?accepts ?ord
WHERE {
  ?a aia:resourceOf ?res .
  ?res aia:resourceModule ?resource_module .
  ?a a aia:Action ;
     aia:actionName ?action_name ;
     aia:actionType ?action_type ;
     aia:accepts ?accepts ;
     aia:order ?ord .
}
ORDER BY ?resource_module ?ord
