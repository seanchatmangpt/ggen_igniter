---
to: "lib/ggen_igniter/discovery/examples/incremental_dfg.ex"
mode: file
---
<%
  [row | _] = module
  module_name = row["moduleName"]
  event_module = row["eventModule"]
  event_alias = row["eventAlias"]
  activity_field = row["activityField"]
  case_id_field_expr = row["caseIdFieldExpr"]
  default_case_id = row["defaultCaseId"]
%># GENERATED by ggen_igniter from priv/ggen/incremental-discovery-pack/ontology.ttl.
# Do not edit. Regenerate with:
#   mix ggen_igniter.sync --pack incremental-discovery-pack \
#     --out lib/ggen_igniter/discovery/examples/incremental_dfg.ex
#
# Manufactured incremental (streaming) directly-follows-graph discovery
# module, ported from ex4pm's reference implementation
# (~/ex4pm/apps/ex4pm_engine/lib/ex4pm/engine/discovery/incremental.ex).
defmodule <%= module_name %> do
  @moduledoc """
  Real incremental (streaming) directly-follows-graph discovery.

  Maintains a running DFG state and folds one new `%<%= event_alias %>{}` at a
  time via `update/2` -- no reprocessing of prior events: O(1) amortized work
  per event (map updates only). `from_events/1` is a Chicago-style
  cross-check oracle: it folds a batch list through the SAME `update/2` step
  function, so the incremental and batch paths are proven equivalent by
  construction, not by two independently written implementations that could
  silently drift.

  Regenerate via `mix ggen_igniter.sync --pack incremental-discovery-pack
  --out lib/ggen_igniter/discovery/examples/incremental_dfg.ex`. Never
  hand-edit this file -- edit `priv/ggen/incremental-discovery-pack/ontology.ttl`
  instead.
  """

  alias <%= event_module %>, as: <%= event_alias %>

  @type edge :: {String.t(), String.t()}

  @type t :: %__MODULE__{
          case_id_fun: (<%= event_alias %>.t() -> term()),
          last_activity: %{optional(term()) => String.t()},
          edges: %{optional(edge()) => non_neg_integer()},
          activities: %{optional(String.t()) => non_neg_integer()},
          starts: %{optional(String.t()) => non_neg_integer()},
          ends: %{optional(String.t()) => non_neg_integer()},
          event_count: non_neg_integer()
        }

  defstruct case_id_fun: nil,
            last_activity: %{},
            edges: %{},
            activities: %{},
            starts: %{},
            ends: %{},
            event_count: 0

  @doc "New empty incremental DFG state. `opts[:case_id_fun]` overrides case correlation."
  @spec new(keyword()) :: t()
  def new(opts \\ []) do
    case_id_fun = Keyword.get(opts, :case_id_fun, &default_case_id/1)
    %__MODULE__{case_id_fun: case_id_fun}
  end

  @doc """
  Fold exactly one new event into the running DFG state.

  Real incremental update: touches only the edges/activity counters implicated
  by this single event and the case's previous activity -- never rescans prior
  events.
  """
  @spec update(t(), <%= event_alias %>.t()) :: t()
  def update(%__MODULE__{} = state, %<%= event_alias %>{} = event) do
    case_id = state.case_id_fun.(event)
    activity = event.<%= activity_field %>

    activities = Map.update(state.activities, activity, 1, &(&1 + 1))
    event_count = state.event_count + 1

    case Map.fetch(state.last_activity, case_id) do
      {:ok, prev_activity} ->
        edge = {prev_activity, activity}
        edges = Map.update(state.edges, edge, 1, &(&1 + 1))

        %{
          state
          | edges: edges,
            activities: activities,
            event_count: event_count,
            last_activity: Map.put(state.last_activity, case_id, activity)
        }

      :error ->
        starts = Map.update(state.starts, activity, 1, &(&1 + 1))

        %{
          state
          | activities: activities,
            starts: starts,
            event_count: event_count,
            last_activity: Map.put(state.last_activity, case_id, activity)
        }
    end
  end

  @doc """
  Finalize a state that has consumed a bounded stream by recording per-case
  end activities (the trailing activity of each case seen so far). Idempotent
  and non-destructive w.r.t. `edges`/`activities` -- only touches `ends`.
  """
  @spec finalize(t()) :: t()
  def finalize(%__MODULE__{} = state) do
    ends =
      Enum.reduce(state.last_activity, %{}, fn {_case_id, activity}, acc ->
        Map.update(acc, activity, 1, &(&1 + 1))
      end)

    %{state | ends: ends}
  end

  @doc """
  Batch-computed DFG over a full event list, used only as a cross-check oracle.
  Implemented as a fold through the *same* `update/2` step used for streaming,
  so equivalence with the incremental path is structural, not coincidental.
  """
  @spec from_events([<%= event_alias %>.t()], keyword()) :: t()
  def from_events(events, opts \\ []) when is_list(events) do
    opts
    |> new()
    |> then(fn state -> Enum.reduce(events, state, &update(&2, &1)) end)
    |> finalize()
  end

  @doc "Directly-follows edge frequency map, `{from, to} => count`."
  @spec dfg(t()) :: %{optional(edge()) => non_neg_integer()}
  def dfg(%__MODULE__{edges: edges}), do: edges

  defp default_case_id(%<%= event_alias %>{<%= case_id_field_expr |> String.split(".") |> List.last() %>: [first | _]}), do: first
  defp default_case_id(%<%= event_alias %>{}), do: <%= default_case_id %>
end
