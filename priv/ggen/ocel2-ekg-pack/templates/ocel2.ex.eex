---
to: "lib/ggen_igniter/ocel2_example.ex"
mode: file
---
<%
  ns = namespace
  event_log_struct = eventLogStruct
  event_struct = eventStruct
  object_relationship_struct = objectRelationshipStruct
  attribute_change_struct = attributeChangeStruct
  refusal_module = refusalModule
  events_field = eventsField
  objects_field = objectsField
  object_relationships_field = objectRelationshipsField
  object_ids_field = objectIdsField
  timestamp_field = timestampField
  id_field = idField
  attributes_field = attributesField
  relationships_field = relationshipsField
%># GENERATED by ggen_igniter from priv/ggen/ocel2-ekg-pack/ontology.ttl.
# Do not edit. Regenerate with:
#   mix ggen_igniter.sync --pack ocel2-ekg-pack --out <target path>
#
# OCEL 2.0 / Event-Knowledge-Graph-style semantics manufactured from the
# ocel2-ekg-pack ontology, parameterized over this consumer's own canonical
# EventLog IR (<%= ns %>.<%= event_log_struct %> / <%= ns %>.<%= event_struct %> /
# <%= ns %>.<%= object_relationship_struct %>). Reference logic:
# ~/ex4pm/apps/ex4pm_core/lib/ex4pm/ocel2.ex.

defmodule <%= ns %>.<%= attribute_change_struct %> do
  @moduledoc "A single time-traceable object-attribute value change (OCEL 2.0 / EKG style)."
  @enforce_keys [:name, :value, :<%= timestamp_field %>]
  defstruct [:name, :value, :<%= timestamp_field %>]
end

defmodule <%= ns %>.OCEL2 do
  @moduledoc """
  OCEL 2.0 / Event-Knowledge-Graph-style semantics layered on top of the canonical
  `<%= ns %>.<%= event_log_struct %>` IR (`<%= ns %>.<%= event_struct %>`,
  `<%= ns %>.<%= object_relationship_struct %>`).

  This module does not introduce a competing event/object representation -- it
  derives EKG-shaped views (object traces, attribute-change history,
  qualifier-typed O2O edges) directly from the already-normalized
  `%<%= ns %>.<%= event_log_struct %>{}`.

  Three capabilities:

    * `object_trace/2` -- the full, time-ordered event sequence for a single object id.
    * `attribute_history/3` -- the time-traceable value-change history for one
      dynamic object attribute, not just its current value.
    * `object_relationships_for/2` -- the qualifier-typed O2O edges touching one
      object, in either direction.
  """

  alias <%= ns %>.{<%= attribute_change_struct %>, <%= event_log_struct %>, <%= refusal_module %>}

  @doc """
  Returns the full ordered trace (event sequence) for a single object id: every
  event in `log` that references `object_id` via `<%= object_ids_field %>` or an
  explicit relationship, sorted by `{<%= timestamp_field %>, <%= id_field %>}`.
  """
  def object_trace(%<%= event_log_struct %>{} = log, object_id) when is_binary(object_id) do
    if Map.has_key?(log.<%= objects_field %>, object_id) do
      trace =
        log.<%= events_field %>
        |> Enum.filter(&(object_id in &1.<%= object_ids_field %>))
        |> Enum.sort_by(&{&1.<%= timestamp_field %>, &1.<%= id_field %>})

      {:ok, trace}
    else
      {:error,
       <%= refusal_module %>.new(:unknown_object_reference, "object id not present in event log",
         details: %{object_id: object_id}
       )}
    end
  end

  @doc """
  Returns the time-traceable change history for a single dynamic object
  attribute, reconstructed from every event in the object's trace that carries
  an updated value for `attribute_name` (looked up in the event's
  `<%= attributes_field %>` map, falling back to the qualifier-scoped payload on
  the event's relationship for `object_id` when present).

  History is a chronologically ordered list of `%<%= ns %>.<%= attribute_change_struct %>{}`,
  one entry per event that actually changes the value.
  """
  def attribute_history(%<%= event_log_struct %>{} = log, object_id, attribute_name)
      when is_binary(object_id) and is_binary(attribute_name) do
    with {:ok, trace} <- object_trace(log, object_id) do
      history =
        trace
        |> Enum.reduce([], fn event, acc ->
          case event_attribute_value(event, object_id, attribute_name) do
            {:ok, value} ->
              case acc do
                [%<%= attribute_change_struct %>{value: ^value} | _] ->
                  acc

                _ ->
                  [
                    %<%= attribute_change_struct %>{
                      name: attribute_name,
                      value: value,
                      <%= timestamp_field %>: event.<%= timestamp_field %>
                    }
                    | acc
                  ]
              end

            :not_found ->
              acc
          end
        end)
        |> Enum.reverse()

      {:ok, history}
    end
  end

  @doc """
  Returns the qualifier-typed Object-to-Object relationships that touch
  `object_id`, in either direction (as source or as target), preserving the
  `qualifier` field on each `%<%= ns %>.<%= object_relationship_struct %>{}`-shaped map.
  """
  def object_relationships_for(%<%= event_log_struct %>{} = log, object_id)
      when is_binary(object_id) do
    Enum.filter(log.<%= object_relationships_field %>, fn rel ->
      rel.source_id == object_id or rel.target_id == object_id
    end)
  end

  defp event_attribute_value(event, object_id, attribute_name) do
    from_relationship =
      event.<%= relationships_field %>
      |> Enum.find(&(&1.object_id == object_id))
      |> case do
        %{<%= attributes_field %>: attrs} when is_map(attrs) -> Map.get(attrs, attribute_name)
        _ -> nil
      end

    from_event_attrs = Map.get(event.<%= attributes_field %>, attribute_name)

    case from_relationship || from_event_attrs do
      nil -> :not_found
      value -> {:ok, value}
    end
  end
end
