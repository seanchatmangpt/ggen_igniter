adr:d0007 a adr:Decision ;
    adr:number "0007" ;
    adr:filename "0007-sync-always-attempts-receipts.md" ;
    adr:title "`mix ggen_igniter.sync` Always Attempts the Reactor Pipeline (Receipts on Every Run), Gated Only by Delegatability" ;
    adr:status "Accepted" .

adr:d0008 a adr:Decision ;
    adr:number "0008" ;
    adr:filename "0008-evidence-ranked-multi-engine-registry.md" ;
    adr:title "Evidence-Ranked Multi-Engine Registry for `--engine` Comparison Mode" ;
    adr:status "Accepted" .

# d0010/d0011 were hand-added to README.md's table by the v26.9.20 release
# (7af7cf2) without individuals here -- a projection edit with no graph row,
# which the next re-run would have silently dropped. They are recorded as
# data here (number/filename/status and README-row title wording, matching
# the pre-existing README rows for docs/architecture/adr/ADR-010*-*.md,
# 2026-09-24) so the projection is regenerable again.
adr:d0010 a adr:Decision ;
    adr:number "ADR-010" ;
    adr:filename "ADR-010-event-sourced-standing.md" ;
    adr:title "Event-sourced standing (definition_digest + append-only log)" ;
