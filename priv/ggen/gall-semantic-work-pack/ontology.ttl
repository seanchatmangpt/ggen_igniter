@prefix gall: <https://semantic-a2a.dev/gall#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:gall:work-order:example:001>
    a gall:WorkOrder ;
    gall:checkpoint <urn:gall:checkpoint:example:001> .

<urn:gall:checkpoint:example:001>
    a gall:CodingCheckpoint ;
    gall:workOrder <urn:gall:work-order:example:001> ;
    gall:repositoryIdentity "seanchatmangpt/ggen_igniter" ;
    gall:executionRepoAlias "ggen_igniter" ;
    gall:baseSha "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
    gall:graphDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
    gall:goal "Implement the admitted semantic-work subject." ;
    gall:provider "zcode" ;
    gall:verifier "example-dod" ;
    gall:executionPolicy "continuous_epoch_run" ;
    gall:standing gall:UNKNOWN ;
    gall:requiresCapability gall:Read, gall:Edit, gall:Commit ;
    gall:forbidsCapability gall:Push, gall:Publish .
