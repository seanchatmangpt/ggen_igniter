---
to: "<%= formatter_path %>"
for_each: extensions
---
<%
  if violations != [] do
    detail = Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]}: #{&1["violation_detail"]}")
    raise "REFUSED_EXTENSION_SCHEMA: #{detail}; broken_term=admission_vacuous"
  end

  truthy = fn
    true -> true
    "true" -> true
    _ -> false
  end

  to_i = fn
    v when is_integer(v) -> v
    v -> String.to_integer("#{v}")
  end

  ext_entities = Enum.filter(entities, &(&1["extension_iri"] == extension_iri))

  # {name, [%{name, required, pos}]} for every entity of this extension.
  model =
    if ext_entities != [] do
      Enum.map(ext_entities, fn e ->
        fs =
          fields
          |> Enum.filter(&(&1["entity_iri"] == e["entity_iri"]))
          |> Enum.map(fn f ->
            %{name: f["field_name"], required: truthy.(f["field_required"]),
              pos: (if f["arg_position"] == "", do: nil, else: to_i.(f["arg_position"]))}
          end)

        {e["entity_name"], fs}
      end)
    else
      [{entity_name, [%{name: entity_arg, required: true, pos: 0}]}]
    end

  # Mirrors Spark.Formatter.entity_builders/1 + entity_option_builders/1 (Spark is the oracle:
  # test/ggen_igniter_extension_formatter_test.exs runs the real `mix spark.formatter`).
  locals =
    model
    |> Enum.flat_map(fn {name, fs} ->
      args = fs |> Enum.filter(& &1.pos) |> Enum.sort_by(& &1.pos)
      arg_count = length(args)
      required_count = Enum.count(args, & &1.required)
      required_names = for a <- args, a.required, do: a.name

      builders =
        Enum.flat_map(required_count..arg_count, fn k -> [{name, k}, {name, k + 1}] end)

      options = for f <- fs, f.name not in required_names, do: {f.name, 1}
      builders ++ options
    end)
    |> Enum.uniq()
    |> Enum.sort_by(fn {n, a} -> {n, a} end)

  list = Enum.map_join(locals, ", ", fn {n, a} -> "#{n}: #{a}" end)

  source = """
  # GENERATED by receipted-extension-pack (ggen_igniter renderer). Do not hand-edit.
  # Source of truth: #{extension_iri} + priv/ggen/receipted-extension-pack/ontology.ttl.
  spark_locals_without_parens = [#{list}]

  [
    inputs: ["{mix,.formatter}.exs", "{config,lib,test}/**/*.{ex,exs}"],
    locals_without_parens: spark_locals_without_parens,
    export: [locals_without_parens: spark_locals_without_parens]
  ]
  """

  formatted = IO.iodata_to_binary([Code.format_string!(source, []), "\n"])
%><%= formatted %>
