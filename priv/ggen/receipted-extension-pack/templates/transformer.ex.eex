---
to: "<%= lib_path %>/transformers/<%= transformer_name %>.ex"
for_each: transformers
---
<%
  if violations != [] do
    detail = Enum.map_join(violations, "; ", &"#{&1["violation_code"]} #{&1["violation_subject"]}: #{&1["violation_detail"]}")
    raise "REFUSED_EXTENSION_SCHEMA: #{detail}; broken_term=admission_vacuous"
  end

  camel = &Macro.camelize(&1)
  atom_lit = fn s -> inspect(String.to_atom(s)) end

  type_lit = fn
    "atom" -> ":atom"
    "string" -> ":string"
    "integer" -> ":integer"
    "boolean" -> ":boolean"
    "list_atom" -> "{:array, :atom}"
  end

  default_lit = fn
    "atom", d -> atom_lit.(d)
    "string", d -> inspect(d)
    "integer", d -> "#{String.to_integer(d)}"
    "boolean", d -> if(d in ["true", "false"], do: d, else: raise("REFUSED_EXTENSION_SCHEMA: BAD_BOOLEAN_DEFAULT #{d}"))
    "list_atom", d -> "[" <> (d |> String.split(",", trim: true) |> Enum.map_join(", ", &atom_lit.(String.trim(&1)))) <> "]"
  end

  mods_of = fn relation ->
    orders
    |> Enum.filter(&(&1["transformer_iri"] == transformer_iri and &1["relation"] == relation))
    |> Enum.map(&"#{module_name}.Transformers.#{camel.(&1["other_name"])}")
  end

  before_mods = mods_of.("before")
  after_mods = mods_of.("after")
  adds? = adds_attribute != ""
%>
# GENERATED by receipted-extension-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: <%= transformer_iri %> + priv/ggen/receipted-extension-pack/ontology.ttl.
defmodule <%= module_name %>.Transformers.<%= camel.(transformer_name) %> do
  @moduledoc """
  Spark transformer `<%= transformer_name %>` of `<%= module_name %>`.

  Records its own name in the persisted `:rx_trace` (run order is observable state)<%= if persist_key != "" do %>,
  persists `<%= persist_key %>`<% end %><%= if adds? do %>,
  and adds attribute `<%= adds_attribute %>` to the resource<% end %>.
  """
  use Spark.Dsl.Transformer

  alias Spark.Dsl.Transformer

  @impl true
  def before?(other), do: other in [<%= Enum.join(before_mods, ", ") %>]

  @impl true
  def after?(other), do: other in [<%= Enum.join(after_mods, ", ") %>]

  @impl true
  def transform(dsl_state) do
    trace = Transformer.get_persisted(dsl_state, :rx_trace, [])
    dsl_state = Transformer.persist(dsl_state, :rx_trace, trace ++ [<%= atom_lit.(transformer_name) %>])
<%= if persist_key != "" do %>
    dsl_state = Transformer.persist(dsl_state, <%= atom_lit.(persist_key) %>, <%= inspect(persist_value) %>)
<% end %><%= if adds? do %>
    Ash.Resource.Builder.add_new_attribute(
      dsl_state,
      <%= atom_lit.(adds_attribute) %>,
      <%= type_lit.(attribute_type) %><%= if attribute_default != "" do %>,
      default: <%= default_lit.(attribute_type, attribute_default) %><% end %>,
      public?: true
    )
<% else %>
    {:ok, dsl_state}
<% end %>  end
end
