---
to: "<%= lib_path %>/receipted_verifier.ex"
for_each: extensions
---
# GENERATED by receipted-extension-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: <%= extension_iri %> + priv/ggen/receipted-extension-pack/ontology.ttl.
defmodule <%= module_name %>.Verifier do
  @moduledoc """
  Refuses an Ash resource that uses `<%= module_name %>` but declares no
  `receipted do receipt ... end` -- the compile-time twin of
  `.claude/hooks/refuse-handwritten-ash.sh`.
  """
  use Spark.Dsl.Verifier

  alias Spark.Dsl.Verifier
  alias Spark.Error.DslError

  @impl true
  def verify(dsl_state) do
    case Verifier.get_entities(dsl_state, [:receipted]) do
      [] ->
        {:error,
         DslError.exception(
           module: Verifier.get_persisted(dsl_state, :module),
           path: [:receipted],
           message:
             "REFUSED_NO_RECEIPT: resource uses <%= module_name %> but declares no receipt; " <>
               "add `receipted do receipt :kind end`"
         )}

      _ ->
        :ok
    end
  end
end
