---
to: "lib/mix/tasks/<%= task_name %>.ex"
for_each: wires
mode: file
---
# GENERATED by receipted-extension-pack (ggen_igniter renderer). Do not hand-edit.
# Source of truth: <%= extension_iri %> + priv/ggen/receipted-extension-pack/ontology.ttl.
defmodule <%= task_module %> do
  @shortdoc "Adds <%= module_name %> to an Ash resource's extensions (idempotent)."
  @moduledoc """
  Adds `<%= module_name %>` to the `extensions:` option of a resource's
  `use Ash.Resource`. Runs `Spark.Igniter.has_extension/5` first, so a second run
  leaves the project unchanged.

  ## Options

    * `--resource` -- resource module to wire (default `<%= target_resource %>`)

  ## Examples

  ```bash
  mix <%= task_name %> --resource <%= target_resource %>
  ```
  """

  use Igniter.Mix.Task

  @example "mix <%= task_name %> --resource <%= target_resource %>"
  @extension <%= module_name %>
  @default_resource <%= target_resource %>

  @impl Igniter.Mix.Task
  def info(_argv, _composing_task) do
    %Igniter.Mix.Task.Info{
      group: :ggen_igniter,
      example: @example,
      positional: [],
      schema: [resource: :string],
      aliases: [r: :resource],
      required: []
    }
  end

  @impl Mix.Task
  def run(argv) do
    GgenIgniter.TaskShell.run_with_help(
      argv,
      fn -> print_help_and_halt() end,
      fn -> super(argv) end,
      ["--help"]
    )
  end

  @impl Igniter.Mix.Task
  def igniter(igniter) do
    resource =
      case igniter.args.options[:resource] do
        nil -> @default_resource
        name -> Igniter.Project.Module.parse(name)
      end

    {igniter, present?} =
      Spark.Igniter.has_extension(igniter, resource, Ash.Resource, :extensions, @extension)

    if present? do
      igniter
    else
      Spark.Igniter.add_extension(igniter, resource, Ash.Resource, :extensions, @extension)
    end
  end

  defp print_help_and_halt do
    IO.puts("""
    mix <%= task_name %> -- add <%= module_name %> to an Ash resource

    USAGE
        #{@example}

    OPTIONS
        --resource MODULE   resource to wire (default <%= target_resource %>)
    """)

    System.halt(0)
  end
end
