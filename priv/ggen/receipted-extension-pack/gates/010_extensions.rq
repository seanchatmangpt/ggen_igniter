PREFIX rx: <https://ggen-igniter.dev/ontology/receipted-extension#>
SELECT DISTINCT ?extension_iri ?module_name ?lib_path
WHERE {
  ?e a rx:ReceiptedExtension ;
     rx:moduleName ?m ;
     rx:libPath ?l .
  BIND(STR(?e) AS ?extension_iri)
  BIND(STR(?m) AS ?module_name)
  BIND(STR(?l) AS ?lib_path)
}
ORDER BY ?extension_iri
