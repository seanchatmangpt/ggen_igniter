@prefix rx:   <https://ggen-igniter.dev/ontology/receipted-extension#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# receipted-extension-pack -- the receipt law for Ash resources, as a Spark extension.
#
#   forall resource R using <Module>: R declares `receipted do receipt ... end`
#
# A consumer graph declares one rx:ReceiptedExtension individual (concatenated with this
# file before sync). The pack ships no individual, so `--pack receipted-extension-pack`
# alone renders nothing. The rendered extension is the ONLY place `use Spark.Dsl.Extension`
# appears; nothing in lib/ hand-writes it.

rx: a owl:Ontology ;
    rdfs:label "Receipted Spark extension" ;
    rdfs:comment "A generated Spark.Dsl.Extension + Spark.Dsl.Verifier refusing Ash resources with no declared receipt." .

rx:ReceiptedExtension a owl:Class ;
    rdfs:label "Receipted extension target" ;
    rdfs:comment "One individual per generated extension module." .

rx:moduleName a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Fully qualified extension module, e.g. Consumer.Receipted (verifier is <Module>.Verifier)." .

rx:libPath a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Output directory (relative) for the rendered modules." .

rx:sectionName a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Spark section name (default: receipted). Template literal for Spark.Dsl.Section name." .

rx:entityName a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Spark entity name inside the section (default: receipt)." .

rx:entityArg a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Single positional Spark entity arg / schema key (default: kind)." .

rx:targetResource a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Ash resource module the wire task adds the extension to by default (overridable with --resource)." .

rx:wireTaskModule a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Mix task module of the rendered wire task, e.g. Mix.Tasks.Consumer.Receipted.Wire." .

rx:wireTaskName a owl:DatatypeProperty ;
    rdfs:domain rx:ReceiptedExtension ;
    rdfs:comment "Mix task name of the wire task, e.g. consumer.receipted.wire." .
