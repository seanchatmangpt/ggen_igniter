# Finite delta manufacture (PRD PR-004, ARD sections 5.5 and 17; lane V23-C).
#
#   Delta = AcceptedFuture - AdmittedCurrentState
#
# AcceptedFuture: every admitted proposition of kind Postcondition, Invariant
# or Falsifier that is required (sj:requiredBy) by the root or one of its
# gates. AdmittedCurrentState: the ALIVE receipts the orchestrator projects as
# `<target> sj:receipt <urn:sha256:...>` / `<urn:...> a sj:Receipt ;
# sj:standing "ALIVE"` when a receipt's identity.subject names the
# proposition or its gate. Each unwitnessed required proposition becomes one
# sj:WorkOrder <ns>WO-<first 16 hex of sha256(proposition IRI)> carrying the
# full FRI-T1 tuple (shapes/work-order.shacl.ttl sj:WorkOrderShape +
# sj:FridayWorkOrderShape):
#
#   postcondition       hint sj:postcondition, else the statement
#   requiresCapability  the goal's sj:Capability with the hinted id, else a
#                       manufactured node; no hint -> construct:unassigned,
#                       typed sj:standing "UNKNOWN"
#   evidenceHorizon     hint, else the root's, else EXECUTED_VERIFIED
#   authorityCeiling    CONSTRUCT
#   consequenceClass    hint, else manufacture
#   exclusion (0..n)    admitted Exclusion statements required by the same
#                       gate, plus the proposition's own exclusion hints
#   successorPolicy     hint, else the root's
#   acceptance/falsifier  hint nodes, else manufactured nodes
#
# Deterministic: no LLM, no clock, no randomness; the same admitted graph
# revision always yields the same triples (ARD section 5.5). ?root (IRI) and
# ?ns (the root's namespace) are bound by the orchestrator (BIND at the head
# of the WHERE group). ?unbound is never bound: IF(..., ?unbound, x) leaves a
# variable unbound, so a CONSTRUCT template triple using it is not emitted.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
CONSTRUCT {
  ?order a sj:WorkOrder ;
      rdfs:label ?orderLabel ;
      dcterms:identifier ?orderId ;
      dcterms:title ?statement ;
      dcterms:description ?orderDescription ;
      sj:repository ?repository ;
      sj:baseSha ?baseSha ;
      sj:subject ?subject ;
      sj:pathScope "unassigned" ;
      sj:standing "UNKNOWN" ;
      sj:evidenceCeiling ?horizon ;
      sj:authorityCeiling "CONSTRUCT" ;
      sj:authorityRequirement "NONE" ;
      sj:promotionRule ?promotionRule ;
      sj:replayIdentity ?replayIdentity ;
      sj:requiresCourt ?court ;
      sj:requiresEvidence sj:receipt-evidence ;
      sj:requiresReceiptClass ?consequence ;
      sj:acceptance ?acceptance ;
      sj:falsifier ?falsifier ;
      sj:projection sj:markdown-projection ;
      sj:nextAction ?action ;
      sj:nextCheckpoint ?gate ;
      sj:checkpointOf ?gate ;
      sj:boundaryClass ?boundary ;
      sj:postcondition ?postcondition ;
      sj:requiresCapability ?capability ;
      sj:evidenceHorizon ?horizon ;
      sj:exclusion ?gateExclusion ;
      sj:exclusion ?hintExclusion ;
      sj:consequenceClass ?consequence ;
      sj:successorPolicy ?successorPolicy .
  ?court a sj:Court ;
      rdfs:label ?courtLabel ;
      dcterms:description ?courtDescription .
  ?action a sj:Action ;
      rdfs:label ?actionLabel ;
      dcterms:description ?actionDescription .
  ?madeAcceptance a sj:AcceptanceCriterion ;
      rdfs:label ?acceptanceLabel ;
      dcterms:description ?acceptanceDescription .
  ?madeFalsifier a sj:Falsifier ;
      rdfs:label ?falsifierLabel ;
      dcterms:description ?falsifierDescription .
  ?hintAcceptance a sj:AcceptanceCriterion ;
      dcterms:description ?hintAcceptanceDescription .
  ?hintFalsifier a sj:Falsifier ;
      dcterms:description ?hintFalsifierDescription .
  ?capability a sj:Capability ;
      sj:capabilityId ?capabilityId .
  ?madeCapability rdfs:label ?capabilityLabel ;
      dcterms:description ?capabilityDescription .
  ?unknownCapability sj:standing "UNKNOWN" .
}
WHERE {
  ?root sj:repository ?repository ;
        sj:baseSha ?baseSha .
  ?proposition a sj:Proposition ;
      sj:propositionKind ?kind ;
      sj:statement ?statement ;
      sj:requiredBy ?gate ;
      sj:boundaryClass ?boundary ;
      sj:sourceDocument ?sourceDocument ;
      sj:sourceSha256 ?sourceSha256 ;
      sj:sourceStart ?sourceStart ;
      sj:sourceEnd ?sourceEnd .
  FILTER(?kind = "Postcondition" || ?kind = "Invariant" || ?kind = "Falsifier")
  OPTIONAL {
    ?proposition sj:receipt ?propositionReceipt .
    ?propositionReceipt a sj:Receipt ;
                        sj:standing "ALIVE" .
  }
  OPTIONAL {
    ?gate sj:receipt ?gateReceipt .
    ?gateReceipt a sj:Receipt ;
                 sj:standing "ALIVE" .
  }
  FILTER(!BOUND(?propositionReceipt) && !BOUND(?gateReceipt))
  OPTIONAL { ?root dcterms:identifier ?rootIdentifier . }
  OPTIONAL { ?root sj:evidenceHorizon ?rootHorizon . }
  OPTIONAL { ?root sj:successorPolicy ?rootSuccessorPolicy . }
  OPTIONAL { ?gate dcterms:identifier ?gateIdentifier . }
  OPTIONAL { ?gate sj:courtCommand ?gateCourtCommand . }
  OPTIONAL { ?proposition sj:postcondition ?hintPostcondition . }
  OPTIONAL { ?proposition sj:evidenceHorizon ?hintHorizon . }
  OPTIONAL { ?proposition sj:consequenceClass ?hintConsequence . }
  OPTIONAL { ?proposition sj:successorPolicy ?hintSuccessorPolicy . }
  OPTIONAL { ?proposition sj:requiresCapability ?hintCapability . }
  OPTIONAL { ?proposition sj:exclusion ?hintExclusion . }
  OPTIONAL {
    ?proposition sj:acceptance ?hintAcceptance .
    ?hintAcceptance dcterms:description ?hintAcceptanceDescription .
  }
  OPTIONAL {
    ?proposition sj:falsifier ?hintFalsifier .
    ?hintFalsifier dcterms:description ?hintFalsifierDescription .
  }
  OPTIONAL {
    ?exclusionProposition a sj:Proposition ;
                          sj:propositionKind "Exclusion" ;
                          sj:requiredBy ?gate ;
                          sj:statement ?gateExclusion .
  }
  BIND(SUBSTR(SHA256(STR(?proposition)), 1, 16) AS ?hex)
  BIND(IRI(CONCAT(?ns, "WO-", ?hex)) AS ?order)
  BIND(CONCAT("WO-", UCASE(?hex)) AS ?orderId)
  BIND(STR(?proposition) AS ?subject)
  BIND(COALESCE(?rootIdentifier, STR(?root)) AS ?rootName)
  BIND(COALESCE(?gateIdentifier, STR(?gate)) AS ?gateName)
  BIND(COALESCE(?hintPostcondition, ?statement) AS ?postcondition)
  BIND(COALESCE(?hintHorizon, ?rootHorizon, "EXECUTED_VERIFIED") AS ?horizon)
  BIND(COALESCE(?hintConsequence, "manufacture") AS ?consequence)
  BIND(COALESCE(?hintSuccessorPolicy, ?rootSuccessorPolicy,
                CONCAT("Discovered work that falsifies no ", ?rootName, " proposition is typed Successor.")) AS ?successorPolicy)
  BIND(CONCAT(?orderId, " ", ?kind, ": ", ?statement) AS ?orderLabel)
  BIND(CONCAT("Manufactured by mix semantic_jira.compile_prose (PR-004, ARD section 5.5) from the admitted ",
              ?kind, " proposition ", ?subject, " (", ?sourceDocument, " bytes [", STR(?sourceStart), ", ",
              STR(?sourceEnd), ") of ", ?sourceSha256, "), required by ", ?gateName,
              " and not witnessed by an ALIVE receipt.") AS ?orderDescription)
  BIND(CONCAT("Standing advances only from an ADMITTED receipt whose identity.subject names ", ?subject,
              " or its gate ", ?gateName, "; the sj:standing literal of this order is a shape placeholder.") AS ?promotionRule)
  BIND(CONCAT("semantic-jira:", ?rootName, ":", ?orderId) AS ?replayIdentity)
  BIND(IRI(CONCAT(STR(?order), "-court")) AS ?court)
  BIND(CONCAT(?orderId, " court") AS ?courtLabel)
  BIND(CONCAT("The court of ", ?gateName, COALESCE(CONCAT(" (", ?gateCourtCommand, ")"), ""),
              " observes the postcondition of ", ?subject,
              " on the exact subject and records its exit status in an R-schema receipt.") AS ?courtDescription)
  BIND(IRI(CONCAT(STR(?order), "-action")) AS ?action)
  BIND(CONCAT("Run the ", ?orderId, " court") AS ?actionLabel)
  BIND(CONCAT("Run the ", ?gateName, " court for ", ?subject,
              " and write a receipt whose identity.subject names that proposition.") AS ?actionDescription)
  BIND(COALESCE(?hintAcceptance, IRI(CONCAT(STR(?order), "-acceptance"))) AS ?acceptance)
  BIND(IF(BOUND(?hintAcceptance), ?unbound, ?acceptance) AS ?madeAcceptance)
  BIND(CONCAT(?orderId, " acceptance") AS ?acceptanceLabel)
  BIND(CONCAT("An independent observation of the exact subject shows: ", ?postcondition) AS ?acceptanceDescription)
  BIND(COALESCE(?hintFalsifier, IRI(CONCAT(STR(?order), "-falsifier"))) AS ?falsifier)
  BIND(IF(BOUND(?hintFalsifier), ?unbound, ?falsifier) AS ?madeFalsifier)
  BIND(CONCAT(?orderId, " falsifier") AS ?falsifierLabel)
  BIND(CONCAT("A receipt naming ", ?subject, " claims ALIVE while an independent observation of the exact subject contradicts: ",
              ?postcondition) AS ?falsifierDescription)
  BIND(COALESCE(?hintCapability, "construct:unassigned") AS ?capabilityId)
  OPTIONAL {
    ?goalCapability a sj:Capability ;
                    sj:capabilityId ?capabilityId .
  }
  BIND(COALESCE(?goalCapability, IRI(CONCAT(?ns, "cap-", SUBSTR(SHA256(?capabilityId), 1, 16)))) AS ?capability)
  BIND(IF(BOUND(?goalCapability), ?unbound, ?capability) AS ?madeCapability)
  BIND(CONCAT("Capability ", ?capabilityId) AS ?capabilityLabel)
  BIND(IF(?capabilityId = "construct:unassigned",
          "UNKNOWN: no capability hint was admitted for the proposition; capability-to-provider resolution stays UNKNOWN until a capability is admitted. Naming it grants no authority.",
          CONCAT("Capability ", ?capabilityId, " named by an admitted proposition hint; provider resolution belongs to the executor registry. Naming it grants no authority.")) AS ?capabilityDescription)
  BIND(IF(?capabilityId = "construct:unassigned" && !BOUND(?goalCapability), ?capability, ?unbound) AS ?unknownCapability)
}
