# Cold bootstrap (GC23-1, lane V23-B): rows of a GC23-11 fleet matrix (xaas
# docs/sjira/<version>/fleet/matrix.ttl, generated by fleet_matrix.py; its
# terms are declared by the fleet vocabulary.ttl there, not by this pack).
# The recorded observedSha is a durable observation; the bootstrap observes
# live HEADs only for rows required by the checkpoint (bounded state, PRD
# section 10) and for explicit --checkout overrides.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?row ?name ?path ?class ?required ?recorded_sha WHERE {
  ?row a sj:FleetMatrixRow ;
       dcterms:identifier ?name .
  OPTIONAL { ?row sj:repositoryPath ?path . }
  OPTIONAL { ?row sj:fleetClass ?class . }
  OPTIONAL { ?row sj:requiredForCheckpoint ?required . }
  OPTIONAL { ?row sj:observedSha ?recorded_sha . }
}
