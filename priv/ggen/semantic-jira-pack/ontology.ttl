    dcterms:description "Deterministic jira/markdown ticket projection; authority is NONE." ;
    sj:projectionType "jira" ;
    sj:extension "md" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" .

