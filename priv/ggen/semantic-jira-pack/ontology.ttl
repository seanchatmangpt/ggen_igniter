# ---- HANDWRITTEN ledger: UNSUPPORTED(generator, element) row ----
# Law: priv/ggen/dfcm-agent-pack/ontology.ttl (DfCM hand-writing gate).
# Ledger entry: HANDWRITTEN.md (repo root). Ledger shrinks monotonically;
# paydown = admit a pack-integration-proof test generator, then retire both rows.
sj:ledger-unsupported-001 a rdfs:Resource ;
    rdfs:label "UNSUPPORTED(semantic-jira-pack, integration-proof-test)" ;
    dcterms:description "UNSUPPORTED(semantic-jira-pack, integration-proof-test): no admitted generator expresses the Chicago-style, no-mock ExUnit integration proof of this pack's own sync -> admission -> actuation -> receipt pipeline (real filesystem, real nested mix compile, durable receipts, byte-identical replay). The existing test-manufacturing families (beam4pm-bench-pack, chicago-fault-injection-pack) manufacture domain-specific benchmark/fault-injection specs, and pack gates verify admission data rather than end-to-end pipeline behaviour, so test/ggen_igniter_semantic_jira_pack_test.exs is admitted hand-authored residue. Paydown plan: extend the test-manufacturing family with a pack-integration-proof generator (ontology facts + template over the pack manifest/gates); when admitted, this row and its HANDWRITTEN.md entry retire." ;
    dcterms:date "2026-09-19"^^xsd:date ;
    dcterms:references <https://ggen-igniter.dev/ontology/semantic-jira#pack-integration-proof-test> .

# ── A2A (agent-to-agent) projection: pack-local vocabulary ─────────────────
# No public RDF ontology for the A2A protocol was found (UNVERIFIED: a search,
# not a proof of absence), so this pack declares the minimum `a2a:` vocabulary
# it needs. Wire values of a2a:TaskState individuals follow the A2A v0.3 task
# lifecycle. This graph is the SOURCE; the Ash/ash_a2a surface is a generated
# projection of it (a2a_manufacture.ex.eex -> the real ash.gen.* generators + ash_a2a.install)
# and the AgentCard is a golden projection (a2a_agent_card.json.eex). Authority
# of every a2a projection is NONE: task state is never standing.

@prefix a2a: <https://ggen-igniter.dev/ontology/a2a#> .
@prefix gi: <https://ggen-igniter.dev/ontology/ggen-igniter#> .

a2a:Task a rdfs:Class ; rdfs:label "A2A task" .
a2a:Skill a rdfs:Class ; rdfs:label "A2A skill" .
a2a:AgentCard a rdfs:Class ; rdfs:label "A2A agent card" .
a2a:TaskState a rdfs:Class ; rdfs:label "A2A task state" .
a2a:StateMapping a rdfs:Class ; rdfs:label "Standing to task-state mapping" .
gi:GeneratorCapability a rdfs:Class ; rdfs:label "Generator capability" .

sj:WorkOrder rdfs:subClassOf a2a:Task .
sj:Action rdfs:subClassOf a2a:Skill .

a2a:stateValue a rdf:Property ; rdfs:range xsd:string .
a2a:fromStanding a rdf:Property ; rdfs:range xsd:string .
a2a:toState a rdf:Property .
a2a:reasonCode a rdf:Property ; rdfs:range xsd:string .
a2a:withReceipt a rdf:Property ; rdfs:range xsd:boolean .
a2a:skillName a rdf:Property ; rdfs:range xsd:string .
a2a:ashAction a rdf:Property ; rdfs:range xsd:string .
a2a:consequence a rdf:Property ; rdfs:range xsd:string .
a2a:exposed a rdf:Property ; rdfs:range xsd:boolean .
a2a:generatedBy a rdf:Property .
a2a:requiresCapability a rdf:Property ; rdfs:range xsd:string .
a2a:forbidsCapability a rdf:Property ; rdfs:range xsd:string .
a2a:refusalReason a rdf:Property ; rdfs:range xsd:string .
gi:mixTask a rdf:Property ; rdfs:range xsd:string .
gi:standing a rdf:Property ; rdfs:range xsd:string .
gi:refusalReason a rdf:Property ; rdfs:range xsd:string .

a2a:state-submitted a a2a:TaskState ; a2a:stateValue "submitted" .
a2a:state-working a a2a:TaskState ; a2a:stateValue "working" .
a2a:state-input-required a a2a:TaskState ; a2a:stateValue "input-required" .
a2a:state-auth-required a a2a:TaskState ; a2a:stateValue "auth-required" .
a2a:state-completed a a2a:TaskState ; a2a:stateValue "completed" .
a2a:state-canceled a a2a:TaskState ; a2a:stateValue "canceled" .
a2a:state-failed a a2a:TaskState ; a2a:stateValue "failed" .
a2a:state-rejected a a2a:TaskState ; a2a:stateValue "rejected" .

# standing -> a2a:state. Standing is the source of truth; the state is derived
# and never read back to infer standing. ALIVE reaches `completed` only with a
# durable receipt; UNSUPPORTED and REFUSED are both `rejected` but keep
# distinct reason codes (UNSUPPORTED != REFUSED).
a2a:map-unknown a a2a:StateMapping ; a2a:fromStanding "UNKNOWN" ; a2a:toState a2a:state-submitted ; a2a:reasonCode "UNKNOWN" .
a2a:map-partial-alive a a2a:StateMapping ; a2a:fromStanding "PARTIAL_ALIVE" ; a2a:toState a2a:state-working ; a2a:reasonCode "PARTIAL_ALIVE" .
a2a:map-alive-receipted a a2a:StateMapping ; a2a:fromStanding "ALIVE" ; a2a:withReceipt true ; a2a:toState a2a:state-completed ; a2a:reasonCode "ALIVE_RECEIPTED" .
a2a:map-alive-unreceipted a a2a:StateMapping ; a2a:fromStanding "ALIVE" ; a2a:withReceipt false ; a2a:toState a2a:state-working ; a2a:reasonCode "ALIVE_UNRECEIPTED" .
a2a:map-blocked a a2a:StateMapping ; a2a:fromStanding "BLOCKED" ; a2a:toState a2a:state-failed ; a2a:reasonCode "BLOCKED" .
a2a:map-build-broken a a2a:StateMapping ; a2a:fromStanding "BUILD_BROKEN" ; a2a:toState a2a:state-failed ; a2a:reasonCode "BUILD_BROKEN" .
a2a:map-refused a a2a:StateMapping ; a2a:fromStanding "REFUSED" ; a2a:toState a2a:state-rejected ; a2a:reasonCode "REFUSED" .
a2a:map-unsupported a a2a:StateMapping ; a2a:fromStanding "UNSUPPORTED" ; a2a:toState a2a:state-rejected ; a2a:reasonCode "UNSUPPORTED" .

# Generator capability rows: what the real upstream generator can and cannot emit.
gi:ash-a2a-install a gi:GeneratorCapability ;
    gi:mixTask "ash_a2a.install" ;
    gi:standing "ALIVE" ;
    dcterms:description "Adds extensions: [AshA2A] to the target resource/domain and an a2a block. Public actions become skills by default: :read -> observe, :create/:update/:destroy -> change." .

gi:ash-a2a-consequence-override a gi:GeneratorCapability ;
    gi:mixTask "ash_a2a.install" ;
    gi:standing "UNSUPPORTED" ;
    gi:refusalReason "UNSUPPORTED(generator-capability): ash_a2a.install cannot emit an explicit a2a skill consequence: :external_do override, so no external_do skill is manufactured; it is never hand-written." ;
    dcterms:description "external_do skills require an explicit consequence declaration that the installer does not emit." .

# Skills. An sj:Action is a skill only when a2a:exposed true and a generator
# capability admits it; forbidden capabilities are recorded as refusals.
sj:observe-work-order a sj:Action ;
    rdfs:label "Observe work order" ;
    dcterms:description "Read admitted semantic work-order tasks without consequence." ;
    a2a:skillName "observe_work_order" ;
    a2a:ashAction "read" ;
    a2a:consequence "observe" ;
    a2a:exposed true ;
    a2a:generatedBy gi:ash-a2a-install .

sj:record-court-receipt a sj:Action ;
    rdfs:label "Record court receipt" ;
    dcterms:description "Record an exact-head court receipt against a work-order task; consequence-bearing, requires an authority grant." ;
    a2a:skillName "record_court_receipt" ;
    a2a:ashAction "create" ;
    a2a:consequence "change" ;
    a2a:exposed true ;
    a2a:generatedBy gi:ash-a2a-install .

sj:run-exact-head-court
    a2a:skillName "run_exact_head_court" ;
    a2a:ashAction "update" ;
    a2a:consequence "external_do" ;
    a2a:exposed false ;
    a2a:generatedBy gi:ash-a2a-consequence-override ;
    a2a:refusalReason "UNSUPPORTED(generator-capability): external_do consequence cannot be manufactured by ash_a2a.install." .

sj:push-candidate a sj:Action ;
    rdfs:label "Push candidate" ;
    dcterms:description "Push a candidate branch; forbidden capability, never a skill." ;
    a2a:skillName "push_candidate" ;
    a2a:ashAction "update" ;
    a2a:consequence "change" ;
    a2a:exposed false ;
    a2a:requiresCapability "Push" ;
    a2a:generatedBy gi:ash-a2a-install ;
    a2a:refusalReason "REFUSED(forbidden-capability): Push" .

sj:publish-candidate a sj:Action ;
    rdfs:label "Publish candidate" ;
    dcterms:description "Publish a candidate; forbidden capability, never a skill." ;
    a2a:skillName "publish_candidate" ;
    a2a:ashAction "update" ;
    a2a:consequence "change" ;
    a2a:exposed false ;
    a2a:requiresCapability "Publish" ;
    a2a:generatedBy gi:ash-a2a-install ;
    a2a:refusalReason "REFUSED(forbidden-capability): Publish" .

sj:projection-a2a-card a sj:ProjectionSpec ;
    rdfs:label "A2A AgentCard and Ash projection" ;
    dcterms:description "Golden AgentCard plus a composed Ash/ash_a2a manufacture task; authority is NONE." ;
    sj:projectionType "a2a_agent_card" ;
    sj:extension "json" ;
    sj:generatorIdentity "ggen_igniter:semantic-jira-pack@26.9.19" ;
    sj:authorityClaim "NONE" ;
    a2a:forbidsCapability "Push", "Publish" .

# Manufacture target: the Ash surface that the composed real generators
# (ash.gen.domain, ash.gen.resource with the ets extension, ash_a2a.install) produce. The
# ontology stores FACTS (module names, attribute names/types/flags); the
# generator argv is derived from them by the template, never stored here.
a2a:ManufactureTarget a rdfs:Class ; rdfs:label "A2A manufacture target" .
a2a:ResourceAttribute a rdfs:Class ; rdfs:label "Manufactured resource attribute" .
a2a:otpApp a rdf:Property ; rdfs:range xsd:string .
a2a:domainModule a rdf:Property ; rdfs:range xsd:string .
a2a:resourceModule a rdf:Property ; rdfs:range xsd:string .
a2a:taskName a rdf:Property ; rdfs:range xsd:string .
a2a:agentName a rdf:Property ; rdfs:range xsd:string .
a2a:attributeOf a rdf:Property .
a2a:attributeName a rdf:Property ; rdfs:range xsd:string .
a2a:attributeType a rdf:Property ; rdfs:range xsd:string .
a2a:isPublic a rdf:Property ; rdfs:range xsd:boolean .
a2a:isRequired a rdf:Property ; rdfs:range xsd:boolean .

sj:a2a-target a a2a:ManufactureTarget ;
    a2a:otpApp "semantic_jira" ;
    a2a:domainModule "SemanticJira.Work" ;
    a2a:resourceModule "SemanticJira.Work.Task" ;
    a2a:taskName "semantic_jira.a2a.manufacture" ;
    a2a:agentName "semantic_jira_agent" .

sj:a2a-attr-task-id a a2a:ResourceAttribute ; a2a:attributeOf sj:a2a-target ; a2a:attributeName "task_id" ; a2a:attributeType "string" ; a2a:isPublic true ; a2a:isRequired true .
sj:a2a-attr-standing a a2a:ResourceAttribute ; a2a:attributeOf sj:a2a-target ; a2a:attributeName "standing" ; a2a:attributeType "string" ; a2a:isPublic true ; a2a:isRequired true .
sj:a2a-attr-replay-identity a a2a:ResourceAttribute ; a2a:attributeOf sj:a2a-target ; a2a:attributeName "replay_identity" ; a2a:attributeType "string" ; a2a:isPublic true ; a2a:isRequired false .
sj:a2a-attr-receipt-digest a a2a:ResourceAttribute ; a2a:attributeOf sj:a2a-target ; a2a:attributeName "receipt_digest" ; a2a:attributeType "string" ; a2a:isPublic true ; a2a:isRequired false .

# ── Friday GoalCheckpoint vocabulary (GC-FRI-0800, v26.9.22 G4) ────────────
# Shared vocabulary contract for the Friday Stop Court: the xaas goal graph
# (docs/sjira/v26.9.22/friday/goal.ttl), the SA2A tuple-digest court, and the
# `mix xaas.stop_court` runner use EXACTLY these IRIs. Additive only: a
# WorkOrder without sj:checkpointOf is not required to carry any of them
# (shapes/work-order.shacl.ttl FridayWorkOrderShape targets the subjects of
# sj:checkpointOf only), so every pre-Friday order admits unchanged.
#
# Tuple digest (T4/T5 contract): "sha256:" + hex(sha256(canonical JSON)) of
#   {subject, postcondition, capability, evidence_ceiling, authority_ceiling,
#    consequence_class, exclusions}
# with keys sorted, compact separators, exclusions sorted; capability is the
# sj:capabilityId string of the order's sj:requiresCapability node. sj:exclusion
# is 0..n: an order with no sj:exclusion digests exclusions = [].
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gall: <http://seanchatmangpt.github.io/packs/gall-core#> .

# owl:equivalentClass to gall-core is an annotation-level mapping only:
# gall-core is NOT imported here, and gall-core itself types
# gall:SemanticCheckpoint as a gall:CheckpointArchetype individual (OWL 2
# punning), so no validator or gate in this pack reasons over the triple.
sj:GoalCheckpoint a rdfs:Class ;
    rdfs:subClassOf sj:Checkpoint, sj:CodeWorkAuthority ;
    owl:equivalentClass gall:SemanticCheckpoint ;
    rdfs:label "Goal checkpoint" ;
    rdfs:comment "A finite goal-graph checkpoint closed by a court. A non-root GoalCheckpoint (one with sj:checkpointOf) carries a runnable sj:courtCommand and a sj:boundaryClass; the root carries sj:stopQuery, a SPARQL ASK over receipts that is true only when STOP holds." .

sj:BoundaryClass a rdfs:Class ;
    rdfs:label "Goal boundary class" ;
    rdfs:comment "Closed enumeration of where a checkpoint sits relative to the goal boundary: sj:Bootstrap, sj:FirstMile, sj:Core, sj:LastMile, sj:Successor." .

sj:Capability a rdfs:Class ;
    rdfs:label "Required capability" ;
    rdfs:comment "A capability a WorkOrder requires, named by sj:capabilityId (for example \"recipe:mix-format\"). Capability-to-provider resolution belongs to the executor's registry, never to this graph; naming a capability grants no authority." .

sj:Bootstrap a sj:BoundaryClass ;
    rdfs:label "Bootstrap" ;
    dcterms:description "Work that makes the goal graph itself executable before any product consequence exists." .
sj:FirstMile a sj:BoundaryClass ;
    rdfs:label "First mile" ;
    dcterms:description "Work that turns accepted prose and inputs into admitted semantic structure." .
sj:Core a sj:BoundaryClass ;
    rdfs:label "Core" ;
    dcterms:description "Work on the steady-state KNOWN path that the stop predicate requires to be ALIVE." .
sj:LastMile a sj:BoundaryClass ;
    rdfs:label "Last mile" ;
    dcterms:description "Work that qualifies, replays, and hands off already-manufactured consequences." .
sj:Successor a sj:BoundaryClass ;
    rdfs:label "Successor" ;
    dcterms:description "Work typed out of this goal and deferred to a successor checkpoint; it cannot hold the goal open." .

sj:checkpointOf a rdf:Property ;
    rdfs:range sj:GoalCheckpoint ;
    rdfs:comment "Child GoalCheckpoint or WorkOrder -> parent GoalCheckpoint. On a WorkOrder, presence opts the order into the full Friday tuple." .
sj:boundaryClass a rdf:Property ; rdfs:range sj:BoundaryClass .
sj:courtCommand a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "A runnable shell command; its exit status is the checkpoint's court verdict." .
sj:stopQuery a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "A SPARQL ASK over receipts that computes the goal's STOP predicate." .
sj:successorOf a rdf:Property ;
    rdfs:domain sj:GoalCheckpoint ;
    rdfs:range sj:GoalCheckpoint ;
    rdfs:comment "Successor GoalCheckpoint -> predecessor GoalCheckpoint." .

sj:postcondition a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Observable predicate that holds after the order's consequence." .
sj:requiresCapability a rdf:Property ; rdfs:range sj:Capability .
sj:capabilityId a rdf:Property ;
    rdfs:domain sj:Capability ;
    rdfs:range xsd:string ;
    rdfs:comment "provider:id, grammar ^[a-z0-9][a-z0-9_.-]*:[a-z0-9][a-z0-9_.:-]*$ -- identical to the SA2A route capability grammar (xaas lib/xaas/sa2a/route.ex @capability), so the G4 SHACL court and the G5 tuple-digest hop admit the same ids." .
sj:evidenceHorizon a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "The furthest evidence this order may claim inside the goal (bounded evidence horizon)." .
sj:exclusion a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:seeAlso gall:Exclusion ;
    rdfs:comment "A premise explicitly not adopted by this order; it must not re-enter the tuple. Cardinality 0..n: a Friday order may carry none (its tuple digest then has exclusions = []); each one present is a non-blank xsd:string." .
sj:consequenceClass a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "One of the receipt-class vocabulary values (GgenIgniter.SemanticJira.receipt_classes/0)." .
sj:successorPolicy a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "What happens to residual work when this order closes or is typed out of the goal." .

# MachineExperience RDF form: one property per field manufactured by
# GgenIgniter.SemanticJira.machine_experience/1 (subject, work_order_digest,
# execution_receipt_hash, observation_refs, verification_digest,
# resulting_state_digest, replay_identity, standing CANDIDATE, authority NONE,
# experience_digest). sj:subject/sj:workOrderDigest/sj:replayIdentity/
# sj:standing/sj:authorityClaim are reused from the fabric vocabulary above.
sj:executionReceiptHash a rdf:Property ; rdfs:range xsd:string .
sj:observationRef a rdf:Property ; rdfs:range xsd:string .
sj:verificationDigest a rdf:Property ; rdfs:range xsd:string .
sj:resultingStateDigest a rdf:Property ; rdfs:range xsd:string .
sj:experienceDigest a rdf:Property ; rdfs:range xsd:string .

# ---- HANDWRITTEN ledger: UNSUPPORTED(generator, element) row ----
sj:ledger-unsupported-002 a rdfs:Resource ;
    rdfs:label "UNSUPPORTED(semantic-jira-pack, goal-checkpoint-admission-proof-test)" ;
    dcterms:description "UNSUPPORTED(generator-capability): no admitted generator manufactures the Chicago-style SHACL admission proof for the Friday GoalCheckpoint vocabulary (valid goal graph admits, per-tuple-field mutation table refuses, root stopQuery law, legacy orders unaffected), so test/ggen_igniter_semantic_jira_goal_checkpoint_test.exs and its fixture test/fixtures/semantic-jira-goal-checkpoint/goal.ttl are admitted hand-authored residue. Paydown plan: the pack-integration-proof generator named by sj:ledger-unsupported-001 also emits one mutation-table case per sh:minCount / tuple sh:sparql constraint read from shapes/work-order.shacl.ttl; when admitted, this row and its HANDWRITTEN.md entry retire." ;
    dcterms:date "2026-09-22"^^xsd:date ;
    dcterms:references <https://ggen-igniter.dev/ontology/semantic-jira#pack-integration-proof-test> .

# ── Prose compilation vocabulary (PVOCAB; GC-26.9.23 GC23-0 / GC23-2, lane V23-C) ──
# PRD PR-002..PR-005, ARD sections 5 and 17. A sj:Proposition is one candidate
# (then admitted) semantic proposition extracted from accepted future-state
# prose, bound to its exact source span. Candidate IRIs are
# <goal namespace>P-<first 16 hex of sha256("<sourceSha256>:<start>:<end>:<kind>")>.
# Admission (shapes/proposition.shacl.ttl + GgenIgniter.SemanticJira.Prose)
# complements sj:candidateStanding "UNKNOWN" with sj:admissionDigest on
# admission paths that admit propositions. Since SJ-002 (2026-09-24) observe
# never replaces candidate standing and no admitted-graph -> WorkOrder delta
# exists: observe_prose emits only candidate propositions, never WorkOrders
# (no second LLM interpretation, ARD section 5.5).
sj:Proposition a rdfs:Class ;
    rdfs:label "Semantic proposition" ;
    rdfs:comment "One proposition extracted from accepted prose (ARD section 5.2 kinds), bound to an exact UTF-8 byte span of its source document. Candidate until admitted; the prose itself is never executable authority (PR-001)." .

sj:propositionKind a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "One of Actor Object Role State Transition Capability Trigger Dependency Invariant Exclusion Evidence Authority Postcondition Falsifier Metric Successor (ARD section 5.2)." .
sj:statement a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "One declarative sentence stating the proposition." .
sj:sourceDocument a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "Repository-relative path of the accepted prose the proposition was extracted from." .
sj:sourceSha256 a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "\"sha256:<hex>\" digest of the source document bytes. On a root GoalCheckpoint it binds the goal to the accepted prose it was compiled from." .
sj:sourceStart a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:integer ;
    rdfs:comment "UTF-8 byte offset where the source span starts (inclusive, half-open span)." .
sj:sourceEnd a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:integer ;
    rdfs:comment "UTF-8 byte offset where the source span ends (exclusive); sj:sourceStart < sj:sourceEnd." .
sj:sourceText a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "Exactly the source bytes [sj:sourceStart, sj:sourceEnd) decoded as UTF-8; admission refuses any other value." .
sj:requiredBy a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range sj:GoalCheckpoint ;
    owl:inverseOf sj:requiredProposition ;
    rdfs:comment "The GoalCheckpoint (a gate, or the root) that requires this proposition. Absent means not required. Cardinality 0..1: one required proposition manufactures at most one WorkOrder." .
sj:requiredProposition a rdf:Property ;
    rdfs:domain sj:GoalCheckpoint ;
    rdfs:range sj:Proposition ;
    rdfs:comment "GoalCheckpoint -> proposition it requires (ARD section 6 GoalCheckpoint predicate); inverse of sj:requiredBy." .
sj:successorCheckpoint a rdf:Property ;
    rdfs:domain sj:GoalCheckpoint ;
    rdfs:range sj:GoalCheckpoint ;
    owl:inverseOf sj:successorOf ;
    rdfs:comment "Predecessor GoalCheckpoint -> successor GoalCheckpoint (ARD section 6); inverse of sj:successorOf." .
sj:candidateStanding a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "Always \"UNKNOWN\" on a candidate (ARD section 5.3); admission removes it." .
sj:extractedBy a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "Identity of the extractor that proposed the candidate (for example llm:<model>@<run>); the LLM edge is recorded, never trusted." .
sj:admissionDigest a rdf:Property ;
    rdfs:domain sj:Proposition ;
    rdfs:range xsd:string ;
    rdfs:comment "\"sha256:<hex>\" over the admission context (source, candidates, goal, ontology, shapes and query digests) and the subject's own triples; for admitted propositions it is present exactly when sj:candidateStanding is absent. Carried by admitted propositions AND by admitted sj:CodeWorkAuthority individuals (sj:StrategicObjective, sj:GoalCheckpoint): a work-order origin authority is admitted only while its digest resolves byte-equal in the canonical ontology graph." .

# ---- HANDWRITTEN ledger: UNSUPPORTED(generator, element) row ----
sj:ledger-unsupported-003 a rdfs:Resource ;
    rdfs:label "UNSUPPORTED(semantic-jira-pack, prose-admission-orchestrator)" ;
    dcterms:description "UNSUPPORTED(generator-capability): no admitted generator manufactures the prose observation surface (byte-level provenance binding, SHACL candidate scoping, sorted N-Triples serialization), so lib/ggen_igniter/semantic_jira/prose.ex, lib/mix/tasks/semantic_jira.observe_prose.ex and the Chicago proof test/ggen_igniter_semantic_jira_prose_test.exs with its fixture test/fixtures/semantic-jira-prose/ are admitted hand-authored residue. Observe-only since SJ-002 (2026-09-24): compile_prose was renamed observe_prose and emits only UNKNOWN candidate propositions with sj:authorityClaim \"NONE\"; the receipt-witness projection, the delta conservation twin, and the admitted-graph -> WorkOrder delta query (prose/delta.construct.rq) are excised -- prose originates no code work. The semantic rules themselves are pack data: shapes/proposition.shacl.ttl and prose/*.rq. Paydown plan: move provenance binding into a pack SPARQL function once the admitted sparql engine exposes byte-span access, and extend the pack-integration-proof generator of sj:ledger-unsupported-001 to emit one refusal case per prose/*.rq rule; when admitted, this row and its HANDWRITTEN.md entry retire." ;
    dcterms:date "2026-09-23"^^xsd:date ;
    dcterms:references <https://ggen-igniter.dev/ontology/semantic-jira#pack-integration-proof-test> .

# ── Origin-authority vocabulary (SJ-002, v26.9.24) ──────────────────────────
# A work order's origin resolves to an ADMITTED sj:CodeWorkAuthority
# individual. Admitted = its sj:admissionDigest resolves byte-equal in the
# canonical ontology graph via GgenIgniter.SemanticJira.Authority.verify_origin/3.
# sj:Proposition and its subclasses are never code-work authority; prose
# compiles to candidate propositions only, never WorkOrders.

sj:CodeWorkAuthority a rdfs:Class ;
    rdfs:label "Code work authority" ;
    rdfs:comment "An individual that may originate code work. Admitted = exactly one sj:admissionDigest resolving byte-equal in the canonical ontology graph; sj:Proposition and its subclasses are never code-work authority." .

sj:StrategicObjective a rdfs:Class ;
    rdfs:subClassOf sj:CodeWorkAuthority ;
    rdfs:label "Strategic objective" ;
    rdfs:comment "Long-horizon code-work authority spanning many work orders; admitted as a whole, not per order." .

# STANDALONE by resolution R3: deliberately NOT a sj:Proposition subclass --
# a prose observation originates no work order; it is provenance, never
# authority.
sj:ProseObservation a rdfs:Class ;
    rdfs:label "Prose observation" ;
    rdfs:comment "An observation extracted from prose; a candidate proposition carrying sj:candidateStanding \"UNKNOWN\" and sj:authorityClaim \"NONE\"; may be cited by sj:originObservation; originates no work order." .

sj:originAuthority a rdf:Property ;
    rdfs:domain sj:WorkOrder ;
    rdfs:range sj:CodeWorkAuthority ;
    rdfs:comment "Exactly one per WorkOrder, enforced by WorkOrderOriginShape; refused when missing, untyped, proposition-typed, or without a verifying sj:admissionDigest." .

sj:originObservation a rdf:Property ;
    rdfs:domain sj:WorkOrder ;
    rdfs:range sj:ProseObservation ;
    rdfs:comment "Optional, at most one; provenance never authority." .

sj:objective-semantic-jira-mvp a sj:StrategicObjective ;
    rdfs:label "Semantic Jira MVP strategy" ;
    dcterms:description "Canonical RDF work-order graph, SHACL admission court, typed receipts; origin of SJ-001; projects work from admitted graph state, never from generated Markdown." ;
    sj:admissionDigest "sha256:7b3b5c6c16552d5e9eefbb070f8c10182b86034733aa018d1c57c6880f8bfb1f" .

sj:objective-project-manufacturer a sj:StrategicObjective ;
    rdfs:label "Project manufacturer strategy" ;
    dcterms:description "Receipt-replayable GALL checkpoint ladder, every rung closes through an independent exact-subject court and survives byte-identical replay; origin of GALL-001..032." ;
    sj:admissionDigest "sha256:639c07b80d557781fc76da0820feb43ac8b3161d527ccbb147533b7e645af0f8" .

sj:objective-code-work-authority a sj:StrategicObjective ;
    rdfs:label "Code work originates from admitted semantic authority" ;
    dcterms:description "All code work originates from admitted semantic authority in the canonical graph; agents communicate only through sJira state; prose, chat, and Markdown are observation surfaces, never work authority." ;
    sj:admissionDigest "sha256:310e14f1e30a9bb4d6ebd4388036e10ce3c973b13c0d45a7b550fa3dfd53c72c" .

sj:review-26924-prose-authority a sj:ProseObservation ;
    rdfs:label "2026-09-24 exact-head architecture review: prose-to-WorkOrder edge" ;
    dcterms:description "The review found the prose-to-WorkOrder edge (prose/delta.construct.rq) granting prose manufactured-order authority; this observation itself originated no code work; it only surfaces the need SJ-002's admitted origin authority covers." .

sj:sj-002 a sj:WorkOrder ;
    dcterms:identifier "SJ-002" ;
    dcterms:title "Prose never originates code work; typed-and-admitted origin authority" ;
    dcterms:description "The prose-to-WorkOrder edge is removed (prose/delta.construct.rq deleted; observe_prose emits only UNKNOWN candidate propositions with sj:authorityClaim \"NONE\"); WorkOrderOriginShape enforces the origin type law, the admission-witness law, and the anti-prose falsifier; the kernel requires origin_authority; observation candidates are lawful only when authority-bound (invariant A)." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "292e40ab08a250ef3f049f9a80b4a65e332d9155" ;
    sj:subject "semantic-jira:sj-002-origin-authority" ;
    sj:pathScope "priv/ggen/semantic-jira-pack", "lib/ggen_igniter/semantic_jira" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Exact subject, typed dependencies, independent court, evidence, receipt classes, acceptance, falsifier, and replay must close; predecessor standing is not inherited." ;
    sj:replayIdentity "semantic-jira:v26.9.24:SJ-002" ;
    sj:originAuthority sj:objective-code-work-authority ;
    sj:originObservation sj:review-26924-prose-authority ;
    sj:requiresCourt sj:court-sj-002 ;
    sj:requiresEvidence sj:source-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:acceptance sj:acceptance-sj-002 ;
    sj:falsifier sj:falsifier-sj-002 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a ;
    sj:nextAction sj:run-sj-002-court ;
    sj:nextCheckpoint sj:sj-002-checkpoint .

sj:court-sj-002 a sj:Court ;
    rdfs:label "SJ-002 exact-subject court" ;
    dcterms:description "Independent court for typed-and-admitted origin authority; execution binds exact head, validator/tool/environment, required evidence, and receipt identity." .

sj:acceptance-sj-002 a sj:AcceptanceCriterion ;
    rdfs:label "SJ-002 acceptance" ;
    dcterms:description "observe_prose emits zero WorkOrders; WorkOrderOriginShape refuses missing-origin, typed-unadmitted-origin, and proposition-origin orders and admits witness-carrying authority origins; observation candidates refuse without admitted origin; full pack sync green on exact head." .

sj:falsifier-sj-002 a sj:Falsifier ;
    rdfs:label "SJ-002 falsifier" ;
    dcterms:description "A fresh sj:StrategicObjective declared beside a WorkOrder in a candidate graph — even with a forged well-formed admissionDigest — is admitted, or observe_prose produces orders.ttl, or a WorkOrder without sj:originAuthority is admitted." .

sj:run-sj-002-court a sj:Action ;
    rdfs:label "Run SJ-002 court" ;
    dcterms:description "Execute the narrowest repository-native court; preserve failure evidence and never blindly rerun an unchanged failure." .

sj:sj-002-checkpoint a sj:Checkpoint ;
    rdfs:label "SJ-002 checkpoint" ;
    dcterms:description "SJ-002 gates green on exact head." .
