@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ggen:pack:semantic-jira-pack>
    a gp:Pack ;
    gp:name "semantic-jira-pack" ;
    gp:version "26.9.19" ;
    gp:profile gp:Core1 .

# Canonical semantic work-order graph for the Semantic Jira projection pack.
# Markdown tickets are consequences of this graph; edit this graph (or an
# explicitly supplied --ontology override), never a generated ticket.

sj:WorkOrder a rdfs:Class ;
    rdfs:label "Semantic Jira work order" ;
    rdfs:comment "Canonical semantic unit projected into Jira-shaped Markdown." .

sj:Court a rdfs:Class ; rdfs:label "Verification court" .
sj:EvidenceRequirement a rdfs:Class ; rdfs:label "Evidence requirement" .
sj:AcceptanceCriterion a rdfs:Class ; rdfs:label "Acceptance criterion" .
sj:Falsifier a rdfs:Class ; rdfs:label "Falsifier" .
sj:Action a rdfs:Class ; rdfs:label "Next action" .
sj:Checkpoint a rdfs:Class ; rdfs:label "Checkpoint" .
sj:Projection a rdfs:Class ; rdfs:label "Projection" .

sj:repository a rdf:Property ; rdfs:range xsd:string .
sj:baseSha a rdf:Property ; rdfs:range xsd:string .
# Opt-in per-order git ground truth: `sj:requiresGitGroundTruth true` on a
# WorkOrder makes its baseSha verify against a real git work tree (commit
# exists AND is reachable from HEAD) even without the sync task's opt-in
# --verify-base-sha flag. Never default-on: the canonical fabric set carries
# baseSha values that need not exist in every consumer checkout.
sj:requiresGitGroundTruth a rdf:Property ; rdfs:range xsd:boolean .
sj:subject a rdf:Property ; rdfs:range xsd:string .
sj:standing a rdf:Property ; rdfs:range xsd:string .
sj:evidenceCeiling a rdf:Property ; rdfs:range xsd:string .
sj:authorityCeiling a rdf:Property ; rdfs:range xsd:string .
sj:promotionRule a rdf:Property ; rdfs:range xsd:string .
sj:replayIdentity a rdf:Property ; rdfs:range xsd:string .
sj:dependsOn a rdf:Property .
sj:requiresCourt a rdf:Property .
sj:requiresEvidence a rdf:Property .
sj:acceptance a rdf:Property .
sj:falsifier a rdf:Property .
sj:nextCheckpoint a rdf:Property .
sj:nextAction a rdf:Property .
sj:projection a rdf:Property .
sj:receipt a rdf:Property .

# Self-dogfood work order: this pack manufactures its own first Jira projection.
sj:semantic-jira-mvp a sj:WorkOrder ;
    dcterms:identifier "SJ-001" ;
    dcterms:title "Manufacture Semantic Jira work orders from RDF" ;
    dcterms:description "Project admitted semantic work orders into deterministic Markdown without granting the projection execution authority." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "d84da1419a6945c6a8a64b8f6cdca9d0b2c9e0f3" ;
    sj:subject "semantic-jira-pack:work-order-projection" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "IMPLEMENTED_UNVERIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:promotionRule "Standing may advance only from an independent exact-head court receipt for the same subject; generated Markdown cannot promote itself." ;
    sj:replayIdentity "semantic-jira:v26.9.19:SJ-001" ;
    sj:requiresCourt sj:exact-head-projection-court ;
    sj:requiresEvidence sj:graph-receipt-evidence ;
    sj:acceptance sj:canonical-source, sj:deterministic-projection, sj:fail-closed-invalid ;
    sj:falsifier sj:missing-required-field-renders, sj:projection-gains-authority ;
    sj:projection sj:markdown-projection ;
    sj:nextAction sj:add-qualified-shacl-court ;
    sj:nextCheckpoint sj:shacl-admission-checkpoint .

sj:exact-head-projection-court a sj:Court ;
    rdfs:label "Exact-head Semantic Jira projection court" ;
    dcterms:description "Run the repository-native pack through the real Reactor path and require an ALIVE GgenIgniter receipt bound to the graph hash and exact branch head." .

sj:graph-receipt-evidence a sj:EvidenceRequirement ;
    rdfs:label "Graph-bound receipt" ;
    dcterms:description "A durable GgenIgniter receipt whose metadata carries the exact semantic graph hash and generated output paths." .

sj:canonical-source a sj:AcceptanceCriterion ;
    rdfs:label "Canonical RDF source" ;
    dcterms:description "The WorkOrder graph is canonical; generated Markdown is a disposable projection and carries no independent authority." .

sj:deterministic-projection a sj:AcceptanceCriterion ;
    rdfs:label "Deterministic projection" ;
    dcterms:description "Re-running the same graph, gates, template, toolchain, and environment produces byte-identical Markdown." .

sj:fail-closed-invalid a sj:AcceptanceCriterion ;
    rdfs:label "Fail closed on invalid work orders" ;
    dcterms:description "Missing required scalar fields, duplicate work-order identifiers, invalid base SHA, invalid standing, or authority above CONSTRUCT prevents actuation." .

sj:missing-required-field-renders a sj:Falsifier ;
    rdfs:label "Missing required field still renders" ;
    dcterms:description "Delete a required WorkOrder field and observe any generated ticket; that observation falsifies admission." .

sj:projection-gains-authority a sj:Falsifier ;
    rdfs:label "Projection gains authority" ;
    dcterms:description "Treat a generated Markdown ticket as authority to actuate, merge, publish, or deploy; that observation falsifies the projection boundary." .

sj:markdown-projection a sj:Projection ;
    rdfs:label "Jira-shaped Markdown projection" ;
    dcterms:description "One generated Markdown file per admitted WorkOrder, intended as a human/tool projection rather than canonical state." .

sj:add-qualified-shacl-court a sj:Action ;
    rdfs:label "Add a qualified SHACL court" ;
    dcterms:description "Integrate a real SHACL validator as an independent admission court rather than renaming SPARQL/template checks as SHACL." .

sj:shacl-admission-checkpoint a sj:Checkpoint ;
    rdfs:label "SHACL admission checkpoint" ;
    dcterms:description "The RFC-required SHACL validation boundary is closed only after a real validator executes and emits independent evidence." .
# ── RFC v26.9.19 DfCM extension: typed work-order fabric ───────────────────
# Semantic contracts only. XaaS/Ultracode owns issued leases; BRCE/CommandBus
# owns consequential DO. Planner output, projections, and evidence do not gain
# ambient authority.

sj:Subject a rdfs:Class ; rdfs:label "Exact semantic subject" .
sj:RepositorySubject a rdfs:Class ; rdfs:label "Repository/base/candidate subject" .
sj:DependencyEdge a rdfs:Class ; rdfs:label "Typed dependency edge" .
sj:ProjectionSpec a rdfs:Class ; rdfs:label "Deterministic projection specification" .
sj:LeaseRequest a rdfs:Class ; rdfs:label "Bounded runtime lease request" .
sj:PreparedAuthorityReceipt a rdfs:Class ; rdfs:label "Prepared authority receipt" .
sj:Actuation a rdfs:Class ; rdfs:label "Consequential actuation" .
sj:Receipt a rdfs:Class ; rdfs:label "Typed durable receipt" .
sj:MachineExperience a rdfs:Class ; rdfs:label "Receipted machine experience" .
sj:ProcessFinding a rdfs:Class ; rdfs:label "Observed process finding" .
sj:RepairLineage a rdfs:Class ; rdfs:label "Failure-to-repair lineage" .
sj:Refusal a rdfs:Class ; rdfs:label "Typed refusal" .
sj:Prediction a rdfs:Class ; rdfs:label "Candidate prediction" .
sj:StandingTransition a rdfs:Class ;
    rdfs:label "Append-only standing transition event" ;
    rdfs:comment "Immutable event binding a work order's standing change to receipt evidence, the exact git head, and both the immutable definition digest and the moving snapshot digest. Current standing is the projection over the event chain, never an in-place mutation." .

sj:candidateSha a rdf:Property ; rdfs:range xsd:string .
sj:subjectSha a rdf:Property ; rdfs:range xsd:string .
sj:pathScope a rdf:Property ; rdfs:range xsd:string .
sj:authorityRequirement a rdf:Property ; rdfs:range xsd:string .
sj:authority a rdf:Property .
sj:lease a rdf:Property .
sj:worker a rdf:Property .
sj:dependencyType a rdf:Property ; rdfs:range xsd:string .
sj:upstreamWorkOrder a rdf:Property .
sj:requiredStanding a rdf:Property ; rdfs:range xsd:string .
sj:requiredReceiptDigest a rdf:Property ; rdfs:range xsd:string .
sj:requiresReceiptClass a rdf:Property ; rdfs:range xsd:string .
sj:projectionType a rdf:Property ; rdfs:range xsd:string .
sj:extension a rdf:Property ; rdfs:range xsd:string .
sj:generatorIdentity a rdf:Property ; rdfs:range xsd:string .
sj:authorityClaim a rdf:Property ; rdfs:range xsd:string .
sj:workOrderDigest a rdf:Property ; rdfs:range xsd:string .
sj:receiptClass a rdf:Property ; rdfs:range xsd:string .
sj:concurrencyKey a rdf:Property ; rdfs:range xsd:string .
sj:active a rdf:Property ; rdfs:range xsd:boolean .
sj:exclusive a rdf:Property ; rdfs:range xsd:boolean .
sj:candidateOnly a rdf:Property ; rdfs:range xsd:boolean .
sj:observedStanding a rdf:Property ; rdfs:range xsd:string .
sj:normativeMutation a rdf:Property ; rdfs:range xsd:boolean .
sj:fromStanding a rdf:Property ; rdfs:range xsd:string .
sj:toStanding a rdf:Property ; rdfs:range xsd:string .

# ---- Event-sourced standing law (v26.9.19) ----
# A WorkOrder's definition is IMMUTABLE: sj:definitionDigest (when present on
# the row) hashes exactly the definition field set -- identity scalars
# (dcterms:identifier/title/description), exact subject binding
# (sj:subject/sj:repository/sj:baseSha), ceilings and law
# (sj:evidenceCeiling/sj:authorityRequirement/sj:promotionRule/
# sj:replayIdentity), required relations (sj:dependsOn/sj:requiresCourt/
# sj:requiresEvidence/sj:requiresReceiptClass/sj:acceptance/sj:falsifier/
# sj:projection), and bounded scope (sj:pathScope) -- EXCLUDING standing,
# candidate SHA, dimensions, and every derived digest. The kernel's exact
# field set lives in GgenIgniter.SemanticJira's @definition_fields.
# sj:workOrderDigest remains the SNAPSHOT digest: it moves when standing
# moves. Standing changes are append-only sj:StandingTransition events:
#   sj:transition-<hash8> a sj:StandingTransition ;
#       sj:transitionId "sha256:<64hex>" ;
#       sj:transitionWorkOrder <wo> ;
#       sj:fromStanding "..." ; sj:toStanding "..." ;
#       sj:transitionEvidence <receipt-iri> ;
#       sj:finalHead "<40-hex>" ;
#       sj:definitionDigest "sha256:<64hex>" ;
#       sj:snapshotDigest "sha256:<64hex>" .
# transitionId is the deterministic hash of (work order id, toStanding,
# evidence identity, final head); a second event with the same id but
# different content refuses (shapes/work-order.shacl.ttl). Current standing
# is a PROJECTION: the chain tip's toStanding per work order (latest event),
# or the declared sj:standing when no transitions exist
# (gates/055_standing_projection.rq; kernel project_standing/1). The
# frontier (gates/050_frontier.rq) consults the projection: a work order
# transitioned away from UNKNOWN is no longer frontier-eligible for the
# same work.
sj:definitionDigest a rdf:Property ; rdfs:range xsd:string .
sj:snapshotDigest a rdf:Property ; rdfs:range xsd:string .
sj:transitionId a rdf:Property ; rdfs:range xsd:string .
sj:transitionWorkOrder a rdf:Property .
sj:transitionEvidence a rdf:Property .
sj:finalHead a rdf:Property ; rdfs:range xsd:string .

sj:source-evidence a sj:EvidenceRequirement ;
    rdfs:label "Source evidence" ;
    dcterms:description "Exact canonical-source identity evidence." .
sj:generated-artifact-evidence a sj:EvidenceRequirement ;
    rdfs:label "Generated artifact evidence" ;
    dcterms:description "Evidence binding a consequence to semantic source and generator." .
sj:local-execution-evidence a sj:EvidenceRequirement ;
    rdfs:label "Local execution evidence" ;
    dcterms:description "Observed repository-local exact-subject execution evidence." .
sj:hosted-ci-evidence a sj:EvidenceRequirement ;
    rdfs:label "Hosted CI evidence" ;
    dcterms:description "Hosted CI evidence kept distinct from local execution." .
sj:runtime-evidence a sj:EvidenceRequirement ;
    rdfs:label "Runtime evidence" ;
    dcterms:description "Runtime execution evidence for the exact admitted subject." .
sj:telemetry-evidence a sj:EvidenceRequirement ;
    rdfs:label "Telemetry evidence" ;
    dcterms:description "Observational telemetry evidence; never normative law by itself." .
sj:process-evidence a sj:EvidenceRequirement ;
    rdfs:label "Process evidence" ;
    dcterms:description "Observed process evidence kept separate from normative specification." .
sj:postcondition-evidence a sj:EvidenceRequirement ;
    rdfs:label "Postcondition evidence" ;
    dcterms:description "Independent evidence that the required consequence holds." .
sj:authority-evidence a sj:EvidenceRequirement ;
    rdfs:label "Authority evidence" ;
    dcterms:description "Prepared authority evidence for a consequential transition." .
sj:receipt-evidence a sj:EvidenceRequirement ;
    rdfs:label "Receipt evidence" ;
    dcterms:description "Durable receipt evidence for the exact subject and transition." .
sj:replay-evidence a sj:EvidenceRequirement ;
    rdfs:label "Replay evidence" ;
    dcterms:description "Fresh replay over pack, dependency, graph, consequence, toolchain, and environment identities." .
sj:publication-evidence a sj:EvidenceRequirement ;
    rdfs:label "Publication evidence" ;
    dcterms:description "Publication evidence distinct from implementation and verification." .

sj:semantic-jira-mvp
    sj:pathScope "priv/ggen/semantic-jira-pack", "lib/ggen_igniter/semantic_jira.ex",
                 "native/ggen_graph_nif" ;
    sj:authorityRequirement "NONE" ;
    sj:requiresReceiptClass "manufacture", "projection", "verification", "replay" ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay .

