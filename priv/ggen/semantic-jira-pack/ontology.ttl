sj:run-exact-head-court a sj:Action ;
    rdfs:label "Run exact-head court" ;
    dcterms:description "Execute an independent exact-subject court and preserve receipts/falsifiers." .
sj:known-retirement-checkpoint a sj:Checkpoint ;
    rdfs:label "KNOWN retirement" ;
    dcterms:description "Fresh replay reconstructs the subject so repeated reasoning can retire to deterministic machinery." .

sj:gall-001 a sj:WorkOrder, sj:Checkpoint ;
    rdfs:label "GALL-001 — Semantic Pack Receipt Replay" ;
    dcterms:identifier "GALL-001" ;
    dcterms:title "Semantic Pack Receipt Replay" ;
    dcterms:description "Semantic pack identity and replayable manufacture are receipted." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "d84da1419a6945c6a8a64b8f6cdca9d0b2c9e0f3" ;
    sj:subject "semantic-jira:gall-001-contract" ;
    sj:pathScope "priv/ggen/semantic-jira-pack" ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Exact subject, typed dependencies, independent court, evidence, receipt classes, acceptance, falsifier, and replay must close; predecessor standing is not inherited." ;
    sj:replayIdentity "semantic-jira:v26.9.19:GALL-001" ;
    sj:originAuthority sj:objective-project-manufacturer ;
    sj:requiresCourt sj:court-gall-001 ;
    sj:requiresEvidence sj:source-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:acceptance sj:acceptance-gall-001 ;
    sj:falsifier sj:falsifier-gall-001 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-gall-001-court ;
    sj:nextCheckpoint sj:gall-002 .

sj:court-gall-001 a sj:Court ;
    rdfs:label "GALL-001 exact-subject court" ;
    dcterms:description "Independent court for Semantic Pack Receipt Replay; execution binds exact head, validator/tool/environment, required evidence, and receipt identity." .

sj:acceptance-gall-001 a sj:AcceptanceCriterion ;
    rdfs:label "GALL-001 acceptance" ;
    dcterms:description "Semantic pack identity and replayable manufacture are receipted. Direct evidence is required; adjacency is insufficient." .

sj:falsifier-gall-001 a sj:Falsifier ;
    rdfs:label "GALL-001 falsifier" ;
    dcterms:description "Subject, receipt, evidence, authority, replay, or contrary-observation mismatch falsifies promotion." .

sj:run-gall-001-court a sj:Action ;
    rdfs:label "Run GALL-001 court" ;
    dcterms:description "Execute the narrowest repository-native court; preserve failure evidence and never blindly rerun an unchanged failure." .

sj:edge-002-from-001 a sj:DependencyEdge ;
    rdfs:label "GALL-002 dependency on GALL-001" ;
    dcterms:description "Typed semantic-identity dependency; runtime may strengthen it with exact receipt/digest identity." ;
    sj:dependencyType "requiresSemanticIdentity" ;
    sj:upstreamWorkOrder sj:gall-001 ;
    sj:requiredStanding "ALIVE" .

sj:gall-002 a sj:WorkOrder, sj:Checkpoint ;
    rdfs:label "GALL-002 — Project Manufacturer Seal" ;
    dcterms:identifier "GALL-002" ;
    dcterms:title "Project Manufacturer Seal" ;
    dcterms:description "Project manufacture is deterministic and bound to canonical semantic input." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "d84da1419a6945c6a8a64b8f6cdca9d0b2c9e0f3" ;
    sj:subject "semantic-jira:gall-002-contract" ;
    sj:pathScope "priv/ggen/semantic-jira-pack" ;
    sj:dependsOn sj:edge-002-from-001 ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
    sj:authorityRequirement "NONE" ;
    sj:promotionRule "Exact subject, typed dependencies, independent court, evidence, receipt classes, acceptance, falsifier, and replay must close; predecessor standing is not inherited." ;
    sj:replayIdentity "semantic-jira:v26.9.19:GALL-002" ;
    sj:originAuthority sj:objective-project-manufacturer ;
    sj:requiresCourt sj:court-gall-002 ;
    sj:requiresEvidence sj:source-evidence, sj:generated-artifact-evidence, sj:local-execution-evidence, sj:receipt-evidence, sj:replay-evidence ;
    sj:requiresReceiptClass "verification", "replay" ;
    sj:acceptance sj:acceptance-gall-002 ;
    sj:falsifier sj:falsifier-gall-002 ;
    sj:projection sj:projection-jira, sj:projection-wbpr, sj:projection-prd, sj:projection-ard, sj:projection-vision, sj:projection-fond, sj:projection-hddl, sj:projection-sa2a, sj:projection-worker, sj:projection-verification, sj:projection-executive, sj:projection-machine, sj:projection-receipt, sj:projection-replay ;
    sj:nextAction sj:run-gall-002-court ;
    sj:nextCheckpoint sj:gall-003 .

sj:court-gall-002 a sj:Court ;
    rdfs:label "GALL-002 exact-subject court" ;
    dcterms:description "Independent court for Project Manufacturer Seal; execution binds exact head, validator/tool/environment, required evidence, and receipt identity." .

sj:acceptance-gall-002 a sj:AcceptanceCriterion ;
    rdfs:label "GALL-002 acceptance" ;
    dcterms:description "Project manufacture is deterministic and bound to canonical semantic input. Direct evidence is required; adjacency is insufficient." .

sj:falsifier-gall-002 a sj:Falsifier ;
    rdfs:label "GALL-002 falsifier" ;
    dcterms:description "Subject, receipt, evidence, authority, replay, or contrary-observation mismatch falsifies promotion." .

sj:run-gall-002-court a sj:Action ;
    rdfs:label "Run GALL-002 court" ;
    dcterms:description "Execute the narrowest repository-native court; preserve failure evidence and never blindly rerun an unchanged failure." .

sj:edge-003-from-002 a sj:DependencyEdge ;
    rdfs:label "GALL-003 dependency on GALL-002" ;
    dcterms:description "Typed semantic-identity dependency; runtime may strengthen it with exact receipt/digest identity." ;
    sj:dependencyType "requiresSemanticIdentity" ;
    sj:upstreamWorkOrder sj:gall-002 ;
    sj:requiredStanding "ALIVE" .

sj:gall-003 a sj:WorkOrder, sj:Checkpoint ;
    rdfs:label "GALL-003 — Command/Authority/Receipt Seal" ;
    dcterms:identifier "GALL-003" ;
    dcterms:title "Command/Authority/Receipt Seal" ;
    dcterms:description "Exact capability, prepared authority, DO, durable receipt, deduplication, crash reconciliation, and replay blocking remain separated." ;
    sj:repository "seanchatmangpt/ggen_igniter" ;
    sj:baseSha "d84da1419a6945c6a8a64b8f6cdca9d0b2c9e0f3" ;
    sj:subject "semantic-jira:gall-003-contract" ;
    sj:pathScope "priv/ggen/semantic-jira-pack" ;
    sj:dependsOn sj:edge-003-from-002 ;
    sj:standing "UNKNOWN" ;
    sj:evidenceCeiling "SPECIFIED" ;
    sj:authorityCeiling "CONSTRUCT" ;
