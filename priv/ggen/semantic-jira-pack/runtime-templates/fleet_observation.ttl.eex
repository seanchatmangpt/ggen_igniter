@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# GENERATED by ggen_igniter: semantic-jira-pack runtime-templates/fleet_observation.ttl.eex
# (mix semantic_jira.observe --fleet). Every sj:GitObservation entity carries the
# sj:observedSha it was read at. Two runs over unchanged repositories differ only
# in the fleet activity's end-time line.

<<%= fleet.iri %>> a prov:Activity, sj:FleetObservation ;
    prov:used <<%= fleet.registry_iri %>> ;
    prov:wasAssociatedWith <urn:ggen-igniter:mix:semantic_jira.observe> ;
    prov:endedAtTime <%= lit.(fleet.ended_at) %>^^xsd:dateTime .
<%= for repo <- repos do %>
<<%= repo.iri %>> a prov:Activity, sj:RepositoryObservation ;
    dcterms:isPartOf <<%= fleet.iri %>> ;
    sj:observedRepository <<%= repo.repository %>> ;
    prov:used <<%= repo.repository %>> ;
    sj:repositoryPath <%= lit.(repo.path) %> ;
<%= if repo.head_sha do %>    sj:observedSha <%= lit.(repo.head_sha) %> ;
<% end %>    sj:observationStatus <%= lit.(repo.status) %> .
<%= for ref <- repo.refs do %>
<<%= ref.iri %>> a prov:Entity, sj:RefObservation ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:refName <%= lit.(ref.name) %> ;
<%= if ref.upstream do %>    sj:upstreamRef <%= lit.(ref.upstream) %> ;
    sj:aheadCount <%= ref.ahead %> ;
    sj:behindCount <%= ref.behind %> ;
    sj:unpushed <%= ref.ahead > 0 %> ;
    sj:fastForwardable <%= ref.ahead == 0 and ref.behind > 0 %> ;
    sj:upstreamGone <%= ref.gone %> ;
<% end %>    sj:observedSha <%= lit.(ref.sha) %> .
<% end %><%= for delta <- repo.deltas do %>
<<%= delta.iri %>> a prov:Entity, sj:RemoteRefDelta ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:remoteName <%= lit.(delta.remote) %> ;
    sj:refName <%= lit.(delta.ref) %> ;
    sj:deltaKind <%= lit.(delta.kind) %> ;
<%= if delta.remote_sha do %>    sj:remoteSha <%= lit.(delta.remote_sha) %> ;
<% end %><%= if delta.tracking_sha do %>    sj:trackingSha <%= lit.(delta.tracking_sha) %> ;
<% end %>    sj:observedSha <%= lit.(delta.sha) %> .
<% end %><%= for wt <- repo.worktrees do %>
<<%= wt.iri %>> a prov:Entity, sj:WorktreeObservation ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:worktreePath <%= lit.(wt.path) %> ;
<%= if wt.branch do %>    sj:branchName <%= lit.(wt.branch) %> ;
<% end %><%= if wt.dirty_count do %>    sj:dirty <%= wt.dirty_count > 0 %> ;
    sj:dirtyEntryCount <%= wt.dirty_count %> ;
<% end %>    sj:observationStatus <%= lit.(wt.status) %> ;
    sj:observedSha <%= lit.(wt.sha) %> .
<% end %><%= for stash <- repo.stashes do %>
<<%= stash.iri %>> a prov:Entity, sj:StashObservation ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:stashRef <%= lit.(stash.ref) %> ;
    sj:stashSubject <%= lit.(stash.subject) %> ;
    sj:observedSha <%= lit.(stash.sha) %> .
<% end %><%= for pr <- repo.pull_requests do %>
<<%= pr.iri %>> a prov:Entity, sj:PullRequestObservation ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:pullRequestNumber <%= pr.number %> ;
    sj:headRefName <%= lit.(pr.head_ref) %> ;
    sj:baseRefName <%= lit.(pr.base_ref) %> ;
    sj:checksConclusion <%= lit.(pr.conclusion) %> ;
    sj:checkCount <%= pr.check_count %> ;
    sj:observedSha <%= lit.(pr.sha) %> .
<% end %><%= for ci <- repo.ci do %>
<<%= ci.iri %>> a prov:Entity, sj:DefaultBranchCiObservation ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:defaultBranch <%= lit.(ci.branch) %> ;
    sj:ciConclusion <%= lit.(ci.conclusion) %> ;
    sj:checkCount <%= ci.check_count %> ;
    sj:observedSha <%= lit.(ci.sha) %> .
<% end %><%= for probe <- repo.probes do %>
<<%= probe.iri %>> a prov:Entity, sj:ProbeOutcome ;
    prov:wasGeneratedBy <<%= repo.iri %>> ;
    sj:probe <%= lit.(probe.probe) %> ;
    sj:probeOutcome <%= lit.(probe.outcome) %> ;
    sj:probeDetail <%= lit.(probe.detail) %> ;
    sj:observedSha <%= lit.(probe.sha) %> .
<% end %><% end %>
