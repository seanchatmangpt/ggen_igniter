# Semantic Jira standing-transition log as PROV-O (rendered by
# GgenIgniter.SemanticJira.Provenance; authority NONE; a serialization of the
# append-only TransitionLog, never a source of standing).
@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Additive mapping onto PROV-O (ADR-011): sj: terms specialise prov: terms.
sj:StandingTransitionEvent a rdfs:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "Standing transition event" .
sj:StandingState a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "Standing state generated by a transition" .
sj:WorkOrderDefinition a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "WorkOrder definition (definition_digest)" .
sj:WorkOrderSnapshot a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "WorkOrder snapshot (snapshot_digest)" .
sj:TransitionReceipt a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "Verified receipt (receipt_digest)" .
sj:AuthorityCeiling a rdfs:Class ; rdfs:subClassOf prov:Agent ;
    rdfs:label "Authority level a transition was admitted under" .
sj:seq a rdf:Property ; rdfs:range xsd:integer .
sj:eventKind a rdf:Property ; rdfs:range xsd:string .
sj:workOrderId a rdf:Property ; rdfs:range xsd:string .
sj:fromStanding a rdf:Property ; rdfs:range xsd:string .
sj:toStanding a rdf:Property ; rdfs:range xsd:string .
sj:transitionDigest a rdf:Property ; rdfs:range xsd:string .
sj:contentSeal a rdf:Property ; rdfs:range xsd:string .
sj:extra a rdf:Property ; rdfs:range xsd:string .
<%= for b <- blocks do %>
<%= b.subject %> a <%= b.types %><%= for {predicate, object} <- b.po do %> ;
    <%= predicate %> <%= object %><% end %> .
<% end %>
