# Exposed A2A skills: sj:Action individuals that are a2a:exposed true, name an
# Ash action, and are generated by an admitted (ALIVE) generator capability.
# Forbidden-capability actions are removed by MINUS (not FILTER NOT EXISTS --
# see 050_frontier.rq for the sparql 0.3.12 limitation), so this gate stays
# correct even if the SHACL court were bypassed.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
PREFIX gi: <https://ggen-igniter.dev/ontology/ggen-igniter#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?action ?skill_name ?ash_action ?consequence ?label ?description WHERE {
  ?action a sj:Action ;
          a2a:skillName ?skill_name ;
          a2a:ashAction ?ash_action ;
          a2a:consequence ?consequence ;
          a2a:exposed true ;
          rdfs:label ?label ;
          dcterms:description ?description ;
          a2a:generatedBy ?generator .
  ?generator gi:standing "ALIVE" .
  MINUS {
    ?action a2a:requiresCapability ?cap .
    ?spec a sj:ProjectionSpec ;
          a2a:forbidsCapability ?cap .
  }
}
ORDER BY ?skill_name
