PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oslc_cm: <http://open-services.net/ns/cm#>
# Dual-path targeting: sj:WorkOrder OR oslc_cm:ChangeRequest typed (public
# carry admits via the public term; legacy sj-only admits unchanged). DISTINCT
# collapses dual-typed rows to one scalar row per work order.
SELECT DISTINCT ?work_order ?id ?title ?description ?repository ?base_sha ?subject
       ?standing ?evidence_ceiling ?authority_ceiling ?promotion_rule ?replay_identity
       ?requires_git_ground_truth
WHERE {
  { ?work_order a sj:WorkOrder }
  UNION
  { ?work_order a oslc_cm:ChangeRequest }
  OPTIONAL { ?work_order dcterms:identifier ?id . }
  OPTIONAL { ?work_order dcterms:title ?title . }
  OPTIONAL { ?work_order dcterms:description ?description . }
  OPTIONAL { ?work_order sj:repository ?repository . }
  OPTIONAL { ?work_order sj:baseSha ?base_sha . }
  OPTIONAL { ?work_order sj:subject ?subject . }
  OPTIONAL { ?work_order sj:standing ?standing . }
  OPTIONAL { ?work_order sj:evidenceCeiling ?evidence_ceiling . }
  OPTIONAL { ?work_order sj:authorityCeiling ?authority_ceiling . }
  OPTIONAL { ?work_order sj:promotionRule ?promotion_rule . }
  OPTIONAL { ?work_order sj:replayIdentity ?replay_identity . }
  # Opt-in git ground truth (sj:requiresGitGroundTruth true): a WorkOrder
  # carrying this triple opts ITSELF into real git verification of its
  # baseSha (GgenIgniter.SemanticJira.GitGroundTruth) even without the sync
  # task's --verify-base-sha flag. Absent triple = no default behavior
  # change, so the canonical fabric set still manufactures unverified.
  OPTIONAL { ?work_order sj:requiresGitGroundTruth ?requires_git_ground_truth . }
}
