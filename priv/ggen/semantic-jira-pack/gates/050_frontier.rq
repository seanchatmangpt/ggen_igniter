# Frontier gate: renderable WorkOrders whose typed dependency edges are satisfied.
# Written with nested MINUS, not FILTER NOT EXISTS: under the locked sparql
# 0.3.12 any FILTER inside an EXISTS group compiles its expression to
# :"$undefined" and crashes (Protocol.UndefinedError). The nested-MINUS form is
# semantically identical here: ?work_order is the only variable shared between
# the outer group and the unsatisfied-edge group, so MINUS removes exactly the
# WorkOrders having an edge whose upstream lacks the required standing.
# Guarded by GgenIgniter.SemanticJiraPackTest "every pack gate executes".
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?work_order ?id ?title ?repository ?base_sha ?subject ?evidence_ceiling WHERE {
  ?work_order a sj:WorkOrder ;
              dcterms:identifier ?id ;
              dcterms:title ?title ;
              sj:repository ?repository ;
              sj:baseSha ?base_sha ;
              sj:subject ?subject ;
              sj:standing "UNKNOWN" ;
              sj:evidenceCeiling ?evidence_ceiling .
  MINUS {
    ?work_order sj:dependsOn ?edge .
    ?edge sj:upstreamWorkOrder ?upstream .
    ?edge sj:requiredStanding ?required .
    MINUS { ?upstream sj:standing ?required }
  }
}
ORDER BY ?id
