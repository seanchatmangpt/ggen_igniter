@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL admission shapes for the semantic-jira-pack work-order graph.
# Executed by GgenIgniter.SemanticJira.Shacl (SHACL-core + sh:sparql
# constraints). Unsupported constructs fail closed there; this file must stay
# inside the supported surface: minCount/maxCount, nodeKind, datatype,
# pattern (flag i), minLength/maxLength, hasValue, class, closed,
# ignoredProperties, and SELECT-only sh:sparql constraints.
# sh:sparql constraint queries express absence checks with
# OPTIONAL + FILTER(!BOUND()) because the admitted sparql engine (0.3.12)
# parses EXISTS/NOT EXISTS filter forms to an unsupported `:"$undefined"`
# expression (measured 2026-09-19); OPTIONAL/BOUND is equivalent and executes.

sj:WorkOrderShape a sh:NodeShape ;
    sh:targetClass sj:WorkOrder ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type rdfs:label ) ;
    sh:property [ sh:path dcterms:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z][A-Z0-9-]{1,63}$" ] ;
    sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path dcterms:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path sj:repository ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" ] ;
    sh:property [ sh:path sj:baseSha ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] ;
    # Opt-in per-order git ground truth (no sh:minCount: absence is the
    # default and changes nothing; presence must be a single boolean).
    sh:property [ sh:path sj:requiresGitGroundTruth ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path sj:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path sj:standing ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(UNKNOWN|PARTIAL_ALIVE|ALIVE|BLOCKED|BUILD_BROKEN|UNSUPPORTED|REFUSED\\(.+\\))$" ] ;
    sh:property [ sh:path sj:evidenceCeiling ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sj:authorityCeiling ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(OBSERVE|SELECT|CONSTRUCT)$" ] ;
    sh:property [ sh:path sj:promotionRule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path sj:replayIdentity ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path sj:pathScope ; sh:minCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path sj:authorityRequirement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sj:dependsOn ; sh:nodeKind sh:IRI ; sh:class sj:DependencyEdge ] ;
    sh:property [ sh:path sj:requiresCourt ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:Court ] ;
    sh:property [ sh:path sj:requiresEvidence ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:EvidenceRequirement ] ;
    sh:property [ sh:path sj:acceptance ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:AcceptanceCriterion ] ;
    sh:property [ sh:path sj:falsifier ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:Falsifier ] ;
    sh:property [ sh:path sj:projection ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sj:nextAction ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:Action ] ;
    sh:property [ sh:path sj:nextCheckpoint ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:Checkpoint ] ;
    sh:property [ sh:path sj:requiresReceiptClass ; sh:minCount 1 ; sh:datatype xsd:string ; sh:pattern "^(manufacture|projection|authority_preparation|actuation|verification|postcondition|replay|publication|deployment)$" ] ;
    sh:property [ sh:path sj:candidateSha ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path sj:subjectSha ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path sj:receipt ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class sj:Receipt ] ;
    sh:property [ sh:path sj:authority ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sj:lease ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path sj:worker ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
      sh:message "Work order identifiers must be unique across WorkOrders." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        PREFIX dcterms: <http://purl.org/dc/terms/>
        SELECT $this WHERE {
          $this dcterms:identifier ?id .
          ?other a sj:WorkOrder ; dcterms:identifier ?id .
          FILTER(?other != $this)
        }
      """
    ] ;
    sh:sparql [
      sh:message "ALIVE requires exact candidate/subject SHA and a durable receipt." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:standing "ALIVE" .
          OPTIONAL { $this sj:candidateSha ?candidate . }
          OPTIONAL { $this sj:subjectSha ?subjectSha . }
          OPTIONAL { $this sj:receipt ?receipt . }
          FILTER(!BOUND(?candidate) || !BOUND(?subjectSha) || !BOUND(?receipt))
        }
      """
    ] ;
    sh:sparql [
      sh:message "Authority-requiring work must bind authority, lease, and worker identity." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:authorityRequirement ?requirement .
          FILTER(?requirement != "NONE")
          OPTIONAL { $this sj:authority ?authority . }
          OPTIONAL { $this sj:lease ?lease . }
          OPTIONAL { $this sj:worker ?worker . }
          FILTER(!BOUND(?authority) || !BOUND(?lease) || !BOUND(?worker))
        }
      """
    ] ;
    sh:sparql [
      sh:message "Replay identities must be unique across WorkOrders." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:replayIdentity ?id .
          ?other a sj:WorkOrder ; sj:replayIdentity ?id .
          FILTER(?other != $this)
        }
      """
    ] .

sj:DependencyEdgeShape a sh:NodeShape ;
    sh:targetClass sj:DependencyEdge ;
    sh:property [ sh:path sj:dependencyType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^requires(SemanticIdentity|Projection|Capability|Receipt|Runtime|Verifier|Observation|Postcondition|Publication)$" ] ;
    sh:property [ sh:path sj:upstreamWorkOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sj:WorkOrder ] .

sj:ProjectionAuthorityShape a sh:NodeShape ;
    sh:targetClass sj:ProjectionSpec ;
    sh:property [ sh:path sj:authorityClaim ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "NONE" ] .

sj:PredictionShape a sh:NodeShape ;
    sh:targetClass sj:Prediction ;
    sh:property [ sh:path sj:candidateOnly ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [ sh:path sj:authorityClaim ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "NONE" ] ;
    sh:property [ sh:path sj:observedStanding ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "UNKNOWN" ] .

sj:StandingTransitionShape a sh:NodeShape ;
    sh:targetClass sj:StandingTransition ;
    sh:property [ sh:path sj:fromStanding ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sj:toStanding ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [
      sh:message "Standing transition is ambiguous or skips explicit progression." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:fromStanding ?from ; sj:toStanding ?to .
          FILTER(?from = ?to || (?from = "UNKNOWN" && ?to = "ALIVE"))
        }
      """
    ] .

sj:ProcessFindingShape a sh:NodeShape ;
    sh:targetClass sj:ProcessFinding ;
    sh:property [ sh:path sj:normativeMutation ; sh:maxCount 1 ; sh:hasValue false ] ;
    sh:property [ sh:path sj:authorityClaim ; sh:maxCount 1 ; sh:hasValue "NONE" ] ;
    sh:property [ sh:path sj:standing ; sh:maxCount 1 ; sh:hasValue "UNKNOWN" ] .

sj:LeaseRequestShape a sh:NodeShape ;
    sh:targetClass sj:LeaseRequest ;
    sh:property [ sh:path sj:workOrderDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path sj:worker ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sj:pathScope ; sh:minCount 1 ] ;
    sh:property [ sh:path sj:concurrencyKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sj:authorityClaim ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "NONE" ] ;
    sh:sparql [
      sh:message "Duplicate active exclusive lease requests for one concurrency key are refused." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:active true ; sj:exclusive true ; sj:concurrencyKey ?key .
          ?other a sj:LeaseRequest ; sj:active true ; sj:exclusive true ;
                 sj:concurrencyKey ?key .
          FILTER(?other != $this)
        }
      """
    ] .

sj:ReceiptShape a sh:NodeShape ;
    sh:targetClass sj:Receipt ;
    sh:property [ sh:path sj:workOrderDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
    sh:property [ sh:path sj:repository ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sj:baseSha ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path sj:subjectSha ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
    sh:property [ sh:path sj:replayIdentity ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path sj:receiptClass ; sh:minCount 1 ; sh:maxCount 1 ] .

sj:GlobalIntegrityShape a sh:NodeShape ;
    sh:targetClass sj:WorkOrder ;
    sh:sparql [
      sh:message "Dependency identities must resolve to typed edges and upstream WorkOrders." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:dependsOn ?edge .
          OPTIONAL {
            ?edge a sj:DependencyEdge ; sj:upstreamWorkOrder ?upstream .
            ?upstream a sj:WorkOrder .
          }
          FILTER(!BOUND(?upstream))
        }
      """
    ] ;
    sh:sparql [
      sh:message "ALIVE requires an independent court and durable receipt." ;
      sh:select """
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this sj:standing "ALIVE" .
          OPTIONAL { $this sj:requiresCourt ?court . ?court a sj:Court . }
          OPTIONAL { $this sj:receipt ?receipt2 . ?receipt2 a sj:Receipt . }
          FILTER(!BOUND(?court) || !BOUND(?receipt2))
        }
      """
    ] .

# ── A2A projection shapes ──────────────────────────────────────────────────
@prefix a2a: <https://ggen-igniter.dev/ontology/a2a#> .
@prefix gi: <https://ggen-igniter.dev/ontology/ggen-igniter#> .

a2a:TaskStateShape a sh:NodeShape ;
    sh:targetClass a2a:TaskState ;
    sh:property [ sh:path a2a:stateValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(submitted|working|input-required|auth-required|completed|canceled|failed|rejected)$" ] .

a2a:StateMappingShape a sh:NodeShape ;
    sh:targetClass a2a:StateMapping ;
    sh:property [ sh:path a2a:fromStanding ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(UNKNOWN|PARTIAL_ALIVE|ALIVE|BLOCKED|BUILD_BROKEN|UNSUPPORTED|REFUSED)$" ] ;
    sh:property [ sh:path a2a:toState ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:class a2a:TaskState ] ;
    sh:property [ sh:path a2a:reasonCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path a2a:withReceipt ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:sparql [
      sh:message "Falsifier F1: a2a:completed requires a receipt-bound ALIVE mapping (a2a:withReceipt true, fromStanding ALIVE)." ;
      sh:select """
        PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
        SELECT $this WHERE {
          $this a2a:toState a2a:state-completed ; a2a:fromStanding ?from .
          OPTIONAL { $this a2a:withReceipt ?wr . }
          FILTER(?from != "ALIVE" || !BOUND(?wr) || ?wr != true)
        }
      """
    ] ;
    sh:sparql [
      sh:message "UNSUPPORTED and REFUSED must keep their own distinct reason code." ;
      sh:select """
        PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
        SELECT $this WHERE {
          $this a2a:fromStanding ?from ; a2a:reasonCode ?reason .
          FILTER((?from = "UNSUPPORTED" && ?reason != "UNSUPPORTED") || (?from = "REFUSED" && ?reason != "REFUSED"))
        }
      """
    ] .

a2a:SkillShape a sh:NodeShape ;
    sh:targetClass sj:Action ;
    sh:property [ sh:path a2a:skillName ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9_]*$" ] ;
    sh:property [ sh:path a2a:ashAction ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9_]*$" ] ;
    sh:property [ sh:path a2a:consequence ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(observe|change|external_do)$" ] ;
    sh:property [ sh:path a2a:exposed ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:sparql [
      sh:message "Skill ids (a2a:skillName) must be unique across Actions." ;
      sh:select """
        PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this a2a:skillName ?name .
          ?other a sj:Action ; a2a:skillName ?name .
          FILTER(?other != $this)
        }
      """
    ] ;
    sh:sparql [
      sh:message "Falsifier F3: an exposed skill must not be sourced from a forbidden capability (Push/Publish)." ;
      sh:select """
        PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
        PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
        SELECT $this WHERE {
          $this a2a:exposed true ; a2a:requiresCapability ?cap .
          ?spec a sj:ProjectionSpec ; a2a:forbidsCapability ?cap .
        }
      """
    ] ;
    sh:sparql [
      sh:message "An exposed skill must name an Ash action, a consequence, a skill name and an admitted generator capability." ;
      sh:select """
        PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
        PREFIX gi: <https://ggen-igniter.dev/ontology/ggen-igniter#>
        SELECT $this WHERE {
          $this a2a:exposed true .
          OPTIONAL { $this a2a:skillName ?n . }
          OPTIONAL { $this a2a:ashAction ?a . }
          OPTIONAL { $this a2a:consequence ?c . }
          OPTIONAL { $this a2a:generatedBy ?g . ?g gi:standing ?gs . }
          FILTER(!BOUND(?n) || !BOUND(?a) || !BOUND(?c) || !BOUND(?gs) || ?gs = "UNSUPPORTED")
        }
      """
    ] ;
    sh:sparql [
      sh:message "A not-exposed skill must carry a typed refusal reason." ;
      sh:select """
        PREFIX a2a: <https://ggen-igniter.dev/ontology/a2a#>
        SELECT $this WHERE {
          $this a2a:exposed false .
          OPTIONAL { $this a2a:refusalReason ?r . }
          FILTER(!BOUND(?r))
        }
      """
    ] .

gi:GeneratorCapabilityShape a sh:NodeShape ;
    sh:targetClass gi:GeneratorCapability ;
    sh:property [ sh:path gi:mixTask ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path gi:standing ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(ALIVE|PARTIAL_ALIVE|UNSUPPORTED|BLOCKED)$" ] ;
    sh:sparql [
      sh:message "An UNSUPPORTED generator capability must carry an explicit UNSUPPORTED(generator-capability) reason." ;
      sh:select """
        PREFIX gi: <https://ggen-igniter.dev/ontology/ggen-igniter#>
        SELECT $this WHERE {
          $this gi:standing "UNSUPPORTED" .
          OPTIONAL { $this gi:refusalReason ?r . }
          FILTER(!BOUND(?r) || !CONTAINS(?r, "UNSUPPORTED(generator-capability)"))
        }
      """
    ] .
