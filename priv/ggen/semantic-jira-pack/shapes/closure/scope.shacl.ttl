@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sj: <https://seanchatman.dev/semantic-jira#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
sj:ScopeClosureShape a sh:NodeShape ; sh:targetClass sj:WorkOrder ; sh:property [ sh:path sj:scope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:message "scope must be explicit and bounded" ] .
