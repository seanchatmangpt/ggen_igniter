# Standing-projection chain-tip gate (Ra4; closes the v23:GC-26.9.24 deferral
# named in 050_frontier.rq's header and V23-T6R refutation 2). A work order's
# standing-transition events (sj:StandingTransitionEvent, anchored to the order
# by sj:identity = dcterms:identifier; no sj:transitionWorkOrder exists) must
# form a chain with exactly one chain tip: one event maximal in sj:seq for the
# identity. This gate returns violation rows exactly when a work order has more
# than one chain tip -- a forked ledger projection. Zero rows = pass.
# sparql-engine law (locked 0.3.12 + oxigraph; see 050_frontier.rq's header):
# no FILTER inside EXISTS (compiles to :"$undefined" and crashes), so chain-tip
# maximality is expressed with nested MINUS; each MINUS group restates the
# shared bindings (?tip / ?identity / ?seq) so its FILTER sees them, the same
# way 050 restates ?work_order inside its inner MINUS.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT DISTINCT ?work_order ?identity ?tip_a ?tip_b WHERE {
  ?work_order a sj:WorkOrder ;
              dcterms:identifier ?identity .
  ?tip_a a sj:StandingTransitionEvent ;
         sj:identity ?identity ;
         sj:seq ?seq_a .
  ?tip_b a sj:StandingTransitionEvent ;
         sj:identity ?identity ;
         sj:seq ?seq_b .
  FILTER(?tip_a != ?tip_b)
  MINUS {
    ?tip_a sj:identity ?identity ; sj:seq ?seq_a .
    ?later_a a sj:StandingTransitionEvent ;
             sj:identity ?identity ;
             sj:seq ?later_seq_a .
    FILTER(?later_a != ?tip_a && ?later_seq_a > ?seq_a)
  }
  MINUS {
    ?tip_b sj:identity ?identity ; sj:seq ?seq_b .
    ?later_b a sj:StandingTransitionEvent ;
             sj:identity ?identity ;
             sj:seq ?later_seq_b .
    FILTER(?later_b != ?tip_b && ?later_seq_b > ?seq_b)
  }
}
