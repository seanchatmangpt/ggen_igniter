---
to: "docs/plan/semantic-jira-workorder.domain.hddl"
mode: file
---
<%
sj = "https://ggen-igniter.dev/ontology/semantic-jira#"

refuse = fn reason ->
  raise ArgumentError, "REFUSED:SEMANTIC_JIRA_INVALID_WORK_ORDER: #{reason}"
end

safe_token = fn value ->
  if Regex.match?(~r/\A[A-Za-z0-9][A-Za-z0-9_-]*\z/, value), do: value, else: inspect(value)
end

# The domain is emitted once per graph, but its standing-state constants are
# bound to that graph's own rows: fail closed on a blank standing, and derive
# the declared states from the graph instead of hardcoding them, so a
# problem rendered by templates/plan.hddl.eex never references a
# standing-state outside the domain vocabulary. Mirror of plan.hddl.eex's
# core-field law, scoped to the one field the domain consumes.
Enum.each(work_orders, fn row ->
  if not is_binary(row["standing"]) or String.trim(row["standing"]) == "" do
    refuse.("blank standing for #{inspect(row["work_order"])}")
  end
end)

standing_states =
  work_orders
  |> Enum.map(&safe_token.(&1["standing"]))
  |> Enum.sort()
  |> Enum.uniq()

receipt_classes =
  properties
  |> Enum.filter(&(&1["predicate"] == sj <> "requiresReceiptClass"))
  |> Enum.map(&safe_token.(&1["value"]))
  |> Enum.sort()
  |> Enum.uniq()
%>
;; GENERATED by semantic-jira-pack from canonical RDF WorkOrder graph. DO NOT EDIT.
;;
;; Zero-authority projection: this HDDL DOMAIN file is the promotion
;; vocabulary AS DECLARED by the canonical RDF graph. It executes nothing and
;; holds no authority to actuate, merge, publish, deploy, or promote
;; standing. Every problem file rendered by templates/plan.hddl.eex declares
;; (:domain semantic-jira-workorder) and consumes exactly the predicates,
;; tasks, and types declared here. The real reconciliation receipt binds this
;; file to the exact ontology bytes through receipt metadata graph_hash.
;; Consumer court: ferroplan's HDDL gate
;; (crates/ferroplan-hddl/examples/validate_files.rs) must admit this domain
;; together with every problem file the plan projection renders.

(define (domain semantic-jira-workorder)
  (:requirements :typing)
  (:types
    workorder court evidence receipt-class falsifier checkpoint dependency-edge standing-state sha ceiling identity-atom)
  (:predicates
    (workorder ?w - workorder)
    (standing ?w - workorder ?s - standing-state)
    (base-sha ?w - workorder ?s - sha)
    (authority-ceiling ?w - workorder ?a - ceiling)
    (exact-subject ?w - workorder ?s - identity-atom)
    (repository ?w - workorder ?r - identity-atom)
    (replay-identity ?w - workorder ?r - identity-atom)
    (depends-on ?w - workorder ?d - dependency-edge)
    (has-receipt ?w - workorder)
    (projection-authority ?a - ceiling))
  (:constants
    <%= Enum.join(standing_states, " ") %> - standing-state
    ALIVE - standing-state
    NONE - ceiling)
  (:task promote :parameters (?w - workorder))
  (:task close-court :parameters (?w - workorder ?c - court))
  (:task produce-evidence :parameters (?w - workorder ?e - evidence))
  (:task record-receipt-class :parameters (?w - workorder ?r - receipt-class))
  (:task discharge-falsifier :parameters (?w - workorder ?f - falsifier))
  (:task reach-checkpoint :parameters (?w - workorder ?x - checkpoint))
  (:method decompose-promote
    :parameters (?w - workorder ?c - court ?e - evidence ?r - receipt-class ?f - falsifier ?x - checkpoint)
    :task (promote ?w)
    :ordered-subtasks (and
      (close-court ?w ?c)
      (produce-evidence ?w ?e)
      (record-receipt-class ?w ?r)
      (discharge-falsifier ?w ?f)
      (reach-checkpoint ?w ?x))))
