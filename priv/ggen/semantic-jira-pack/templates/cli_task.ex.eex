---
to: "lib/mix/tasks/<%= task_name %>.ex"
for_each: cli_tasks
mode: file
---
<%
  truthy = fn
    true -> true
    "true" -> true
    _ -> false
  end

  indent = fn text, n ->
    pad = String.duplicate(" ", n)
    text |> String.split("\n") |> Enum.map_join("\n", fn "" -> ""; l -> pad <> l end)
  end

  mine =
    cli_options
    |> Enum.filter(&(&1["task"] == task))
    |> Enum.sort_by(fn o ->
      case Integer.parse(to_string(o["opt_order"] || "0")) do
        {n, _} -> n
        :error -> 0
      end
    end)

  if mine == [] do
    raise "REFUSED(CLI_OPTIONS_MISSING): #{task_name} has no sj:CliOption rows; broken_term=mu_on_O"
  end

  schema_line = fn o ->
    type = o["opt_type"]
    "        #{o["opt_name"]}: :#{type}"
  end

  ensure_apps = truthy.(ensure_apps)

  emit_style = emit_style || "emit"

  call =
    case emit_style do
      "shell_info" ->
        """
            {code, result} = Cli.#{verb}(opts)
            Mix.shell().info(Jason.encode!(result))
            if code != 0, do: exit({:shutdown, code})\
        """

      "emit_empty" ->
        """
            # `--out` names the Turtle file, so it is not forwarded to `emit/2`
            # (which would overwrite it with the JSON status).
            opts |> Cli.#{verb}() |> Cli.emit([])\
        """

      _ ->
        """
            opts |> Cli.#{verb}() |> Cli.emit(opts)\
        """
    end

  apps_block =
    if ensure_apps do
      "    {:ok, _} = Application.ensure_all_started(:rdf)\n    {:ok, _} = Application.ensure_all_started(:sparql)\n"
    else
      ""
    end
%># GENERATED by ggen_igniter from priv/ggen/semantic-jira-pack (sj:CliTask <%= task_name %>). Do not hand-edit;
# edit the ontology facts and re-render (mix ggen_igniter.sync --pack semantic-jira-pack:cli_task).
defmodule <%= module %> do
  @shortdoc "<%= shortdoc %>"
  @moduledoc """
<%= indent.(moduledoc, 2) %>
  """

  use Mix.Task

  alias GgenIgniter.SemanticJira.Cli

  @impl Mix.Task
  def run(args) do
<%= apps_block %>    {opts, _rest, _invalid} =
      OptionParser.parse(args,
        strict: [
<%= Enum.map_join(mine, ",\n", schema_line) %>
        ]
      )

<%= call %>
  end
end
