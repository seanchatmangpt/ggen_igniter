---
to: "lib/<%= installer_id %>_upgrade.ex"
for_each: upgrade_libs
mode: file
---
<%
  refuse = fn code, what -> raise "REFUSED(#{code}): #{what}; broken_term=mu_on_O" end
  check = fn rows, key, code -> if rows != [], do: refuse.(code, Enum.map_join(rows, ", ", & &1[key])) end
  check.(refuse_upgrader, "upgrader", "UPGRADER_INCOMPLETE")
  check.(refuse_upgrader_duplicate, "upgrader", "UPGRADER_VERSION_DUPLICATE")
  check.(refuse_installer, "installer", "INSTALLER_INCOMPLETE")

  f = Enum.find(installer_facts, &(&1["installer"] == installer)) ||
        refuse.("INSTALLER_INCOMPLETE", installer)
  ups = Enum.filter(upgrader_facts, &(&1["installer"] == installer))
  lib = f["library_module"]
  registry = Enum.map_join(ups, ",\n", fn u -> "    #{inspect(u["up_version"])} => #{u["up_module"]}" end)
%># GENERATED by ggen_igniter from priv/ggen/igniter-installer-pack (ii:Upgrader facts of <%= f["task_name"] %>). Do not hand-edit.
defmodule <%= lib %>.Upgrades do
  @moduledoc """
  Version-keyed upgrader registry and window selection for `mix <%= f["library"] %>.upgrade`.
  An upgrader runs when `from < version <= to`, in ascending version order (the window
  `Igniter.Upgrades.run/5` uses). Refusals are typed: `{:invalid_version, v}` and
  `{:downgrade, from, to}`.
  """

  @registry %{
<%= registry %>
  }

  @spec registry() :: %{String.t() => module()}
  def registry, do: @registry

  @spec select(String.t(), String.t(), map()) ::
          {:ok, [module()]}
          | {:error, {:invalid_version, String.t()} | {:downgrade, String.t(), String.t()}}
  def select(from, to, registry \\ @registry) do
    with {:ok, f} <- parse(from),
         {:ok, t} <- parse(to),
         :ok <- check_order(f, t, from, to) do
      mods =
        registry
        |> Enum.filter(fn {v, _} ->
          {:ok, pv} = parse(v)
          Version.compare(pv, f) == :gt and Version.compare(pv, t) != :gt
        end)
        |> Enum.sort_by(fn {v, _} -> Version.parse!(v) end, Version)
        |> Enum.map(&elem(&1, 1))

      {:ok, mods}
    end
  end

  defp check_order(f, t, from, to) do
    if Version.compare(t, f) == :lt, do: {:error, {:downgrade, from, to}}, else: :ok
  end

  defp parse(v) when is_binary(v) do
    case Version.parse(v) do
      {:ok, ver} -> {:ok, ver}
      :error -> {:error, {:invalid_version, v}}
    end
  end

  defp parse(v), do: {:error, {:invalid_version, inspect(v)}}
end

defmodule Mix.Tasks.<%= lib %>.Upgrade do
  @shortdoc "Runs <%= f["library"] %>'s version-keyed consumer upgraders"
  @moduledoc """
  Runs `<%= f["library"] %>`'s consumer upgraders. Invoked by `mix igniter.upgrade <%= f["library"] %>` as
  `<%= f["library"] %>.upgrade FROM TO`. A downgrade or unparseable version is a typed refusal
  (an Igniter issue; nothing is written); `FROM == TO` is a no-op.
  """

  use Igniter.Mix.Task

  @example "mix <%= f["library"] %>.upgrade 0.1.0 0.2.0"

  @impl Igniter.Mix.Task
  def info(_argv, _composing_task) do
    %Igniter.Mix.Task.Info{
      group: <%= inspect(String.to_atom(f["group"])) %>,
      example: @example,
      positional: [:from, :to],
      schema: [],
      aliases: []
    }
  end

  @impl Igniter.Mix.Task
  def igniter(igniter) do
    %{from: from, to: to} = igniter.args.positional

    case <%= lib %>.Upgrades.select(from, to) do
      {:ok, mods} ->
        Enum.reduce(mods, igniter, fn mod, ig -> mod.upgrade(ig, igniter.args.options) end)

      {:error, {:invalid_version, v}} ->
        Igniter.add_issue(igniter, "REFUSED:UPGRADE_INVALID_VERSION #{v}")

      {:error, {:downgrade, f, t}} ->
        Igniter.add_issue(igniter, "REFUSED:UPGRADE_DOWNGRADE #{f} -> #{t}")
    end
  end
end
