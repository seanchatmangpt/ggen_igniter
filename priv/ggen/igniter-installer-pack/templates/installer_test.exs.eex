---
to: "test/<%= installer_id %>_test.exs"
for_each: installers
mode: file
---
<%
  refuse = fn code, what -> raise "REFUSED(#{code}): #{what}; broken_term=mu_on_O" end
  check = fn rows, key, code -> if rows != [], do: refuse.(code, Enum.map_join(rows, ", ", & &1[key])) end
  check.(refuse_dep, "dep", "INSTALLER_DEP_INCOMPLETE")
  check.(refuse_dep_mode, "dep", "INSTALLER_DEP_MODE_INVALID")
  check.(refuse_config, "cfg", "INSTALLER_CONFIG_INVALID")
  check.(refuse_config_file, "cfg", "INSTALLER_CONFIG_INVALID")
  check.(refuse_installer, "installer", "INSTALLER_INCOMPLETE")

  f = Enum.find(installer_facts, &(&1["installer"] == installer)) ||
        refuse.("INSTALLER_INCOMPLETE", installer)

  mine = fn rows -> Enum.filter(rows, &(&1["installer"] == installer)) end
  adds = Enum.filter(mine.(deps), &(&1["dep_mode"] == "adds_deps"))
  formatters = mine.(formatters)
  configs = mine.(configs)
  children = mine.(children)
  notices = mine.(notices)
  q = fn s -> inspect(s) end
  path_of = fn p -> "[" <> Enum.map_join(String.split(p, "."), ", ", &(":" <> &1)) <> "]" end

  assertions =
    Enum.map(adds, fn d ->
      ~s|assert_has_patch(igniter, "mix.exs", #{q.("+ | {:" <> d["dep_name"] <> ", \"" <> d["dep_req"] <> "\"}")})|
    end) ++
      Enum.map(formatters, fn x ->
        ~s|assert_has_patch(igniter, ".formatter.exs", #{q.("+ | import_deps: [:" <> x["import_dep"] <> "]")})|
      end) ++
      Enum.map(configs, fn c ->
        "assert Igniter.Test.diff(igniter) =~ #{q.("config :" <> c["cfg_app"])}\n    assert_creates(igniter, #{q.("config/" <> c["cfg_file"])})"
      end) ++
      Enum.map(children, fn c -> "assert Igniter.Test.diff(igniter) =~ #{q.(c["child_module"])}" end) ++
      Enum.map(notices, fn n -> "assert_has_notice(igniter, #{q.(n["notice_text"])})" end)
  _ = path_of
%># GENERATED by ggen_igniter from priv/ggen/igniter-installer-pack (ii:Installer <%= f["task_name"] %>). Do not hand-edit.
defmodule <%= f["module"] %>Test do
  @moduledoc """
  Igniter.Test suite for `mix <%= f["task_name"] %>`, manufactured from the same ontology facts as the
  installer: every declared dependency, formatter import, config key, child and notice
  is asserted as a patch/notice, and a second run must change nothing.
  """
  use ExUnit.Case, async: true
  import Igniter.Test

  test "<%= f["task_name"] %> applies every declared fact" do
    igniter =
      test_project()
      |> Igniter.compose_task(<%= inspect(f["task_name"]) %>, [])

    <%= Enum.join(assertions, "\n    ") %>
    assert igniter.issues == []
  end

  test "<%= f["task_name"] %> is idempotent" do
    applied =
      test_project()
      |> Igniter.compose_task(<%= inspect(f["task_name"]) %>, [])
      |> apply_igniter!()

    applied
    |> Igniter.compose_task(<%= inspect(f["task_name"]) %>, [])
    |> assert_unchanged()
  end
end
