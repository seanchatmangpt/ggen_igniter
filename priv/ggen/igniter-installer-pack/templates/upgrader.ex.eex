---
to: "lib/<%= upgrader_id %>.ex"
for_each: upgraders
mode: file
---
<%
  refuse = fn code, what -> raise "REFUSED(#{code}): #{what}; broken_term=mu_on_O" end
  check = fn rows, key, code -> if rows != [], do: refuse.(code, Enum.map_join(rows, ", ", & &1[key])) end
  check.(refuse_upgrader, "upgrader", "UPGRADER_INCOMPLETE")
  check.(refuse_upgrader_duplicate, "upgrader", "UPGRADER_VERSION_DUPLICATE")
  check.(refuse_step, "step", "UPGRADER_STEP_INVALID")
  check.(refuse_step_orphan, "step", "UPGRADER_STEP_INVALID")
  check.(refuse_step_kind, "step", "UPGRADER_STEP_INVALID")

  f = Enum.find(upgrader_facts, &(&1["upgrader"] == upgrader)) ||
        refuse.("UPGRADER_INCOMPLETE", upgrader)
  mine = Enum.filter(steps, &(&1["upgrader"] == upgrader))
  atom = fn s -> inspect(String.to_atom(s)) end
  need = fn s, keys ->
    missing = Enum.filter(keys, &(not (is_binary(s[&1]) and s[&1] != "")))
    if missing != [], do: refuse.("UPGRADER_STEP_INVALID", "#{s["step"]} (#{s["step_kind"]}) lacks #{Enum.join(missing, ",")}")
  end
  path = fn p -> "[" <> Enum.map_join(String.split(p, "."), ", ", &(":" <> &1)) <> "]" end

  calls =
    Enum.map(mine, fn s ->
      case s["step_kind"] do
        "rename_config_key" ->
          need.(s, ["step_file", "step_app", "step_from", "step_to"])
          "|> rename_config_key(#{inspect(s["step_file"])}, #{atom.(s["step_app"])}, #{atom.(s["step_from"])}, #{atom.(s["step_to"])})"

        "add_dep" ->
          need.(s, ["step_dep", "step_req"])
          "|> Igniter.Project.Deps.add_dep({#{atom.(s["step_dep"])}, #{inspect(s["step_req"])}})"

        "import_dep" ->
          need.(s, ["step_dep"])
          "|> Igniter.Project.Formatter.import_dep(#{atom.(s["step_dep"])})"

        "config_value" ->
          need.(s, ["step_file", "step_app", "step_path", "step_value"])
          "|> Igniter.Project.Config.configure_new(#{inspect(s["step_file"])}, #{atom.(s["step_app"])}, #{path.(s["step_path"])}, #{s["step_value"]})"
      end
    end)
%># GENERATED by ggen_igniter from priv/ggen/igniter-installer-pack (ii:Upgrader <%= f["up_version"] %>). Do not hand-edit.
defmodule <%= f["up_module"] %> do
  @moduledoc """
  Upgrader into <%= f["up_version"] %>. Steps are ontology facts (ii:Step), applied in stepOrder.
  Each step is idempotent: a re-run leaves the project unchanged.
  """

  @spec upgrade(Igniter.t(), keyword()) :: Igniter.t()
  def upgrade(igniter, _opts \\ []) do
    igniter
    <%= Enum.join(calls, "\n    ") %>
  end

  # Renames `old: value` -> `new: value` inside `config :app, ...` calls of `file`
  # (first-level keyword key). No `old` key present => no change (idempotent).
  defp rename_config_key(igniter, file, app, from, to) do
    path = Path.join("config", file)

    if Igniter.exists?(igniter, path) do
      Igniter.update_elixir_file(igniter, path, fn zipper ->
        rename_keys(zipper, app, from, to)
      end)
    else
      igniter
    end
  end

  defp rename_keys(zipper, app, from, to) do
    zipper =
      Sourceror.Zipper.traverse(zipper, fn z ->
        case Sourceror.Zipper.node(z) do
          {:config, meta, [{:__block__, _, [^app]} | _] = args} ->
            Sourceror.Zipper.replace(z, {:config, meta, Enum.map(args, &rename_in(&1, from, to))})

          _ ->
            z
        end
      end)

    {:ok, zipper}
  end

  defp rename_in(ast, from, to) do
    Macro.prewalk(ast, fn
      {{:__block__, meta, [^from]}, value} -> {{:__block__, meta, [to]}, value}
      other -> other
    end)
  end
end
