---
to: "lib/<%= installer_id %>.ex"
for_each: installers
mode: file
---
<%
  refuse = fn code, what -> raise "REFUSED(#{code}): #{what}; broken_term=mu_on_O" end
  check = fn rows, key, code -> if rows != [], do: refuse.(code, Enum.map_join(rows, ", ", & &1[key])) end
  check.(refuse_dep, "dep", "INSTALLER_DEP_INCOMPLETE")
  check.(refuse_dep_mode, "dep", "INSTALLER_DEP_MODE_INVALID")
  check.(refuse_config, "cfg", "INSTALLER_CONFIG_INVALID")
  check.(refuse_config_file, "cfg", "INSTALLER_CONFIG_INVALID")
  check.(refuse_installer, "installer", "INSTALLER_INCOMPLETE")

  f = Enum.find(installer_facts, &(&1["installer"] == installer)) ||
        refuse.("INSTALLER_INCOMPLETE", installer)

  num = fn v -> if is_integer(v), do: v, else: v |> to_string() |> Integer.parse() |> elem(0) end
  mine = fn rows, k ->
    rows |> Enum.filter(&(&1["installer"] == installer)) |> Enum.sort_by(&num.(&1[k]))
  end
  deps = mine.(deps, "dep_order")
  adds = Enum.filter(deps, &(&1["dep_mode"] == "adds_deps"))
  installs = Enum.filter(deps, &(&1["dep_mode"] == "installs"))
  formatters = Enum.filter(formatters, &(&1["installer"] == installer))
  configs = mine.(configs, "cfg_order")
  children = Enum.filter(children, &(&1["installer"] == installer))
  notices = mine.(notices, "notice_order")
  composes = mine.(composes, "composes_order")
  only = Enum.filter(only, &(&1["installer"] == installer))
  opts = mine.(options, "opt_order")

  dep_tuple = fn d -> "{#{inspect(String.to_atom(d["dep_name"]))}, #{inspect(d["dep_req"])}}" end
  key = fn s -> String.replace(s, "-", "_") end
  aliases = Enum.filter(opts, &(is_binary(&1["opt_alias"]) and &1["opt_alias"] != ""))
  cfg_path = fn p -> "[" <> Enum.map_join(String.split(p, "."), ", ", &(":" <> &1)) <> "]" end

  info_fields =
    [
      "group: #{inspect(String.to_atom(f["group"]))}",
      "example: @example",
      "positional: []",
      "installs: [" <> Enum.map_join(installs, ", ", dep_tuple) <> "]",
      "adds_deps: [" <> Enum.map_join(adds, ", ", dep_tuple) <> "]",
      "composes: [" <> Enum.map_join(composes, ", ", &inspect(&1["composed_task"])) <> "]",
      if(only != [], do: "only: [" <> Enum.map_join(only, ", ", &(":" <> &1["only_env"])) <> "]"),
      "schema: [" <> Enum.map_join(opts, ", ", fn o -> key.(o["opt_name"]) <> ": :" <> o["opt_type"] end) <> "]",
      "aliases: [" <> Enum.map_join(aliases, ", ", fn o -> o["opt_alias"] <> ": :" <> key.(o["opt_name"]) end) <> "]"
    ]
    |> Enum.reject(&is_nil/1)

  steps =
    Enum.map(adds, fn d -> "|> Igniter.Project.Deps.add_dep(#{dep_tuple.(d)})" end) ++
      Enum.map(formatters, fn x -> "|> Igniter.Project.Formatter.import_dep(#{inspect(String.to_atom(x["import_dep"]))})" end) ++
      Enum.map(configs, fn c ->
        "|> Igniter.Project.Config.configure_new(#{inspect(c["cfg_file"])}, #{inspect(String.to_atom(c["cfg_app"]))}, #{cfg_path.(c["cfg_path"])}, #{c["cfg_value"]})"
      end) ++
      Enum.map(children, fn c ->
        if c["child_opts"] == "[]",
          do: "|> Igniter.Project.Application.add_new_child(#{c["child_module"]})",
          else: "|> Igniter.Project.Application.add_new_child({#{c["child_module"]}, #{c["child_opts"]}})"
      end) ++
      Enum.map(composes, fn c -> "|> Igniter.compose_task(#{inspect(c["composed_task"])}, igniter.args.argv_flags)" end) ++
      Enum.map(notices, fn n -> "|> Igniter.add_notice(#{inspect(n["notice_text"])})" end)
%># GENERATED by ggen_igniter from priv/ggen/igniter-installer-pack (ii:Installer <%= f["task_name"] %>). Do not hand-edit;
# edit the ontology facts and re-render (mix ggen_igniter.sync --pack igniter-installer-pack:installer).
defmodule <%= f["module"] %> do
  @shortdoc <%= inspect(f["shortdoc"]) %>
  @moduledoc """
  <%= f["shortdoc"] %>

  Manufactured installer for `<%= f["library"] %>`. Every dependency, formatter import, config
  key, supervision child and notice below is a fact in the ontology, not hand-written:
<%= Enum.map_join(adds ++ installs, "\n", fn d -> "    * dep `" <> d["dep_name"] <> "` " <> d["dep_req"] <> " (" <> d["dep_mode"] <> ")" end) %>

  ## Example

  ```bash
  <%= f["example"] %>
  ```
  """

  use Igniter.Mix.Task

  @example <%= inspect(f["example"]) %>

  @impl Igniter.Mix.Task
  def info(_argv, _composing_task) do
    %Igniter.Mix.Task.Info{
      <%= Enum.join(info_fields, ",\n      ") %>
    }
  end

  @impl Igniter.Mix.Task
  def igniter(igniter) do
    igniter
    <%= Enum.join(steps, "\n    ") %>
  end
end
