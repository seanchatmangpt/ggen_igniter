/_build/
/deps/
*.beam
/.elixir_ls/
/.lexical/
erl_crash.dump
*.ez
*.tar
/tmp_out/

# Reconciliation manifest (GgenIgniter.Manifest / `mix ggen_igniter.sync
# --manifest-dir`) -- local, regenerable per-consumer-project state recording
# what a prior sync run wrote; defaults to this checkout's own root when no
# --manifest-dir is passed, so ignore it here the same way any consumer
# project should ignore or commit it by its own choice.
/.ggen_igniter/

# Rust NIF build artifacts (native/ggen_graph_nif/target/ alone runs into the
# GBs -- never commit compiled crate output or the platform-specific .so
# Rustler copies into priv/native/).
/native/*/target/
/priv/native/*.so

# Dialyzer PLT cache and ExCoveralls coverage output (both real, regenerable
# tool output, not source).
/priv/plts/
*.plt
*.plt.hash
/cover/

# ExDoc-generated reference site (`mix docs`, added v26.8.30) -- real,
# regenerable tool output, not source.
/doc/
