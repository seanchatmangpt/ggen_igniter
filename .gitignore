/_build/
/deps/
*.beam
/.elixir_ls/
/.lexical/
erl_crash.dump
*.ez
*.tar
/tmp_out/

# Reconciliation manifest (GgenIgniter.Manifest / `mix ggen_igniter.sync
# --manifest-dir`) -- local, regenerable per-consumer-project state recording
# what a prior sync run wrote; defaults to this checkout's own root when no
# --manifest-dir is passed, so ignore it here the same way any consumer
# project should ignore or commit it by its own choice.
/.ggen_igniter/

# Rust NIF build artifacts (native/ggen_graph_nif/target/ alone runs into the
# GBs -- never commit compiled crate output or the platform-specific .so
# Rustler copies into priv/native/).
/native/*/target/
/priv/native/*.so

# Dialyzer PLT cache and ExCoveralls coverage output (both real, regenerable
# tool output, not source).
/priv/plts/
*.plt
*.plt.hash
/cover/

# ExDoc-generated reference site (`mix docs`, added v26.8.30) -- real,
# regenerable tool output, not source.
/doc/

# Qualification-run evidence for the ash_manufacture_pack (v26.9.8). Real,
# regenerable output of `test/fixtures/ash_manufacture_pack/bin/qualify.sh`:
# per-step logs, tree hashes, OCEL logs, receipt. The RECEIPT for a run worth
# citing gets copied into docs/jira/ deliberately; the raw run directory does
# not belong in history.
/test/fixtures/.qualification/

# Everything the manufacture path writes into the book_library fixture is
# generated by the real upstream Ash/Igniter generators, reproducible from
# the ontology via `bin/day_zero.sh` + `bin/qualify.sh`. Only the day-zero
# subject is source.
/test/fixtures/book_library/_build/
/test/fixtures/book_library/deps/
/test/fixtures/book_library/.ggen_igniter/
/test/fixtures/book_library/lib/mix/tasks/
/test/fixtures/book_library/lib/book_library/
/test/fixtures/book_library/priv/
tmp/
